{
  "preset": "library",
  "rules": {
    // F032 (no-catalog-import) is a consumer-adoption rule: it wants a
    // project that USES go-cqrs-lite to wire catalog-driven documentation.
    // identity-model is the pure domain-types module — no HTTP surface, no
    // doc serving; the published event language lives in usermgmt's
    // DefaultEventCatalog. Importing go-cqrs-lite/catalog here would be a
    // dead dependency. Triage 2026-11-05 (cqrs-lint v4.20.0).
    //
    // E005 (command-without-handler), 2026-11-15: identity-model DECLARES the
    // 21 command types as the published catalog; handlers register in
    // CONSUMERS (usermgmt deciders, systemadapter.DomainConfig,
    // system.RegisterCommand). A per-module walk structurally cannot see
    // cross-module registrations — every declaration would warn forever.
    //
    // C013 (time-time-in-event-payload), 2026-11-15: SessionStarted/Ended
    // carry StartedAt/ExpiresAt as time.Time — UTC instants by construction
    // (issued/verified server-side); the CBOR epoch zone drop is benign. The
    // event.Instant migration is a v5-class payload API change across every
    // consumer; revisit at the v4-to-v5 cutover.
    "disable": ["F032", "E005", "C013"]
  }
}
