package dashboardui

import (
	"time"

	"github.com/larsartmann/go-cqrs-lite/id/v4"
	"github.com/larsartmann/go-cqrs-lite/listing/v4"
	"github.com/larsartmann/go-cqrs-lite/snapshot/v4"
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/htmx"
	"github.com/larsartmann/templ-components/icons"
)

// ===== Snapshots =====

templ snapshotsIndexPage(p pageData, listings []listing.StreamListing, page paginationState) {
	@streamListingPage(p, listings, page, streamListPageConfig{
		subtitle:   "Inspect snapshot state for any aggregate. Snapshots store a point-in-time cache of aggregate state to accelerate loading.",
		emptyTitle: p.empty[EmptyStateSnapshotAggregates].Title,
		emptyMsg:   p.empty[EmptyStateSnapshotAggregates].Message,
		pagePath:   "/snapshots",
		linkPath:   "/snapshots",
		linkText:   "View",
	})
}

templ snapshotMissingPage(p pageData, streamType, streamID string) {
	@layout(p, emptyStatePanel(
		icons.ArchiveBox,
		"No snapshot found",
		"No snapshot exists for "+streamType+"/"+truncate(streamID, snapshotIDWidth)+".",
	))
}

templ snapshotEmptyPage(p pageData) {
	@layout(p, emptyStatePanel(icons.ArchiveBox, p.empty[EmptyStateSnapshots].Title, p.empty[EmptyStateSnapshots].Message))
}

templ snapshotDetailPage(p pageData, ref id.StreamRef, snap *snapshot.Snapshot, stateText string) {
	@layout(p, snapshotDetailContent(p, ref, snap, stateText))
}

templ snapshotDetailContent(p pageData, ref id.StreamRef, snap *snapshot.Snapshot, stateText string) {
	<div class="page-header">
		<h2>Snapshot: <code>{ ref.ID.String() }</code> @copyButton(ref.ID.String(), "", p.Nonce)</h2>
		<div class="page-subtitle">
			Version { snap.Version.String() } · Created { snap.CreatedAt.Format(time.RFC3339) + " · " } @snapshotRelativeTime(p.Nonce, snap.CreatedAt)
		</div>
	</div>
	if !p.ReadOnly {
		<form
			method="POST"
			action={ p.BasePath + "/snapshots/" + string(ref.Type) + "/" + ref.ID.String() + "/delete" }
			class="section-gap-lg"
			data-confirm="Delete this snapshot? This cannot be undone."
		>
			@htmx.CSRFToken(p.CSRFToken)
			@buttonSubmit("Delete Snapshot", "Delete snapshot for "+ref.ID.String(), display.ButtonOutlineDanger, nil)
		</form>
	}
	<h3>Metadata</h3>
	@definitionList(snapshotMetaItems(snap, p.Nonce))
	<h3>State</h3>
	<pre class="code-block"><code>{ stateText }</code></pre>
}
