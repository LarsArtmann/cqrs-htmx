package dashboardui

import (
	"strconv"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/htmx"
	"github.com/larsartmann/templ-components/utils"
)

// overviewPage renders the dashboard landing page: stat cards, projection
// health, and the recent-events table.
templ overviewPage(p pageData, stats overviewStats) {
	@layout(p, overviewContent(p, stats))
}

templ overviewContent(p pageData, stats overviewStats) {
	@overviewStatGrid(stats)
	if len(stats.Projections) > 0 {
		@projectionHealthPanel(p.BasePath, stats.Projections)
	}
	if len(stats.RecentEvents) > 0 {
		@recentEventsTable(p.BasePath, stats.RecentEvents)
	}
}

// overviewStatGrid builds the overview stat cards (events, aggregates,
// projections-active, system health, DLQ, SSE clients) into a library
// display.Grid. MinColWidth stays "190px" — that exact arbitrary-value
// utility is the one the bundle scan covers (via the library's grid.templ
// source); other widths would silently drop the template-columns rule.
// The check-css-bundle-classes gate fires if a library bump ever drops it.
templ overviewStatGrid(stats overviewStats) {
	@display.Grid(display.GridProps{
		BaseProps:   utils.BaseProps{Class: "mb-6"},
		Cols:        display.GridColsAutoFit,
		MinColWidth: "190px",
		Gap:         display.GridGapMD,
	}) {
		@statCard("stat-total-events", stats.TotalEvents, "Events", display.StatToneBlue)
		@statCard("stat-total-aggregates", stats.TotalAggregates, "Aggregates", display.StatToneBlue)
		if len(stats.Projections) > 0 {
			@statCard("stat-projections-active", projectionsActiveText(stats), "Projections", display.StatToneGreen)
		}
		if stats.HealthStatus != "" {
			@statCard("stat-system-health", stats.HealthStatus, "System Health", healthKindToTone(stats.HealthKind))
		}
		if stats.DLQCount != "" {
			@statCard("stat-dlq-count", stats.DLQCount, "Dead Letters", display.StatToneRed)
		}
		if stats.SSEHub != nil {
			@statCard("stat-sse-hub", sseHubValue(stats), "SSE Clients", sseHubTone(stats))
		}
	}
}

// projectionHealthPanel renders the projection health panel via the
// library PolledRegion (aria-live=polite). The explicit Trigger keeps the
// custom `refresh` event (fired after write actions) alongside the 10s
// poll — every/Eager are ignored when Trigger is set, matching the former
// hand-rolled hx-trigger="every 10s, refresh" exactly. Used by both the
// overview page and the projection-health partial endpoint (outerHTML
// swap — the partial response must re-render the REGION itself or polling
// stops after one refresh).
templ projectionHealthPanel(basePath string, projs []projectionStat) {
	@htmx.PolledRegion(htmx.PolledRegionProps{
		BaseProps: utils.BaseProps{ID: "projection-health", Class: "panel"},
		URL:       basePath + "/-/partials/projection-health",
		Trigger:   "every 10s, refresh",
	}) {
		<div class="panel-title">Projection Health</div>
		@rawDataTable(plainHeaders("Name", "Status", "Lag", "Processed", "Errors"), "", projectionHealthRows(projs))
	}
}

templ projectionHealthRows(projs []projectionStat) {
	for _, pr := range projs {
		<tr>
			<td>{ pr.Name }</td>
			<td>@statusBadge(pr.StatusKind, pr.Status)</td>
			<td class="mono">{ pr.Lag }</td>
			<td>{ strconv.FormatInt(pr.Processed, 10) }</td>
			<td>{ strconv.FormatInt(pr.Errors, 10) }</td>
		</tr>
	}
}

// recentEventsTable builds the recent-events table for the overview page.
templ recentEventsTable(basePath string, events []RecentEvent) {
	<h2>Recent Events</h2>
	@rawDataTable(plainHeaders("Time", "Type", "Stream", "Version"), "", recentEventRows(basePath, events))
}

templ recentEventRows(basePath string, events []RecentEvent) {
	for _, e := range events {
		<tr>
			<td class="mono" title={ e.Time }>{ recentEventTime(e) }</td>
			<td><a href={ basePath + "/events/" + e.EventID }><code>{ e.Type }</code></a></td>
			<td>@recentEventStreamCell(basePath, e)</td>
			<td>{ e.Version }</td>
		</tr>
	}
}

templ recentEventStreamCell(basePath string, e RecentEvent) {
	if e.StreamType != "" {
		<a href={ basePath + "/aggregates/" + e.StreamType + "/" + e.StreamID } class="mono">{ truncate(e.StreamID, eventIDWidth) }</a>
	} else {
		{ truncate(e.StreamID, eventIDWidth) }
	}
}
