package dashboardui

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/icons"
)

// ===== Projection Dashboard =====

templ projectionsPage(p pageData, projs []projectionStat) {
	@layout(p, projectionsContent(p, projs))
}

templ projectionsContent(p pageData, projs []projectionStat) {
	if len(projs) == 0 {
		@emptyStatePanel(icons.ArrowPath, "No projections registered", "")
	} else {
		<h2>Projections</h2>
		@rawDataTable(
			plainHeaders(
				"Name",
				"Status",
				"Lag",
				"Processed",
				"Errors",
				"Restarts",
				"Checkpoint",
				"Last Error",
				"Actions",
			),
			"",
			projectionRows(p, projs),
		)
	}
}

templ projectionRows(p pageData, projs []projectionStat) {
	for _, proj := range projs {
		<tr>
			<td class="cell-emph"><a href={ p.BasePath + "/projections/" + proj.Name }>{ proj.Name }</a></td>
			<td>@badge(proj.Status, statusKindToBadgeType(proj.StatusKind))</td>
			<td class="mono">{ proj.Lag }</td>
			<td>{ strconv.Itoa(proj.Processed) }</td>
			<td>{ strconv.Itoa(proj.Errors) }</td>
			<td>{ strconv.Itoa(proj.Restarts) }</td>
			<td class="mono" title={ proj.Checkpoint }>{ truncate(proj.Checkpoint, listIDWidth) }</td>
			if proj.LastError != "" {
				<td class="mono">{ truncate(proj.LastError, errorDisplayWidth) }</td>
			} else {
				<td class="mono">—</td>
			}
			<td>
				if proj.Errors > 0 || p.Caps.DeadLetterStore || p.Caps.ProjectionHost {
					@buttonLink(fmt.Sprintf("DLQ (%d)", proj.Errors), p.BasePath+"/dead-letters/"+proj.Name, "View dead letters for "+proj.Name, display.ButtonSecondary, false)
				}
				if !p.ReadOnly {
					@projectionResetForm(p, proj.Name)
				}
			</td>
		</tr>
	}
}

// projectionResetForm is the row-level reset form (data-confirm guarded,
// CSRF-protected).
templ projectionResetForm(p pageData, name string) {
	<form
		method="POST"
		action={ p.BasePath + "/projections/" + name + "/reset" }
		class="inline-form"
		data-confirm={ fmt.Sprintf("Reset projection %s? This will re-process all events from the beginning.", name) }
		aria-label={ fmt.Sprintf("Reset projection %s", name) }
	>
		<input type="hidden" name="_csrf" value={ p.CSRFToken }/>
		@buttonSubmit("Reset", "Reset projection "+name, display.ButtonOutlineDanger, nil)
	</form>
}

templ projectionDetailPage(p pageData, proj projectionStat) {
	@layout(p, projectionDetailContent(p, proj))
}

templ projectionDetailContent(p pageData, proj projectionStat) {
	<div class="page-header">
		<h2>{ proj.Name } @badge(proj.Status, statusKindToBadgeType(proj.StatusKind))</h2>
	</div>
	{{ slug := strings.ReplaceAll(strings.ToLower(proj.Name), " ", "-") }}
	<div class="stat-grid">
		@statCard("stat-processed-"+slug, strconv.FormatInt(proj.Processed, 10), "Processed", display.StatToneBlue)
		@statCard("stat-errors-"+slug, strconv.FormatInt(proj.Errors, 10), "Errors", display.StatToneRed)
		@statCard("stat-restarts-"+slug, strconv.Itoa(proj.Restarts), "Restarts", display.StatToneYellow)
		@statCard("stat-lag-"+slug, proj.Lag, "Lag", display.StatToneBlue)
	</div>
	<h3>Details</h3>
	@definitionList(projectionDetailItems(proj))
	<div class="filter-bar">
		@buttonLink(
			fmt.Sprintf("View Dead Letters (%d)", proj.Errors),
			p.BasePath+"/dead-letters/"+proj.Name,
			"",
			display.ButtonSecondary,
			false,
		)
		if !p.ReadOnly {
			<form
				method="POST"
				action={ p.BasePath + "/projections/" + proj.Name + "/reset" }
				class="inline-form"
				data-confirm={ fmt.Sprintf("Reset projection %s? This will re-process all events from the beginning.", proj.Name) }
			>
				<input type="hidden" name="_csrf" value={ p.CSRFToken }/>
				@buttonSubmit("Reset Projection", "", display.ButtonOutlineDanger, nil)
			</form>
		}
		@buttonLink("Back to Projections", p.BasePath+"/projections", "", display.ButtonSecondary, false)
	</div>
}
