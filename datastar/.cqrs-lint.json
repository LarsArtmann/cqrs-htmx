    // Triage 2026-11-05 (cqrs-lint v4.20.0).
    "disable": [
      "F002",
      "F006",
      "F009",
      "F010",
      "F011",
      "S002",
      "S003",
      "S007",
      "A008",
      "A009",
      "A018",
      "C015",
      "F032"
    ]
  }
}
