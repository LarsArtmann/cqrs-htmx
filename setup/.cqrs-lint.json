{
  "preset": "library",
  "rules": {
    // NEW 2026-11-17 (per-module triage; the module had no config before).
    // setup is the one-call COMPOSITION ROOT library — it wires consumer-
    // supplied pieces, owns no server and enforces no defaults.
    //
    // E023 (satellite-owned-SQL): the optional SQL store constructors ride
    // the same pre-metaengine class as usermgmt's (ADR-0051/v5 plan).
    //
    // F003/F004/F028 (otel/prometheus/slog-default): the Run paths serve the
    // CONSUMER's app; observability defaults are Config.Observability (the
    // upstream OTelBundle seam) — a library never forces slog.SetDefault.
    //
    // B014/B029/B030 (otel/retry/circuit-breaker middleware): the LIBRARY
    // PRINCIPLE — the dispatch chain is the consumer's
    // (Config.CommandMiddleware); booting middleware defaults would seize it.
    //
    // F023/F025 (manual filter/count with a SQL store): the flagged loops
    // walk in-memory CONFIG structures at boot (validation, path setup), not
    // SQL-store rows — rule misfire on the word "store".
    "disable": ["E023", "F003", "F004", "F028", "B014", "B029", "B030", "F023", "F025", "F032"]
  }
}
