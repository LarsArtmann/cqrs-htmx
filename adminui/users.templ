package adminui

import (
	"strconv"

	identitymodel "github.com/larsartmann/cqrs-htmx/identity-model/v4"
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/forms"
	"github.com/larsartmann/templ-components/navigation"
	"github.com/larsartmann/templ-components/utils"
	"github.com/larsartmann/templ-components/utils/wire"
)

templ usersPage(p pageData, d usersListData) {
	@Layout(p, usersContent(d))
}

templ usersContent(d usersListData) {
	@display.PageHeader(display.PageHeaderProps{Title: "Users"})
	<div class="mb-4 flex items-center gap-2">
		// FilterInput carries the search affordance without an icon (library
		// look accepted: the component reserves no start padding, so an
		// overlaid icon would collide with typed text). The form-level
		// hx-get/hx-trigger intercept Enter-submits so they swap like typing;
		// hx-push-url, hx-swap, hx-indicator, and autocomplete are inherited
		// from the form by htmx and the browser respectively. The spinner
		// shows while a search request is in flight.
		@forms.FilterInput(forms.FilterInputProps{
			Name:        "q",
			Value:       d.Search,
			Placeholder: "Search users\u2026",
			Action:      d.BasePath + "/users",
			DebounceMS:  350,
			Wire:        &wire.Action{URL: d.BasePath + "/users", Target: "#users-table"},
			BaseProps: utils.BaseProps{
				AriaLabel: "Search users",
				Class:     "w-full max-w-xs",
				Attrs: templ.Attributes{
					"autocomplete":  "off",
					"hx-get":        d.BasePath + "/users",
					"hx-trigger":    "submit",
					"hx-target":     "#users-table",
					"hx-swap":       "innerHTML",
					"hx-push-url":   "true",
					"hx-indicator":  "#users-search-spinner",
				},
			},
		})
		<span id="users-search-spinner" class="htmx-indicator text-gray-400">
			@feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM})
		</span>
	</div>
	<div id="users-table">
		@usersTableContent(d)
	</div>
}

templ usersTableContent(d usersListData) {
	if len(d.Users) == 0 {
		@display.Card(display.CardProps{Padding: display.CardPaddingNone}) {
			if d.Search != "" {
				@empty("users", "No users match your search", "No registered user matches the search term.", "Clear search", d.BasePath+"/users")
			} else {
				@empty("users", "No users found", "Registered users will appear here.", "", "")
			}
		}
	} else {
		@display.Table(display.TableProps{
			Headers:     []string{"User", "Status", "Created", ""},
			Hover:       true,
			Body:        usersRows(d),
			Striped:     true,
			CellPadding: display.TableCellPaddingCompact,
		})
		@listNote(len(d.Users), d.Total)
		@listPager(listPageURL(d.BasePath+"/users", d.Search), d.Page, d.TotalPages)
	}
}

templ usersRows(d usersListData) {
	for _, u := range d.Users {
		<tr>
			<td class="px-4 py-2">
				<a class="flex no-underline" href={ d.BasePath + "/users/" + u.ID.Get().String() }>
					<div class="flex items-center gap-2.5">
						@display.Avatar(display.AvatarProps{Initials: initials(u.Email), Size: display.AvatarSizeSM})
						<div>
							<div class="font-medium text-gray-900">{ u.Email }</div>
							if u.DisplayName != "" {
								<div class="text-xs text-gray-400">{ u.DisplayName }</div>
							}
						</div>
					</div>
				</a>
			</td>
			<td class="px-4 py-2">
				<div class="flex flex-wrap gap-1">
					if u.EmailVerified {
						@statusBadge("verified", "green")
					} else {
						@statusBadge("unverified", "")
					}
					if u.TOTPEnabled {
						@statusBadge("MFA", "blue")
					}
				</div>
			</td>
			<td class="px-4 py-2 text-gray-500">
				@display.RelativeTime(display.RelativeTimeProps{Time: u.CreatedAt})
			</td>
			<td class="px-4 py-2 text-right">
				<a class="rounded-md px-2.5 py-1 text-sm text-gray-600 no-underline hover:bg-gray-100" href={ d.BasePath + "/users/" + u.ID.Get().String() }>View</a>
			</td>
		</tr>
	}
}

templ userDetailPage(p pageData, d userDetailData) {
	@Layout(p, userDetailContent(d))
}

templ userDetailContent(d userDetailData) {
	@display.PageHeader(display.PageHeaderProps{
		Breadcrumb: navigation.Breadcrumbs(navigation.BreadcrumbsProps{Items: []navigation.BreadcrumbItem{
			{Text: "Users", Href: d.BasePath + "/users"},
			{Text: d.User.Email},
		}}),
		Title:    d.User.Email,
		Subtitle: d.User.DisplayName,
		Action:   userDetailAvatar(d),
	})
		@display.Grid(display.GridProps{
			BaseProps:   utils.BaseProps{Class: "mb-5"},
			Cols:        display.GridColsAutoFit,
			MinColWidth: "190px",
			Gap:         display.GridGapMD,
		}) {
			@display.StatCard(display.StatCardProps{Label: "Credentials", Value: strconv.Itoa(len(d.User.Credentials))})
			@display.StatCard(display.StatCardProps{Label: "External accounts", Value: strconv.Itoa(len(d.User.ExternalAccounts))})
			@display.StatCard(display.StatCardProps{Label: "Member since", Value: d.User.CreatedAt.Format("Jan 2, 2006")})
		}
		@display.Card(display.CardProps{
			Title:     "Details",
			BaseProps: utils.BaseProps{Class: "mb-4"},
		}) {
			@display.DefinitionList(display.DefinitionListProps{
				Items: []display.DefinitionItem{
					{Term: "User ID", DetailComponent: userIDDetail(d.User.ID.Get().String())},
					{Term: "Email", Detail: d.User.Email},
					{Term: "Verified", DetailComponent: verifiedBadge(d.User.EmailVerified)},
					{Term: "TOTP MFA", DetailComponent: totpBadge(d.User.TOTPEnabled)},
				},
			})
		}
		@externalAccountsCard(d)
		if len(d.TenantRoles) > 0 {
			@display.Card(display.CardProps{
				Title:     "Roles & memberships",
				Padding:   display.CardPaddingNone,
				BaseProps: utils.BaseProps{Class: "mb-4"},
			}) {
				@display.Table(display.TableProps{
					Headers:     []string{"Tenant", "Roles"},
					Hover:       true,
					Body:        tenantRolesRows(d.TenantRoles),
					Flush:       true,
					CellPadding: display.TableCellPaddingCompact,
				})
			}
		}
		@display.Card(display.CardProps{
			Header:    dangerZoneHeader(),
			BaseProps: utils.BaseProps{Attrs: templ.Attributes{"data-sync-target": ""}},
		}) {
			<div class="flex flex-wrap items-center justify-between gap-3.5">
				<div class="text-sm text-gray-500">Deleting a user tombstones the account and revokes all sessions. This cannot be undone.</div>
				@display.Button(display.ButtonProps{
					Text:    "Delete user",
					Variant: display.ButtonDanger,
					Size:    display.ButtonSizeSM,
					Icon:    icon("trash"),
					BaseProps: utils.BaseProps{Attrs: templ.Attributes{
					"hx-post":         d.BasePath + "/users/" + d.User.ID.Get().String() + "/delete",
					"data-confirm":   "Delete user " + d.User.Email + "? This cannot be undone.",
					"data-confirm-title": "Delete user",
					"hx-disabled-elt": "this",
				}},
				})
			</div>
		}
}

// userDetailAvatar keeps the identity anchor on the user detail page: the
// square initials avatar rides in the PageHeader action slot.
templ userDetailAvatar(d userDetailData) {
	@display.Avatar(display.AvatarProps{Initials: initials(d.User.Email), Size: display.AvatarSizeLG, Shape: display.AvatarShapeSquare, BaseProps: utils.BaseProps{Class: "h-[52px] w-[52px] rounded-[14px] text-lg"}})
}

templ tenantRolesRows(tenantRoles map[string][]identitymodel.Role) {
	for tenant, roles := range tenantRoles {
		<tr>
			<td class="px-4 py-2 font-mono text-xs">{ tenant }</td>
			<td class="px-4 py-2">
				<div class="flex flex-wrap gap-1">
					for _, r := range roles {
						@roleBadge(string(r))
					}
				</div>
			</td>
		</tr>
	}
}

// externalAccountsCard renders the OAuth2/OIDC link/unlink view for a user.
// Admins can unlink any linked provider; linking cannot be initiated here
// because the OAuth2 handshake requires the user to authenticate with the
// provider themselves (the admin cannot impersonate it). Configured providers
// are listed so the admin knows what the user CAN link via their own login.
templ externalAccountsCard(d userDetailData) {
	@display.Card(display.CardProps{
		Title:     "External accounts",
		Padding:   display.CardPaddingNone,
		BaseProps: utils.BaseProps{Class: "mb-4"},
	}) {
		if len(d.User.ExternalAccounts) == 0 {
			<div class="px-4 py-2 text-sm text-gray-500">No external accounts linked.</div>
		} else {
			@display.Table(display.TableProps{
				Headers:     []string{"Provider", "Email", "Linked", ""},
				Hover:       true,
				Body:        externalAccountRows(d),
				Flush:       true,
				CellPadding: display.TableCellPaddingCompact,
			})
		}
		<div class="flex flex-wrap items-center gap-2 px-4 py-2">
			<span class="text-xs text-gray-400">Linking is done via the user's own OAuth2 login flow.</span>
			<div class="flex flex-wrap gap-1">
				for _, provider := range d.ConfiguredProviders {
					@display.Badge(display.BadgeProps{Text: provider, Type: display.BadgeNeutral, Pill: true})
				}
			</div>
		</div>
	}
}

templ externalAccountRows(d userDetailData) {
	for _, ea := range d.User.ExternalAccounts {
		<tr>
			<td class="px-4 py-2">
				@display.Badge(display.BadgeProps{Text: ea.Provider, Type: display.BadgeNeutral, Pill: true})
			</td>
			<td class="px-4 py-2 text-sm">{ ea.Email }</td>
			<td class="px-4 py-2 text-sm text-gray-500">{ ea.LinkedAt.Format("Jan 2, 2006") }</td>
			<td class="px-4 py-2 text-right">
				@display.Button(display.ButtonProps{
					Text:    "Unlink",
					Variant: display.ButtonDanger,
					Size:    display.ButtonSizeSM,
					Icon:    icon("trash"),
					BaseProps: utils.BaseProps{Attrs: templ.Attributes{
						"hx-post":        d.UnlinkExternalBase + "/" + ea.Provider + "/unlink",
						"hx-confirm":     "Unlink " + ea.Provider + " from " + d.User.Email + "?",
						"hx-disabled-elt": "this",
					}},
				})
			</td>
		</tr>
	}
}
