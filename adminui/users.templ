package adminui

import (
	"encoding/base64"
	"fmt"
	"strconv"
	"strings"

	identitymodel "github.com/larsartmann/cqrs-htmx/identity-model/v4"
	"github.com/larsartmann/cqrs-htmx/usermgmt/v4"
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/forms"
	"github.com/larsartmann/templ-components/htmx"
	"github.com/larsartmann/templ-components/navigation"
	"github.com/larsartmann/templ-components/utils"
	"github.com/larsartmann/templ-components/utils/wire"
)

templ usersPage(p pageData, d usersListData, sort string) {
	@Layout(p, usersContent(p, d, sort))
}

// userImportPage is the bulk-import form (super-admin). The result panel
// swaps in-place via htmx: a file POST renders the imported/skipped summary
// plus a bounded per-row error list, without losing the form for a retry.
templ userImportPage(p pageData, basePath string) {
	@Layout(p, userImportContent(p, basePath))
}

templ userImportContent(p pageData, basePath string) {
	@display.PageHeader(display.PageHeaderProps{
		Breadcrumb: navigation.Breadcrumbs(navigation.BreadcrumbsProps{Items: []navigation.BreadcrumbItem{
			{Text: p.label(labelPageUsers), Href: basePath + "/users"},
			{Text: p.label(labelActionImport)},
		}}),
		Title: p.label(labelPageImportUsers),
	})
	<div class="max-w-[520px]">
		@display.Card(display.CardProps{}) {
			<form hx-post={ basePath + "/users/import" } hx-target="#import-result" hx-swap="innerHTML" enctype="multipart/form-data">
				<div class="mb-4">
					@forms.FileInput(forms.FileInputProps{
						ID:       "import-file",
						Name:     "file",
						Label:    "File",
						Required: true,
						Accept:   ".csv,.json,text/csv,application/json",
						HelpText: "A .csv or .json file of users (email + optional display_name).",
					})
				</div>
				<div class="mb-4 rounded-md bg-gray-50 px-3.5 py-2.5 text-xs text-gray-500">
					Each row creates a passwordless account: imported users enroll their
					own passkey or sign in via a matching OAuth2 provider — the import
					cannot set credentials. Emails that already exist are skipped, so a
					re-run is safe. The result panel below reports exactly what landed.
				</div>
				<div class="flex gap-2.5">
					@display.Button(display.ButtonProps{Text: "Import", Type: display.ButtonHTMLSubmit, Variant: display.ButtonPrimary, Children: htmx.LoadingButton("Import", "Importing…", feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM, Color: "text-white"}))})
					@display.Button(display.ButtonProps{Text: p.label(labelConfirmCancel), Href: basePath + "/users", Variant: display.ButtonSecondary, BaseProps: utils.BaseProps{Class: classNoUnderline}})
				</div>
			</form>
			<div id="import-result" class="mt-4"></div>
		}
	</div>
}

// importResultPanel is the honest outcome summary: exact counts, and per-row
// errors bounded to a readable window (the counts stay exact either way).
templ importResultPanel(result usermgmt.ImportResult, back string) {
	if len(result.Errors) == 0 {
		@feedback.Alert(feedback.AlertProps{
			Type:    feedback.FeedbackSuccess,
			Title:   "Import complete",
			Message: fmt.Sprintf("%d imported, %d skipped.", result.Imported, result.Skipped),
		})
	} else {
		@feedback.Alert(feedback.AlertProps{
			Type:    feedback.FeedbackWarning,
			Title:   "Import finished with errors",
			Message: fmt.Sprintf("%d imported, %d skipped, %d rows with errors.", result.Imported, result.Skipped, len(result.Errors)),
		})
		<ul class="mt-2 list-inside list-disc text-xs text-gray-600 dark:text-gray-300">
			for _, e := range visibleImportErrors(result.Errors) {
				<li>{ e }</li>
			}
			if remainingImportErrors(result.Errors) > 0 {
				<li>… and { strconv.Itoa(remainingImportErrors(result.Errors)) } more</li>
			}
		</ul>
	}
	<div class="mt-3">
		@display.Button(display.ButtonProps{Text: "Back to users", Href: back, Variant: display.ButtonSecondary, Size: display.ButtonSizeSM, BaseProps: utils.BaseProps{Class: classNoUnderline}})
	</div>
}

templ usersContent(p pageData, d usersListData, sort string) {
	@display.PageHeader(display.PageHeaderProps{Title: p.label(labelPageUsers), Action: newUserAction(p, d)})
	<div class="mb-4 flex flex-wrap items-center gap-2">
		@display.Button(display.ButtonProps{
			Text:      p.label(labelActionImportUsers),
			Href:      d.BasePath + "/users/import",
			Variant:   display.ButtonSecondary,
			Size:      display.ButtonSizeSM,
			BaseProps: utils.BaseProps{Class: classNoUnderline},
		})
		@display.Button(display.ButtonProps{
			Text:      p.label(labelActionExportCSV),
			Href:      d.BasePath + "/users/export.csv",
			Variant:   display.ButtonSecondary,
			Size:      display.ButtonSizeSM,
			BaseProps: utils.BaseProps{Class: classNoUnderline},
		})
		// The filtered exports render only while the view is actually
			// narrowed (search, chip, or sort): with nothing active they would
			// duplicate the full export above, so the toolbar stays honest about
			// which button does what. The hrefs carry the CURRENT filter set via
			// userListURL, so the file matches what the list shows.
		if d.Search != "" || d.Filter != userFilterNone || sort != "" {
			@display.Button(display.ButtonProps{
				Text:      p.label(labelActionExportFCsv),
				Href:      userListURL(d.BasePath+"/users/export.filtered.csv", d, d.Filter, sort),
				Variant:   display.ButtonSecondary,
				Size:      display.ButtonSizeSM,
				BaseProps: utils.BaseProps{Class: classNoUnderline},
			})
			@display.Button(display.ButtonProps{
				Text:      p.label(labelActionExportFJson),
				Href:      userListURL(d.BasePath+"/users/export.filtered.json", d, d.Filter, sort),
				Variant:   display.ButtonSecondary,
				Size:      display.ButtonSizeSM,
				BaseProps: utils.BaseProps{Class: classNoUnderline},
			})
		}
		// The search rides the RFC 10008 fallback ladder
		// (docs/guides/http-query-method.md): Enter submits the form as a
		// native QUERY request (the cqrs-query extension upgrades the POST
		// trigger and downgrades to X-HTTP-Method-Override only when an
		// intermediary refuses the verb), live typing fires POST to the
		// fallback twin, and the GET route stays the bookmarkable rung the
		// chips and history navigate (the no-JS form action). FilterInput's
		// wire vocabulary has no QUERY concept, so the ladder lives on the
		// FORM attrs (Enter) while the input's debounced wire uses the twin.
		// Both wire ends self-pin hx-target/hx-swap — inside the boosted
		// app-shell wrapper an unpinned ajax element would blank the page
		// (the htmx-attribute-inheritance trap).
		@forms.FilterInput(forms.FilterInputProps{
			Name:        "q",
			Value:       d.Search,
			Placeholder: p.label(labelSearchUsersPH),
			Action:      d.BasePath + "/users",
			DebounceMS:  350,
			Wire: &wire.Action{
				URL:    d.BasePath + "/users/search",
				Method: wire.MethodPost,
				Target: "#users-table",
			},
			BaseProps: utils.BaseProps{
				AriaLabel: p.label(labelSearchUsersAria),
				Class:     "w-full max-w-xs",
				Attrs: templ.Attributes{
					"autocomplete": "off",
					"hx-ext":       "cqrs-query",
					"hx-post":      d.BasePath + "/users/search",
					"hx-query":     "",
					"hx-trigger":   "submit",
					"hx-target":    "#users-table",
					"hx-swap":      "innerHTML",
					"hx-indicator": "#users-skeleton",
				},
			},
		})
	</div>
	@userFilterChips(d, sort)
	// T20 F146–F149: saved views + display prefs (FILTER-BAR region — the
	// table rows/thead belong to the concurrent bulk/visual agent). The bar
	// is a client-only toolbar shell: admin.js owns the namespaced
	// localStorage store, renders the saved-view list, applies presets as
	// URL navigation, and persists the column-visibility + density choices.
	@usersPrefsBar(p, d)
	// T17 F124/F125: the skeleton is the search wire's hx-indicator — hidden
	// in every server response (.htmx-indicator CSS), shown only while the
	// FIRST in-flight swap loads rows, then removed by admin.js so an
	// already-loaded window never flashes it again.
	@usersSkeleton()
	// T19 F137/F138: ONE bulk form wraps the table region, so the row
	// checkboxes and the select-all ride the same POST. The bulk bar (hidden
	// until admin.js sees a checked row) and the outcome target live INSIDE
	// the form but OUTSIDE #users-table, so a search/filter/pager swap that
	// replaces the table's rows never erases the outcome panel — the panel
	// stays until the next action replaces it.
	<form id="users-bulk-form" data-bulk-confirm hx-post={ d.BasePath + "/users/bulk" } hx-target="#bulk-outcome" hx-swap="innerHTML">
		<div id="users-table">
			@usersTableContent(p, d, sort)
		</div>
		@usersBulkBar(d)
		<div id="bulk-outcome" class="mt-4"></div>
	</form>
}

// userFilterChips renders the status chips (verified / unverified / MFA /
// external) plus the ordering toggle — the tenants lifecycle-chips + Name/
// Members pattern with a third axis. Each chip and sort link is a link that
// carries the FULL state (q, filter, sort) via userListURL / userChipWithSort,
// so any toggle keeps the rest. Full navigations keep history honest.
templ userFilterChips(d usersListData, sort string) {
	<div class="mb-4 flex flex-wrap items-center gap-1.5">
		for _, chip := range userFilterChipsList(d) {
			@userChipLink(userChipWithSort(chip, sort))
		}
		<span class="text-gray-300" aria-hidden="true">|</span>
		<span class="text-gray-600 dark:text-gray-400">Sort</span>
		@userSortLink(d, sort, "", "Default")
		<span class="text-gray-300" aria-hidden="true">/</span>
		@userSortLink(d, sort, "email", "Email")
		<span class="text-gray-300" aria-hidden="true">/</span>
		@userSortLink(d, sort, "display", "Display name")
		<span class="text-gray-300" aria-hidden="true">/</span>
		@userSortLink(d, sort, "created", "Created")
		<span class="text-gray-300" aria-hidden="true">/</span>
		@userSortLink(d, sort, "recent", "Recently active")
	</div>
}

// userChipLink is one status chip; the active one toggles itself OFF (its
// href points at the unfiltered list, keeping q + sort).
templ userChipLink(chip userFilterChip) {
	if chip.Active {
		<a
			class="rounded-full bg-gray-900 px-2.5 py-1 text-xs font-medium text-white no-underline dark:bg-white dark:text-gray-900"
			href={ chip.Href }
			aria-current="true"
		>{ chip.Label }</a>
	} else {
		<a
			class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600 no-underline hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700"
			href={ chip.Href }
		>{ chip.Label }</a>
	}
}

// userSortLink is one half of the ordering toggle; current carries the
// active styling (the tenantSortLink pattern — the active sort renders as a
// span, the others as links, all preserving q + filter).
templ userSortLink(d usersListData, current, sort, label string) {
	if current == sort {
		<span class="font-medium text-gray-900">{ label }</span>
	} else {
		<a
			class="text-gray-600 no-underline hover:text-gray-900 dark:text-gray-400"
			href={ userListURL(d.BasePath+"/users", d, d.Filter, sort) }
		>{ label }</a>
	}
}

// newUserAction is the PageHeader action slot for the users list: the
// primary "New user" entry point rides on the title row.
templ newUserAction(p pageData, d usersListData) {
	@display.Button(display.ButtonProps{
		Text:      p.label(labelActionNewUser),
		Href:      d.BasePath + "/users/new",
		Variant:   display.ButtonPrimary,
		Size:      display.ButtonSizeSM,
		Icon:      icon("plus"),
		BaseProps: utils.BaseProps{Class: classNoUnderline},
	})
}

// userSortableHeader is one client-sortable column header (T17 F126): a
// plain button that admin.js uses to re-order the LOADED window in place —
// no server round-trip. aria-sort carries the live state (the URL-carried
// server sort from T03 seeds it on render and stays the bookmarkable
// default); the indicator span is textContent-updated by admin.js.
templ userSortableHeader(key, label, aria string) {
	<th scope="col" class="px-4 py-2 text-start font-semibold text-gray-900 dark:text-white" aria-sort={ aria }>
		<button
			type="button"
			data-sort-key={ key }
			class="inline-flex items-center gap-1 py-1 hover:text-blue-600 dark:hover:text-blue-400"
			aria-label={ "Sort by " + label }
		>
			{ label }
			<span data-sort-indicator aria-hidden="true"></span>
		</button>
	</th>
}

// userHeaderAria seeds the aria-sort state from the URL-carried server sort
// (ascending only — the T03 vocabulary has no descending key).
func userHeaderAria(sort, key string) string {
	if sort == key {
		return "ascending"
	}
	return "none"
}

// usersTableContent is the users list's swap region. The optional sort is
// the GET route's ordering ("" = the directory's stable order); the
// body-carrying search twin omits it (its wire format is q/filter/page), so
// the pager it renders keeps q + filter but not sort — the sort key joins
// that body vocabulary when the search ladder grows the field.
templ usersTableContent(p pageData, d usersListData, sort ...string) {
	if len(d.Users) == 0 {
		@display.Card(display.CardProps{Padding: display.CardPaddingNone}) {
			if d.Search != "" {
				@empty("users", p.label(labelEmptyUsersSearchTitle), p.label(labelEmptyUsersSearchHint), p.label(labelEmptyUsersSearchAction), d.BasePath+"/users")
			} else {
				@empty("users", p.label(labelEmptyUsersNoneTitle), p.label(labelEmptyUsersNoneHint), p.label(labelEmptyUsersNoneAction), d.BasePath+"/users/new")
			}
		}
	} else {
		// T17 F126: hand-rolled table (the library's display.Table header
		// vocabulary cannot carry the data-sort-key buttons), mirroring the
		// library's wrapper/table/tbody classes so the visual contract is
		// unchanged. Only the User and Created columns are client-sortable.
		<div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700" role="region" tabindex="0">
			<table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
				// T25 F182: sticky head inside the scroll region; the hairline
				// shadow (tailwind.css) keeps the header row read as floating
				// over the body while scrolled.
				<thead class="admin-sticky-head bg-gray-50 dark:bg-gray-800">
					<tr>
						// T19 F137: the select-all checkbox. Indeterminate state is
						// client-owned (admin.js) — the server only seeds unchecked.
						<th scope="col" class="w-10 px-3 py-2">
							<input type="checkbox" data-bulk-select-all class="h-4 w-4" aria-label="Select all users on this page"/>
						</th>
						@userSortableHeader("email", p.label(labelHeaderUser), userHeaderAria(pagerSortOf(sort), "email"))
						<th scope="col" class="px-4 py-2 text-start font-semibold text-gray-900 dark:text-white">{ p.label(labelHeaderAccess) }</th>
						<th scope="col" class="px-4 py-2 text-start font-semibold text-gray-900 dark:text-white">{ p.label(labelHeaderStatus) }</th>
						<th scope="col" class="px-4 py-2 text-start font-semibold text-gray-900 dark:text-white">{ p.label(labelHeaderLastSeen) }</th>
						@userSortableHeader("created", p.label(labelHeaderCreated), userHeaderAria(pagerSortOf(sort), "created"))
						<th scope="col" class="px-4 py-2 text-end font-semibold text-gray-900 dark:text-white"><span class="sr-only">Actions</span></th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
					@usersRows(p, d)
				</tbody>
			</table>
		</div>
		@listNote(len(d.Users), d.Total)
		@listPager(userListURL(d.BasePath+"/users", d, d.Filter, pagerSortOf(sort)), d.Page, d.TotalPages)
	}
}


// usersRows renders the users list body rows. data-sort-* carries the
// client-sort vocabulary (T17 F126): admin.js reads these per row — no
// cell-level attrs needed — and the values mirror compareUsers' lowercase
// compares so the in-window order agrees with the URL-carried server sort.
templ usersRows(p pageData, d usersListData) {
	for i, row := range d.Users {
		<tr class={ templ.KV("bg-gray-50 dark:bg-gray-800/50", i%2 == 1), "hover:bg-gray-100 dark:hover:bg-gray-800" } data-sort-email={ strings.ToLower(row.User.Email) } data-sort-display={ strings.ToLower(row.User.DisplayName) } data-sort-created={ strconv.FormatInt(row.User.CreatedAt.Unix(), 10) }>
			// T19 F137: the row checkbox — value is the user id, name "ids" so
			// the bulk POST receives one form value per checked row.
			<td class="w-10 px-3 py-2">
				<input type="checkbox" name="ids" value={ row.User.ID.Get().String() } data-bulk-row class="h-4 w-4" aria-label={ "Select " + row.User.Email }/>
			</td>
			<td class="px-4 py-2">
				<a class="flex no-underline" href={ d.BasePath + "/users/" + row.User.ID.Get().String() }>
					<div class="flex items-center gap-2.5">
						// T25 F183: deterministic avatar color — the id hashes into
						// a FIXED palette class, stable across renders.
						@display.Avatar(display.AvatarProps{Initials: initials(row.User.Email), Size: display.AvatarSizeSM, BaseProps: utils.BaseProps{Class: avatarColorClass(row.User.ID.Get().String())}})
						<div>
							<div class="font-medium text-gray-900">{ row.User.Email }</div>
							if row.User.DisplayName != "" {
								<div class={ "text-xs " + metadataTextXSClass }>{ row.User.DisplayName }</div>
							}
						</div>
					</div>
				</a>
			</td>
			<td class="px-4 py-2">
				@userAccessCell(row, d.BasePath)
			</td>
			<td class="px-4 py-2">
				<div class="flex flex-wrap gap-1">
					if row.User.EmailVerified {
						@statusBadge("verified", display.BadgeSuccess)
					} else {
						@statusBadge("unverified", display.BadgeNeutral)
					}
					if row.User.TOTPEnabled {
						@statusBadge("MFA", display.BadgeInfo)
					}
					for _, ea := range row.User.ExternalAccounts {
						@display.Badge(display.BadgeProps{Text: ea.Provider, Type: display.BadgeNeutral, Pill: true})
					}
				</div>
			</td>
			<td class="px-4 py-2 text-gray-500">
				// Last seen is the audit window's latest entry about this user's
				// stream: a convenience view, honestly dashed when the window
				// records nothing (fresh user or evicted history).
				if !row.LastSeen.IsZero() {
					<span title={ p.dateTime(row.LastSeen) }>
						@display.RelativeTime(display.RelativeTimeProps{Time: row.LastSeen})
					</span>
				} else {
					<span class="text-gray-600 dark:text-gray-400" title="No recorded activity in the audit window" aria-hidden="true">—</span>
				}
			</td>
			<td class="px-4 py-2 text-gray-500">
				@display.RelativeTime(display.RelativeTimeProps{Time: row.User.CreatedAt})
			</td>
			<td class="px-4 py-2 text-right">
				<a class="rounded-md px-2.5 py-1 text-sm text-gray-600 no-underline hover:bg-gray-100" href={ d.BasePath + "/users/" + row.User.ID.Get().String() }>View</a>
			</td>
		</tr>
	}
}

// userAccessCell answers the question the directory exists to answer: who can
// reach what. Platform roles render as badges (wildcard domain), tenant
// memberships as a count; a user with neither reads as a quiet dash rather
// than an empty cell that could mean "not loaded".
templ userAccessCell(row userRow, basePath string) {
	<div class="flex flex-wrap items-center gap-1">
		for _, role := range row.PlatformRoles {
			@roleBadge(string(role))
		}
		if row.TenantCount > 0 {
			<a class="text-xs text-gray-500 no-underline hover:underline" href={ basePath + "/users/" + row.User.ID.Get().String() }>
				{ row.tenantCountLabel() }
			</a>
		}
		if !row.isPlatformAdmin() && row.TenantCount == 0 {
			<span class="text-sm text-gray-600 dark:text-gray-400" aria-hidden="true">—</span>
		}
	</div>
}

// usersBulkBar is the selection toolbar (T19 F137). Hidden until admin.js
// counts a checked row; the export link's href is recomputed client-side
// from the checked ids (data-export-base is the server-owned constant, the
// ids param is client state — the server never guesses a selection).
templ usersBulkBar(d usersListData) {
	<div id="users-bulk-bar" hidden class="my-4 flex flex-wrap items-center gap-2.5 rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-2.5 dark:border-gray-700 dark:bg-gray-800">
		<span id="bulk-count" class="text-sm font-medium text-gray-700 dark:text-gray-200"></span>
		@display.Button(display.ButtonProps{
			Text:    "Resend verification",
			Type:    display.ButtonHTMLSubmit,
			Variant: display.ButtonSecondary,
			Size:    display.ButtonSizeSM,
			BaseProps: utils.BaseProps{Attrs: templ.Attributes{
				"name":  "action",
				"value": "resend",
			}},
		})
		<span class="flex items-center gap-1.5">
			<label class="text-sm text-gray-600 dark:text-gray-300" for="bulk-role">Role</label>
			<select id="bulk-role" name="roles" class="rounded-md border border-gray-300 bg-white px-2 py-1 text-sm dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100">
				for _, role := range identitymodel.AdminRoles() {
					<option value={ string(role) }>{ string(role) }</option>
				}
			</select>
			@display.Button(display.ButtonProps{
				Text:    "Grant role",
				Type:    display.ButtonHTMLSubmit,
				Variant: display.ButtonSecondary,
				Size:    display.ButtonSizeSM,
				BaseProps: utils.BaseProps{Attrs: templ.Attributes{
					"name":  "action",
					"value": "grant",
				}},
			})
		</span>
		<a
			id="bulk-export-csv"
			class="text-sm text-gray-600 no-underline hover:underline dark:text-gray-300"
			href={ d.BasePath + "/users/export.ids.csv" }
			data-export-base={ d.BasePath + "/users/export.ids.csv" }
		>Export selection (CSV)</a>
	</div>
}

// bulkRefusalPanel is the honest no-op answer: the admin clicked an action
// that cannot run (no selection, unknown action, no role) — nothing was
// dispatched, and the panel says exactly that.
templ bulkRefusalPanel(message string) {
	@feedback.Alert(feedback.AlertProps{
		Type:    feedback.FeedbackWarning,
		Title:   "Nothing was sent",
		Message: message,
	})
}

// bulkOutcomePanel is the per-row outcome report (T19 F140), the
// import-result panel pattern: exact counts up top, then one line per row —
// ok (with what happened) or refused (with the reason) — bounded to a
// readable window the counts stay exact through.
templ bulkOutcomePanel(action string, outcomes []bulkOutcome) {
	{{ ok, failed := countBulkOutcomes(outcomes) }}
	if failed == 0 {
		@feedback.Alert(feedback.AlertProps{
			Type:    feedback.FeedbackSuccess,
			Title:   "Bulk action complete",
			Message: fmt.Sprintf("%d of %d succeeded.", ok, len(outcomes)),
		})
	} else {
		@feedback.Alert(feedback.AlertProps{
			Type:    feedback.FeedbackWarning,
			Title:   "Bulk action finished with refusals",
			Message: fmt.Sprintf("%d succeeded, %d refused — each refused row names its reason below.", ok, failed),
		})
	}
	<ul class="mt-2 list-inside list-disc text-xs text-gray-600 dark:text-gray-300">
		for _, o := range visibleBulkOutcomes(outcomes) {
			<li>
				<span class="font-medium">{ bulkOutcomeLabel(o) }</span>
				if o.OK {
					<span class="text-green-700 dark:text-green-400">{ bulkOutcomeOKText(action) }.</span>
				} else {
					<span class="text-red-700 dark:text-red-400">{ o.Reason }.</span>
				}
			</li>
		}
		if remainingBulkOutcomes(outcomes) > 0 {
			<li>… and { strconv.Itoa(remainingBulkOutcomes(outcomes)) } more</li>
		}
	</ul>
}

// bulkOutcomeLabel names the row by email when known, falling back to a
// truncated id — a refusal for a deleted user still names WHICH row.
func bulkOutcomeLabel(o bulkOutcome) string {
	if o.Email != "" {
		return o.Email
	}
	if len(o.ID) > 12 {
		return o.ID[:12] + "…"
	}
	return o.ID
}

// userNewPage is the create-user form. Register is the Service's public
// creation path: it validates email + display name, enforces the MaxUsers
// gate, and (honestly documented below) cannot set credentials — passwordless
// users enroll their own passkey or link an OAuth2 provider on first login.
templ userNewPage(p pageData, basePath string) {
	@Layout(p, userNewContent(p, basePath))
}

templ userNewContent(p pageData, basePath string) {
	@display.PageHeader(display.PageHeaderProps{
		Breadcrumb: navigation.Breadcrumbs(navigation.BreadcrumbsProps{Items: []navigation.BreadcrumbItem{
			{Text: p.label(labelPageUsers), Href: basePath + "/users"},
			{Text: p.label(labelActionNew)},
		}}),
		Title: p.label(labelActionNewUser),
	})
	<div class="max-w-[520px]">
		@display.Card(display.CardProps{}) {
			<form hx-post={ basePath + "/users" } hx-target="this">
				<div class="mb-4">
					@forms.Input(forms.InputProps{
					BaseProps:  utils.BaseProps{ID: "email"},
					Name:       "email",
					Type:       forms.InputEmail,
					Placeholder: "ada@example.com",
					Required:   true,
					Label:      "Email",
					HelpText:   "The address the user will sign in and be found by.",
				})
				</div>
				<div class="mb-4">
					@forms.Input(forms.InputProps{
					BaseProps:  utils.BaseProps{ID: "display_name"},
					Name:       "display_name",
					Placeholder: "Ada Lovelace",
					Label:      "Display name",
					HelpText:   "Optional. Shown instead of the email where space allows.",
					})
				</div>
				<div class="mb-4 rounded-md bg-gray-50 px-3.5 py-2.5 text-xs text-gray-500">
					The panel cannot set credentials: passwordless users enroll their own
				passkey or sign in via a configured OAuth2 provider that matches this email.
				</div>
				<div class="flex gap-2.5">
					@display.Button(display.ButtonProps{Text: p.label(labelActionCreateUser), Type: display.ButtonHTMLSubmit, Variant: display.ButtonPrimary})
					@display.Button(display.ButtonProps{Text: p.label(labelConfirmCancel), Href: basePath + "/users", Variant: display.ButtonSecondary, BaseProps: utils.BaseProps{Class: classNoUnderline}})
				</div>
			</form>
		}
	</div>
}

templ userDetailPage(p pageData, d userDetailData) {
	@Layout(p, userDetailContent(p, d))
}

templ userDetailContent(p pageData, d userDetailData) {
	@display.PageHeader(display.PageHeaderProps{
		Breadcrumb: navigation.Breadcrumbs(navigation.BreadcrumbsProps{Items: []navigation.BreadcrumbItem{
			{Text: "Users", Href: d.BasePath + "/users"},
			{Text: d.User.Email},
		}}),
		Title:    d.User.Email,
		Subtitle: d.User.DisplayName,
		Action:   userDetailAvatar(d),
	})
	// The lockout badge is the page's first-class rescue signal: a user with
	// no passkey, no linked provider, and no TOTP cannot sign in at all, and
	// the page says so before anything else competes for attention.
	if cannotSignIn(d.User) {
		<div class="mb-5 flex flex-wrap items-center gap-3 rounded-md bg-amber-50 px-3.5 py-2.5 text-xs text-amber-700 dark:bg-amber-900/20 dark:text-amber-300">
			@display.Badge(display.BadgeProps{Text: "Cannot sign in", Type: display.BadgeError, Dot: true})
			<span>{ cannotSignInCopy() }</span>
		</div>
	}
	@display.Grid(display.GridProps{
		BaseProps:   utils.BaseProps{Class: "mb-5"},
		Cols:        display.GridColsAutoFit,
		MinColWidth: "190px",
		Gap:         display.GridGapMD,
	}) {
		// Sign-in stat tiles ride the same capability probes as the cards
		// below: a "Credentials: 0" tile in a deployment without WebAuthn is
		// a dead stat pretending to be a fact about the user.
		if d.AuthMethods.HasWebAuthn {
			@display.StatCard(display.StatCardProps{Label: "Credentials", Value: strconv.Itoa(len(d.User.Credentials))})
		}
		if d.AuthMethods.HasOAuth2 {
			@display.StatCard(display.StatCardProps{Label: "External accounts", Value: strconv.Itoa(len(d.User.ExternalAccounts))})
		}
		@display.StatCard(display.StatCardProps{Label: "Tenants", Value: strconv.Itoa(len(d.TenantAccess))})
		@display.StatCard(display.StatCardProps{Label: "Member since", Value: d.User.CreatedAt.Format("Jan 2, 2006")})
	}
	@display.Card(display.CardProps{
		Title:     "Details",
		BaseProps: utils.BaseProps{Class: "mb-4"},
	}) {
		@display.DefinitionList(display.DefinitionListProps{
			Items: userDetailDefinitionItems(d),
		})
	}
	// T17 F128: the copy-row-as-JSON support action — the detail page's
	// account facts as one clipboard payload for tickets and API calls.
	@userSupportActions(d)
	@profileEditCard(d)
	// The self-service card renders only when the shown user is the signed-in
	// admin: their own display-name edit, their own grants read back, and the
	// consumer-mounted sign-out link (or the honest note when none exists).
	if d.IsSelf {
		@selfServiceCard(d)
	}
	// The sign-in cards render only when the deployment can serve the
	// channel at all (probes above): a Passkeys card in a WebAuthn-less
	// deployment would advertise an enrollment the user can never perform,
	// and an External-accounts card without OAuth2 would promise a link
	// that cannot exist. Dead cards never render — not even as empty states.
	if d.AuthMethods.HasWebAuthn {
		@passkeysCard(d)
		@credentialRestoreCard(d)
	}
	if d.AuthMethods.HasOAuth2 {
			@externalAccountsCard(p, d)
		}
	@platformAccessCard(d)
	@tenantAccessCard(d)
	@userTimelineCard(d)
	@display.Card(display.CardProps{
		Header: dangerZoneHeader(),
		BaseProps: utils.BaseProps{Attrs: templ.Attributes{"data-sync-target": ""}},
	}) {
		<div class="flex flex-wrap items-center justify-between gap-3.5">
			<div class="text-sm text-gray-500">Deleting a user tombstones the account and revokes all sessions. This cannot be undone.</div>
			@display.Button(display.ButtonProps{
				Text:    "Delete user",
				Variant: display.ButtonDanger,
				Size:    display.ButtonSizeSM,
				Icon:    icon("trash"),
				BaseProps: utils.BaseProps{Attrs: templ.Attributes{
					"hx-post":            d.BasePath + "/users/" + d.User.ID.Get().String() + "/delete",
					"data-confirm":       "Delete user " + d.User.Email + "? This cannot be undone.",
					"data-confirm-title": "Delete user",
					"hx-disabled-elt":    "this",
				}},
			})
		</div>
	}
}

// userDetailAvatar keeps the identity anchor on the user detail page: the
// square initials avatar rides in the PageHeader action slot.
// verifiedDetail pairs the verified badge with the admin-side "Resend
// verification" action. The action error path explains honestly when the
// Service has no email verification configured.
templ verifiedDetail(d userDetailData) {
	<span class="flex flex-wrap items-center gap-2">
		@verifiedBadge(d.User.EmailVerified)
		if !d.User.EmailVerified {
			@display.Button(display.ButtonProps{
				Text:    "Resend verification",
				Variant: display.ButtonSecondary,
				Size:    display.ButtonSizeSM,
				BaseProps: utils.BaseProps{Attrs: templ.Attributes{
					"hx-post":         d.BasePath + "/users/" + d.User.ID.Get().String() + "/resend-verification",
					"hx-disabled-elt": "this",
				}},
			})
		}
	</span>
}

// userSupportActions is the detail page's support strip (T17 F128): the
// copy-row-as-JSON action. The payload is composed server-side (one honest
// snapshot of the resolved facts) and carried in a data attribute — the
// click handler is the document-delegated admin.js bridge to the async
// Clipboard API, with an explicit denial message (never a silent no-op).
templ userSupportActions(d userDetailData) {
	<div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-md bg-gray-50 px-3.5 py-2.5 dark:bg-gray-800/50">
		<span class="text-xs text-gray-500 dark:text-gray-400">Support: copy the account facts as JSON for tickets and API calls.</span>
		@display.Button(display.ButtonProps{
			Text:      "Copy as JSON",
			Variant:   display.ButtonSecondary,
			Size:      display.ButtonSizeSM,
			BaseProps: utils.BaseProps{Attrs: templ.Attributes{
				"data-copy-json": userCopyJSON(d),
				"data-copy-ok":   "User copied as JSON.",
				"data-copy-err":  "Clipboard unavailable or denied — nothing was copied.",
			}},
		})
	</div>
}

// profileEditCard holds the two inline profile edits: display name and
// sign-in email. Each is its own form so a save never mixes fields; the email
// form carries a confirm dialog because it changes how the user signs in.
templ profileEditCard(d userDetailData) {
	@display.Card(display.CardProps{
		Title:     "Edit profile",
		BaseProps: utils.BaseProps{Class: "mb-4"},
	}) {
		// T17 F127: data-dirty-guard marks the edit forms for the unsaved-
		// changes guard — admin.js compares live values to defaultValue and
		// raises beforeunload ONLY while something actually differs.
		<form hx-post={ d.BasePath + "/users/" + d.User.ID.Get().String() + "/display-name" } hx-target="this" class="mb-4" data-dirty-guard>
			@forms.Input(forms.InputProps{
				BaseProps: utils.BaseProps{ID: "display_name", Class: "mb-2"},
				Name:       "display_name",
				Value:      d.User.DisplayName,
				Placeholder: "Display name",
				Label:      "Display name",
			})
			@display.Button(display.ButtonProps{
				Text:    "Save display name",
				Type:    display.ButtonHTMLSubmit,
				Variant: display.ButtonSecondary,
				Size:    display.ButtonSizeSM,
			})
		</form>
		<form hx-post={ d.BasePath + "/users/" + d.User.ID.Get().String() + "/email" } hx-target="this" data-dirty-guard>
			@forms.Input(forms.InputProps{
				BaseProps: utils.BaseProps{ID: "email", Class: "mb-2"},
				Name:       "email",
				Type:       forms.InputEmail,
				Value:      d.User.Email,
				Placeholder: "email@example.com",
				Label:      "Email",
				HelpText:   "Changing the email changes how the user signs in and is found.",
			})
			@display.Button(display.ButtonProps{
				Text:    "Save email",
				Type:    display.ButtonHTMLSubmit,
				Variant: display.ButtonSecondary,
				Size:    display.ButtonSizeSM,
				BaseProps: utils.BaseProps{Attrs: templ.Attributes{
					"data-confirm":       "Change this user's email? OAuth providers match by email — the user may lose linked access until re-linked.",
					"data-confirm-title": "Change email",
				}},
			})
		</form>
	}
}

// passkeysCard lists the user's WebAuthn credentials with a remove action.
// Credential ids are binary, so they travel base64url-encoded in the POST
// path. Removing the last passkey leaves the user dependent on OAuth2 (or
// locked out entirely) — the confirm text says so.
templ passkeysCard(d userDetailData) {
	@display.Card(display.CardProps{
		Title:     "Passkeys",
		Padding:   display.CardPaddingNone,
		BaseProps: utils.BaseProps{Class: "mb-4"},
	}) {
		if len(d.User.Credentials) == 0 {
			<div class="px-4 py-3 text-sm text-gray-500">
				No passkeys enrolled. The user signs in via a linked provider or enrolls
				one from their own account page.
			</div>
		} else {
			@display.Table(display.TableProps{
				Headers:     []string{"Name", "Added", "Backup", ""},
				Hover:       true,
				Body:        credentialRows(d),
				Flush:       true,
				CellPadding: display.TableCellPaddingCompact,
			})
		}
	}
}

// credentialRestoreCard wires the F170 backup-JSON restore (POST
// /users/{id}/credentials/restore): a restored credential becomes a trusted
// sign-in factor immediately, so the confirm carries the escalation copy
// pinned in handler_credential_restore_test.go — the card inherits the
// contract, not a paraphrase. Renders only where the deployment can serve
// WebAuthn at all (same probe gate as the Passkeys card).
templ credentialRestoreCard(d userDetailData) {
	@display.Card(display.CardProps{
		Title:   "Restore a passkey from backup",
		BaseProps: utils.BaseProps{Class: "mb-4"},
	}) {
		<form class="px-4 py-3 space-y-2" method="post" action={ d.BasePath + "/users/" + d.User.ID.Get().String() + "/credentials/restore" } data-dirty-guard>
			<label class="block text-sm text-gray-500" for="credential-backup-json">Paste the credential backup JSON (exported from the user's own account page)</label>
			<textarea
				id="credential-backup-json"
				name="backup"
				rows="4"
				class={ "block w-full rounded-md border border-gray-300 bg-white px-3 py-2 font-mono text-xs " + metadataTextClass }
				placeholder={ `{ "id": "…", "public_key": "…", … }` }
				spellcheck="false"
			/>
			<div class="flex justify-end">
				@display.Button(display.ButtonProps{
					Text:    "Restore credential",
					Variant: display.ButtonDanger,
					Size:    display.ButtonSizeSM,
					Icon:    icon("key"),
					BaseProps: utils.BaseProps{Attrs: templ.Attributes{
						"data-confirm":       "Restore a passkey from backup JSON? The uploaded credential becomes a trusted sign-in factor immediately — restore it only from a backup you control.",
						"data-confirm-title": "Restore credential",
						"hx-disabled-elt":    "this",
					}},
				})
			</div>
		</form>
	}
}

templ credentialRows(d userDetailData) {
	for _, c := range d.User.Credentials {
		<tr>
			<td class="px-4 py-2 text-sm font-medium">
				if c.Name != "" {
					{ c.Name }
				} else {
					<span class={ "font-mono text-xs " + metadataTextXSClass }>{ base64.RawURLEncoding.EncodeToString(c.ID)[:12] }…</span>
				}
			</td>
			<td class="px-4 py-2 text-gray-500">
				@display.RelativeTime(display.RelativeTimeProps{Time: c.CreatedAt})
			</td>
			<td class="px-4 py-2">
				if c.BackupState {
					@statusBadge("backed up", display.BadgeSuccess)
				} else if c.BackupEligible {
					@statusBadge("sync pending", display.BadgeWarning)
				} else {
					<span class="text-sm text-gray-600 dark:text-gray-400" aria-hidden="true">—</span>
				}
			</td>
			<td class="px-4 py-2 text-right">
				@display.Button(display.ButtonProps{
					Text:    "Remove",
					Variant: display.ButtonDanger,
					Size:    display.ButtonSizeSM,
					Icon:    icon("trash"),
					BaseProps: utils.BaseProps{Attrs: templ.Attributes{
						"hx-post":            d.BasePath + "/users/" + d.User.ID.Get().String() + "/credentials/" + base64.RawURLEncoding.EncodeToString(c.ID) + "/delete",
						"data-confirm":       removeCredentialConfirm(d, c),
						"data-confirm-title": "Remove passkey",
						"hx-disabled-elt":    "this",
					}},
				})
			</td>
		</tr>
	}
}

// selfServiceCard is the signed-in admin's own detail page: their own
// display-name edit (the existing display-name route), their own grants read
// back as facts (platform roles + tenant memberships — the same resolved
// data the page already carries), and the sign-out link to the endpoint the
// embedding application mounts via Config.LogoutURL. When no sign-out URL is
// configured the card says so instead of rendering a link that would 404 —
// the panel owns no session routes of its own and adds none.
templ selfServiceCard(d userDetailData) {
	@display.Card(display.CardProps{
		Title:     "Your account",
		BaseProps: utils.BaseProps{Class: "mb-4"},
	}) {
		<div class="mb-4 text-sm text-gray-500">
			This is the account you are signed in as. You can edit your own display
			name here; your access grants are listed below as they stand.
		</div>
		<form hx-post={ d.BasePath + "/users/" + d.User.ID.Get().String() + "/display-name" } hx-target="this" class="mb-4" data-dirty-guard>
			@forms.Input(forms.InputProps{
				BaseProps: utils.BaseProps{ID: "self_display_name", Class: "mb-2"},
				Name:       "display_name",
				Value:      d.User.DisplayName,
				Placeholder: "Your display name",
				Label:      "Your display name",
			})
			@display.Button(display.ButtonProps{
				Text:    "Save display name",
				Type:    display.ButtonHTMLSubmit,
				Variant: display.ButtonSecondary,
				Size:    display.ButtonSizeSM,
			})
		</form>
		<div class="mb-4">
			<div class={ "mb-1 text-xs font-medium " + metadataTextXSClass }>Your platform roles</div>
			<div class="flex flex-wrap items-center gap-1.5">
				if len(d.PlatformRoles) == 0 {
					<span class="text-sm text-gray-600 dark:text-gray-400" aria-hidden="true">—</span>
				} else {
					for _, role := range d.PlatformRoles {
						@roleBadge(string(role))
					}
				}
			</div>
		</div>
		<div class="mb-4">
			<div class={ "mb-1 text-xs font-medium " + metadataTextXSClass }>Your tenant memberships</div>
			if len(d.TenantAccess) == 0 {
				<div class="text-sm text-gray-500">You are not a member of any tenant.</div>
			} else {
				<ul class="list-inside list-disc text-sm text-gray-600 dark:text-gray-300">
					for _, access := range d.TenantAccess {
						<li>
							<a class="no-underline hover:underline" href={ d.BasePath + "/tenants/" + access.TenantID }>{ access.Name }</a>
							for _, r := range access.Roles {
								@roleBadge(string(r))
							}
						</li>
					}
				</ul>
			}
		</div>
		if d.SignOutURL != "" {
			@display.Button(display.ButtonProps{
				Text:      "Sign out",
				Href:      d.SignOutURL,
				Variant:   display.ButtonSecondary,
				Size:      display.ButtonSizeSM,
				BaseProps: utils.BaseProps{Class: classNoUnderline},
			})
		} else {
			<div class={ "text-xs " + metadataTextXSClass }>{ signOutAbsentCopy() }</div>
		}
	}
}

// platformAccessCard grants and revokes wildcard-domain roles through the
// durable GrantRoles path (membership events, replayed by the projection —
// ADR-0057). Granting replaces the role set, so the checkboxes show the
// user's current platform roles as the starting point.
templ platformAccessCard(d userDetailData) {
	@display.Card(display.CardProps{
		Title:     "Platform access",
		BaseProps: utils.BaseProps{Class: "mb-4"},
	}) {
		if d.IsSelf {
			<div class="mb-3 rounded-md bg-amber-50 px-3.5 py-2.5 text-xs text-amber-700 dark:bg-amber-900/20 dark:text-amber-300">
				This is your own account — revoking your platform roles locks you out of
				this panel until another admin re-grants them.
			</div>
		}
		<form hx-post={ d.BasePath + "/users/" + d.User.ID.Get().String() + "/roles" } hx-target="this">
			<div class="mb-3 flex flex-wrap gap-4">
				for _, role := range d.GrantableAdminRoles {
					@forms.Checkbox(forms.CheckboxProps{
						BaseProps: utils.BaseProps{ID: "role-" + string(role)},
						Name:       "roles",
						Value:      string(role),
						Label:      string(role),
						Checked:    hasRole(d.PlatformRoles, role),
					})
				}
			</div>
			<div class="flex flex-wrap items-center gap-2.5">
				@display.Button(display.ButtonProps{
					Text:    "Save platform roles",
					Type:    display.ButtonHTMLSubmit,
					Variant: display.ButtonPrimary,
					Size:    display.ButtonSizeSM,
				})
				if len(d.PlatformRoles) > 0 {
					@display.Button(display.ButtonProps{
						Text:    "Revoke all",
						Variant: display.ButtonDanger,
						Size:    display.ButtonSizeSM,
						BaseProps: utils.BaseProps{Attrs: templ.Attributes{
							"hx-post":            d.BasePath + "/users/" + d.User.ID.Get().String() + "/roles/revoke",
							"data-confirm":       revokeRolesConfirm(d),
							"data-confirm-title": "Revoke platform roles",
							"hx-disabled-elt":    "this",
						}},
					})
				}
			</div>
		</form>
	}
}

// userTimelineCard is the per-user audit glance: events about this user's
// stream, both done by them and done to them. The full audit page (linked in
// the card footer) stays the deep-dive.
templ userTimelineCard(d userDetailData) {
	@display.Card(display.CardProps{
		Title:     "Activity",
		Padding:   display.CardPaddingNone,
		BaseProps: utils.BaseProps{Class: "mb-4"},
	}) {
		if len(d.Timeline.Entries) == 0 {
			<div class="px-4 py-3 text-sm text-gray-500">No recorded activity yet.</div>
		} else {
			@display.Table(display.TableProps{
				Headers:     []string{"Action", "Who", "When"},
				Hover:       true,
				Body:        userTimelineRows(d),
				Flush:       true,
				CellPadding: display.TableCellPaddingCompact,
			})
			if d.Timeline.Total > len(d.Timeline.Entries) {
				<div class={ "px-4 py-2 text-xs " + metadataTextXSClass }>
					<a class="no-underline hover:underline" href={ d.BasePath + "/audit?q=" + d.User.ID.Get().String() }>
						View all { strconv.Itoa(d.Timeline.Total) } events
					</a>
				</div>
			}
		}
	}
}

templ userTimelineRows(d userDetailData) {
	for _, e := range d.Timeline.Entries {
		<tr>
			<td class="px-4 py-2">
				@badge(auditLabel(e.Action), auditActionBadge(e.Action))
			</td>
			<td class="px-4 py-2">
				if e.Email != "" {
					<span class="font-medium">{ e.Email }</span>
				} else {
					<span class="text-gray-600 dark:text-gray-400" aria-hidden="true">—</span>
				}
			</td>
			<td class="px-4 py-2 text-gray-500" title={ e.OccurredAt.Format("Jan 2, 2006 15:04 MST") }>
				@display.RelativeTime(display.RelativeTimeProps{Time: e.OccurredAt})
			</td>
		</tr>
	}
	if d.Timeline.Total > len(d.Timeline.Entries) {
		// Load-more trigger: the response fragment replaces THIS row, so the
		// next chunk of the user's timeline appends directly under the
		// existing rows (GET /users/{id}/activity, the audit-window tail).
		<tr id="user-activity-more">
			<td colspan="3" class="px-4 py-2">
				@display.Button(display.ButtonProps{
					Text:    "Load more",
					Variant: display.ButtonSecondary,
					Size:    display.ButtonSizeSM,
					BaseProps: utils.BaseProps{Attrs: templ.Attributes{
						"hx-get":    userActivityURL(d.BasePath, d.User.ID.Get().String(), len(d.Timeline.Entries)),
						"hx-target": "#user-activity-more",
						"hx-swap":   "outerHTML",
					}},
				})
			</td>
		</tr>
	}
}

templ userDetailAvatar(d userDetailData) {
	@display.Avatar(display.AvatarProps{Initials: initials(d.User.Email), Size: display.AvatarSizeLG, Shape: display.AvatarShapeSquare, BaseProps: utils.BaseProps{Class: "h-[52px] w-[52px] rounded-[14px] text-lg"}})
}

// tenantAccessCard is the user-side half of tenant integration: the tenants
// this person can act in, and the durable membership grant that adds one. The
// operations are the SAME membership commands the tenant roster dispatches —
// one authority path, whichever side the admin starts from.
templ tenantAccessCard(d userDetailData) {
@display.Card(display.CardProps{
	Title:     "Tenant access",
	Padding:   display.CardPaddingNone,
	BaseProps: utils.BaseProps{Class: "mb-4", Attrs: templ.Attributes{"data-sync-target": ""}},
}) {
		if len(d.TenantAccess) == 0 {
			<div class="px-4 py-3 text-sm text-gray-500">
				This user is not a member of any tenant yet. Grant access below to scope
				their roles to a tenant.
			</div>
		} else {
			@display.Table(display.TableProps{
				Headers:     []string{"Tenant", "Roles", ""},
				Hover:       true,
				Body:        tenantAccessRows(d),
				Flush:       true,
				CellPadding: display.TableCellPaddingCompact,
			})
		}
		<div class="border-t border-gray-200 pt-4 mt-4">
			if len(d.TenantOptions) == 0 {
				<div class="text-sm text-gray-500">
					This user is a member of every live tenant — nothing to grant here.
					New tenants appear as they are created.
				</div>
			} else {
				<form class="flex flex-wrap items-end gap-2" hx-post={ d.AddTenantAccessURL }>
					// T08 F053: the grant form adopts the same combobox shell,
					// in LOCAL mode (no data-suggest-src): the candidate list
					// is page-shaped (live tenants minus memberships), so it
					// ships once as JSON and admin.js filters per keystroke.
					<div class="max-w-[220px]">
						<label for="admin-grant-tenant-input" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Tenant</label>
						@suggestCombobox("admin-grant-tenant-input", "text", "tenant", "", "Pick a tenant", "", tenantOptionsJSON(d.TenantOptions))
					</div>
					@roleCheckboxGroup(d.AssignableRoles, nil, "Role")
					@display.Button(display.ButtonProps{
						Type:     display.ButtonHTMLSubmit,
						Variant:  display.ButtonPrimary,
						Size:     display.ButtonSizeSM,
						Children: htmx.LoadingButton("Grant access", "Granting…", feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM, Color: "text-white"})),
					})
				</form>
				<div class={ "mt-2 text-xs " + metadataTextXSClass }>
					Only tenants the user does not belong to are offered. Change an existing
					membership's roles in its row above.
				</div>
			}
		</div>
	}
}

templ tenantAccessRows(d userDetailData) {
	for _, access := range d.TenantAccess {
		<tr>
			<td class="px-4 py-2">
				<a class="flex flex-col no-underline" href={ d.BasePath + "/tenants/" + access.TenantID }>
					<span class="font-medium text-gray-900">{ access.Name }</span>
					<span class={ "font-mono text-xs " + metadataTextXSClass }>{ access.Slug }</span>
				</a>
			</td>
			<td class="px-4 py-2">
				<div class="flex flex-wrap items-center gap-1.5">
					for _, r := range access.Roles {
						@roleBadge(string(r))
					}
					<form class="flex items-center gap-1.5" hx-post={ d.UpdateTenantBase + "/" + access.TenantID }>
						@roleCheckboxGroup(d.AssignableRoles, access.Roles, "Set roles in " + access.Name)
						// Downgrade escalation (T12), same contract as the roster's
						// role-change confirm: dropping the tenant's only admin-tier
						// role is refused server-side, so the dialog says so first.
						@display.Button(display.ButtonProps{
							Type:     display.ButtonHTMLSubmit,
							Variant:  display.ButtonSecondary,
							Size:     display.ButtonSizeSM,
							Children: htmx.LoadingButton("Set", "Saving…", feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM})),
							BaseProps: utils.BaseProps{Attrs: templ.Attributes{
								"data-confirm":       tenantRoleChangeConfirm(d, access),
								"data-confirm-title": "Change roles",
							}},
						})
					</form>
				</div>
			</td>
			<td class="px-4 py-2 text-right">
				@display.Button(display.ButtonProps{
					Variant: display.ButtonSecondary,
					Size:    display.ButtonSizeSM,
					Icon:    icon("trash"),
					// Icon-only button: name it for screen readers (axe
					// button-name, first adminui a11y sweep 2026-11-14).
					BaseProps: utils.BaseProps{Attrs: templ.Attributes{
						"aria-label":         "Revoke access to " + access.Name,
						"hx-post":            d.RemoveTenantBase + "/" + access.TenantID + "/delete",
						"data-confirm":       tenantRevokeConfirm(d, access),
						"data-confirm-title": "Revoke tenant access",
						"hx-disabled-elt":    "this",
					}},
				})
			</td>
		</tr>
	}
}

// externalAccountsCard renders the OAuth2/OIDC link/unlink view for a user.
// Admins can unlink any linked provider; linking cannot be initiated here
// because the OAuth2 handshake requires the user to authenticate with the
// provider themselves (the admin cannot impersonate it). Configured providers
// are listed so the admin knows what the user CAN link via their own login.
// The identity rows carry the provider glyph (a generic link glyph — the
// icons module has no brand marks, and a generic glyph is the honest stand-in),
// the issuer-assigned subject id (truncated for display, full value in the
// title attribute), and the linked-at timestamp through the locale seam.
templ externalAccountsCard(p pageData, d userDetailData) {
	@display.Card(display.CardProps{
		Title:     "External accounts",
		Padding:   display.CardPaddingNone,
		BaseProps: utils.BaseProps{Class: "mb-4"},
	}) {
		if len(d.User.ExternalAccounts) == 0 {
			<div class="px-4 py-2 text-sm text-gray-500">No external accounts linked.</div>
		} else {
			@display.Table(display.TableProps{
				Headers:     []string{"Provider", "Subject", "Email", "Linked", ""},
				Hover:       true,
				Body:        externalAccountRows(p, d),
				Flush:       true,
				CellPadding: display.TableCellPaddingCompact,
			})
		}
		<div class="flex flex-wrap items-center gap-2 px-4 py-2">
			<span class={ "text-xs " + metadataTextXSClass }>Linking is done via the user's own OAuth2 login flow.</span>
			<div class="flex flex-wrap gap-1">
				for _, provider := range d.ConfiguredProviders {
					@display.Badge(display.BadgeProps{Text: provider, Type: display.BadgeNeutral, Pill: true})
				}
			</div>
		</div>
	}
}

templ externalAccountRows(p pageData, d userDetailData) {
	for _, ea := range d.User.ExternalAccounts {
		<tr>
			<td class="px-4 py-2">
				<span class="flex items-center gap-1.5">
					@icon("link")
					@display.Badge(display.BadgeProps{Text: ea.Provider, Type: display.BadgeNeutral, Pill: true})
				</span>
			</td>
			<td class="px-4 py-2">
				<span class={ "font-mono text-xs " + metadataTextXSClass } title={ oauthSubjectTitle(ea) }>{ oauthSubjectShort(ea) }</span>
			</td>
			<td class="px-4 py-2 text-sm">{ ea.Email }</td>
			<td class={ "px-4 py-2 text-sm text-gray-500" } title={ p.dateTime(ea.LinkedAt) }>{ p.dateTime(ea.LinkedAt) }</td>
			<td class="px-4 py-2 text-right">
				@display.Button(display.ButtonProps{
					Text:    "Unlink",
					Variant: display.ButtonDanger,
					Size:    display.ButtonSizeSM,
					Icon:    icon("trash"),
					BaseProps: utils.BaseProps{Attrs: templ.Attributes{
						"hx-post":            d.UnlinkExternalBase + "/" + ea.Provider + "/unlink",
						"data-confirm":       "Unlink " + ea.Provider + " from " + d.User.Email + "? The account can be linked again later.",
						"data-confirm-title": "Unlink account",
						"hx-disabled-elt":    "this",
					}},
				})
			</td>
		</tr>
	}
}

// usersPrefsBar is the saved-views + display-prefs toolbar (T20 F146–F149),
// rendered in the users list FILTER BAR only — never inside #users-table
// (that region, its rows and its thead, belong to the bulk/visual agent).
//
// Column-visibility contract (F148): the toggles do NOT touch the table
// markup. admin.js toggles a class on the #users-table CONTAINER —
// admin-cols-hide-access / admin-cols-hide-lastseen — and the stylesheet
// hides the matching COLUMN by position:
//
//	column 2 (Access / tenant-count roles cell) ↔ admin-cols-hide-access
//	column 4 (Last seen cell)                  ↔ admin-cols-hide-lastseen
//
// If the concurrent agent reorders the users thead, ONLY these two
// positional rules need re-pointing; the template and JS stay untouched.
//
// Density contract (F149): the toggle flips admin-density-compact on the
// same container; the stylesheet shrinks cell padding under it.
//
// Preset contract (F147): a preset serializes ONLY the list URL query
// (q/filter/sort/page — window.location.search on the users list). Apply
// navigates to /users?<query>; there is no server state and nothing is
// stored outside the namespaced localStorage key admin.js owns.
templ usersPrefsBar(p pageData, d usersListData) {
	<div
		class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-xs dark:border-gray-700 dark:bg-gray-800/50"
		data-users-prefs
		data-prefs-base={ d.BasePath + "/users" }
	>
		<span class="font-semibold text-gray-900 dark:text-white">{ p.label(labelPrefsTitle) }</span>
		<span class="flex items-center gap-1.5">
			<label class="sr-only" for="users-preset-name">{ p.label(labelPrefsPresetName) }</label>
			<input
				type="text"
				id="users-preset-name"
				data-prefs-name
				placeholder={ p.label(labelPrefsPresetName) }
				autocomplete="off"
				class="w-36 rounded-md border border-gray-300 bg-white px-2 py-1 text-xs text-gray-900 dark:border-gray-600 dark:bg-gray-900 dark:text-white"
			/>
			<button
				type="button"
				data-prefs-save
				class="rounded-md border border-gray-300 bg-white px-2 py-1 font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700"
			>{ p.label(labelPrefsSave) }</button>
		</span>
		<span class="flex items-center gap-1.5" data-prefs-presets>
			<span class="text-gray-600 dark:text-gray-400">{ p.label(labelPrefsNoPresets) }</span>
		</span>
		<span class="flex items-center gap-1.5">
			<span class="text-gray-600 dark:text-gray-400">{ p.label(labelPrefsColumns) }</span>
			<button
				type="button"
				data-prefs-col="access"
				aria-pressed="false"
				class="rounded-full border border-gray-300 px-2 py-0.5 font-medium text-gray-600 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
			>{ p.label(labelPrefsColAccess) }</button>
			<button
				type="button"
				data-prefs-col="lastseen"
				aria-pressed="false"
				class="rounded-full border border-gray-300 px-2 py-0.5 font-medium text-gray-600 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
			>{ p.label(labelPrefsColLastSeen) }</button>
		</span>
		<span class="flex items-center gap-1.5">
			<span class="text-gray-600 dark:text-gray-400">{ p.label(labelPrefsDensity) }</span>
			<button
				type="button"
				data-prefs-density
				aria-pressed="false"
				class="rounded-md border border-gray-300 px-2 py-0.5 font-medium text-gray-600 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
			>{ p.label(labelPrefsDensityCompact) }</button>
		</span>
	</div>
}
