package adminui

templ tenantsPage(p pageData, d tenantsListData) {
	@Layout(p) {
		@tenantsContent(d)
	}
}

templ tenantsContent(d tenantsListData) {
	<div class="mb-5 flex flex-wrap items-center gap-3">
		<h1 class="text-xl font-semibold">Tenants</h1>
		<div class="flex-1"></div>
		<a class="inline-flex items-center gap-1 rounded-md bg-blue-600 px-2.5 py-1.5 text-sm font-semibold text-white no-underline hover:bg-blue-500" href={ d.BasePath + "/tenants/new" }>@icon("plus") New tenant</a>
	</div>
	<div class="rounded-[10px] border border-gray-200 shadow-sm" style="background:var(--surface)">
		@tenantsTable(d)
	</div>
}

templ tenantsTable(d tenantsListData) {
	if len(d.Tenants) == 0 {
		@empty("tenants", "No tenants yet", "Create a tenant to scope roles and memberships.")
	} else {
		<div class="overflow-x-auto">
			<table class="w-full text-sm">
				<thead><tr><th class="px-4 py-2 text-left font-semibold text-gray-500">Name</th><th class="px-4 py-2 text-left font-semibold text-gray-500">Status</th><th></th></tr></thead>
				<tbody>
					for _, t := range d.Tenants {
						<tr class="border-t border-gray-200 hover:bg-gray-50">
							<td class="px-4 py-2">
								<a class="flex flex-col no-underline" href={ d.BasePath + "/tenants/" + t.ID.Get() }>
									<span class="font-medium text-gray-900">{ t.DisplayName }</span>
									<span class="font-mono text-xs text-gray-400">{ t.Name }</span>
								</a>
							</td>
							<td class="px-4 py-2">
								if t.Suspended {
									@badge("suspended", "amber")
								} else if t.Deleted {
									@badge("deleted", "red")
								} else {
									@badge("active", "green")
								}
							</td>
							<td class="px-4 py-2 text-right">
								<a class="rounded-md px-2.5 py-1 text-sm text-gray-600 no-underline hover:bg-gray-100" href={ d.BasePath + "/tenants/" + t.ID.Get() }>Manage</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		@listNote(len(d.Tenants), d.Total)
	}
}

templ tenantNewPage(p pageData, basePath string) {
	@Layout(p) {
		<div class="mb-5 flex flex-wrap items-center gap-3">
			<a class="rounded-md px-2.5 py-1 text-sm text-gray-600 no-underline hover:bg-gray-100" href={ basePath + "/tenants" }>← Tenants</a>
		</div>
		<h1 class="mb-4 text-xl font-semibold">New tenant</h1>
		<div class="max-w-[520px] rounded-[10px] border border-gray-200 shadow-sm" style="background:var(--surface)">
			<div class="p-[18px]">
				<form hx-post={ basePath + "/tenants" } hx-target="this">
					<div class="mb-4">
						<label class="mb-1 block text-sm font-medium text-gray-700" for="name">Name</label>
						<input class="w-full rounded-md border border-gray-300 px-3 py-1.5 text-sm" id="name" name="name" required placeholder="acme-corp"/>
						<div class="mt-1 text-xs text-gray-500">A unique, URL-safe identifier.</div>
					</div>
					<div class="mb-4">
						<label class="mb-1 block text-sm font-medium text-gray-700" for="display_name">Display name</label>
						<input class="w-full rounded-md border border-gray-300 px-3 py-1.5 text-sm" id="display_name" name="display_name" placeholder="Acme Corporation"/>
					</div>
					<div class="flex gap-2.5">
						<button class="rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-500" type="submit">Create tenant</button>
						<a class="rounded-md px-3 py-2 text-sm text-gray-600 no-underline hover:bg-gray-100" href={ basePath + "/tenants" }>Cancel</a>
					</div>
				</form>
			</div>
		</div>
	}
}

templ tenantDetailPage(p pageData, d tenantDetailData) {
	@Layout(p) {
		<div class="mb-5 flex flex-wrap items-center gap-3">
			<a class="rounded-md px-2.5 py-1 text-sm text-gray-600 no-underline hover:bg-gray-100" href={ d.BasePath + "/tenants" }>← Tenants</a>
			<div class="flex-1"></div>
			if d.Tenant.Suspended {
				@badge("suspended", "amber")
			} else if d.Tenant.Deleted {
				@badge("deleted", "red")
			} else {
				@badge("active", "green")
			}
		</div>
		<h1 class="mb-1 text-xl font-semibold">{ d.Tenant.DisplayName }</h1>
		<div class="mb-5 font-mono text-xs text-gray-400">{ d.Tenant.Name }</div>
		<div class="mb-4">@membersCard(d)</div>
		<div class="rounded-[10px] border border-gray-200 shadow-sm" style="background:var(--surface)">
			<div class="flex items-center gap-2.5 border-b border-gray-200 px-[18px] py-[15px]"><span class="text-[15px] text-red-600">Danger zone</span></div>
			<div class="flex flex-wrap gap-2.5 p-[18px]">
				if d.Tenant.Suspended {
					<button class="rounded-md bg-blue-600 px-2.5 py-1.5 text-sm font-semibold text-white hover:bg-blue-500" hx-post={ d.BasePath + "/tenants/" + d.Tenant.ID.Get() + "/reactivate" } hx-confirm="Reactivate this tenant?">Reactivate</button>
				} else {
					<button class="rounded-md border border-gray-300 px-2.5 py-1.5 text-sm font-medium hover:bg-gray-50" hx-post={ d.BasePath + "/tenants/" + d.Tenant.ID.Get() + "/suspend" } hx-confirm="Suspend this tenant?">Suspend</button>
				}
				<button class="inline-flex items-center gap-1 rounded-md bg-red-600 px-2.5 py-1.5 text-sm font-semibold text-white hover:bg-red-500" hx-post={ d.BasePath + "/tenants/" + d.Tenant.ID.Get() + "/delete" } data-confirm="Delete this tenant and remove all memberships? This cannot be undone.">@icon("trash") Delete</button>
			</div>
		</div>
	}
}
