package adminui

import (
	"strconv"

	"github.com/larsartmann/cqrs-htmx/usermgmt/v4"
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/forms"
	"github.com/larsartmann/templ-components/navigation"
	"github.com/larsartmann/templ-components/utils"
	"github.com/larsartmann/templ-components/utils/wire"
)

templ tenantsPage(p pageData, d tenantsListData) {
	@Layout(p, tenantsContent(d))
}

templ tenantsContent(d tenantsListData) {
	@display.PageHeader(display.PageHeaderProps{
		Title:  "Tenants",
		Action: newTenantAction(d),
	})
	<div class="mb-4 flex items-center gap-2">
		@forms.FilterInput(forms.FilterInputProps{
			Name:        "q",
			Value:       d.Search,
			Placeholder: "Search tenants…",
			Action:      d.BasePath + "/tenants",
			DebounceMS:  350,
			Wire:        &wire.Action{URL: d.BasePath + "/tenants", Target: "#tenants-table"},
			BaseProps: utils.BaseProps{
				AriaLabel: "Search tenants",
				Class:     "w-full max-w-xs",
				Attrs: templ.Attributes{
					"autocomplete": "off",
					"hx-get":       d.BasePath + "/tenants",
					"hx-trigger":   "submit",
					"hx-target":    "#tenants-table",
					"hx-swap":      "innerHTML",
					"hx-push-url":  "true",
					"hx-indicator": "#tenants-search-spinner",
				},
			},
		})
		<span id="tenants-search-spinner" class="htmx-indicator text-gray-400">
			@spinnerSM()
		</span>
	</div>
	<div id="tenants-table">
		@tenantsTableContent(d)
	</div>
}

templ tenantsTableContent(d tenantsListData) {
	if len(d.Tenants) == 0 {
		@display.Card(display.CardProps{Padding: display.CardPaddingNone}) {
			if d.Search != "" {
				@empty("tenants", "No tenants match your search", "No tenant name or slug matches the search term.", "Clear search", d.BasePath+"/tenants")
			} else {
				@empty("tenants", "No tenants yet", "Create a tenant to scope roles and memberships.", "New tenant", d.BasePath+"/tenants/new")
			}
		}
	} else {
		@display.Table(display.TableProps{
			Headers:     []string{"Tenant", "Members", "Status", ""},
			Hover:       true,
			Body:        tenantsRows(d),
			CellPadding: display.TableCellPaddingCompact,
		})
		@listNote(len(d.Tenants), d.Total)
		@listPager(listPageURL(d.BasePath+"/tenants", d.Search), d.Page, d.TotalPages)
	}
}

// newTenantAction is the PageHeader action slot for the tenants list: the
// primary "New tenant" entry point rides on the title row.
templ newTenantAction(d tenantsListData) {
	@display.Button(display.ButtonProps{
		Text:      "New tenant",
		Href:      d.BasePath + "/tenants/new",
		Variant:   display.ButtonPrimary,
		Size:      display.ButtonSizeSM,
		Icon:      icon("plus"),
		BaseProps: utils.BaseProps{Class: classNoUnderline},
	})
}

templ tenantsRows(d tenantsListData) {
	for _, row := range d.Tenants {
		<tr>
			<td class="px-4 py-2">
				<a class="flex flex-col no-underline" href={ d.BasePath + "/tenants/" + row.Tenant.ID.Get() }>
					<span class="font-medium text-gray-900">{ row.Tenant.DisplayName }</span>
					<span class="font-mono text-xs text-gray-400">{ row.Tenant.Name }</span>
				</a>
			</td>
			<td class="px-4 py-2 text-gray-600">
				<a class="no-underline hover:underline" href={ d.BasePath + "/tenants/" + row.Tenant.ID.Get() }>
					{ strconv.Itoa(row.MemberCount) }
					if row.MemberCount == 1 {
						<span class="text-gray-400"> member</span>
					} else {
						<span class="text-gray-400"> members</span>
					}
				</a>
			</td>
			<td class="px-4 py-2">
				@tenantStatusBadge(row.Tenant)
			</td>
			<td class="px-4 py-2 text-right">
				<a class="rounded-md px-2.5 py-1 text-sm text-gray-600 no-underline hover:bg-gray-100" href={ d.BasePath + "/tenants/" + row.Tenant.ID.Get() }>Manage</a>
			</td>
		</tr>
	}
}

// tenantStatusBadge renders a tenant's lifecycle state as one dot-prefixed
// status badge. Suspended is checked before deleted: a suspended-then-deleted
// tenant still reads as deleted, matching the list's previous precedence.
templ tenantStatusBadge(t *usermgmt.Tenant) {
	if t.Suspended {
		@statusBadge("suspended", display.BadgeWarning)
	} else if t.Deleted {
		@statusBadge("deleted", display.BadgeError)
	} else {
		@statusBadge("active", display.BadgeSuccess)
	}
}

templ tenantNewPage(p pageData, basePath string) {
	@Layout(p, tenantNewContent(basePath))
}

templ tenantNewContent(basePath string) {
	@display.PageHeader(display.PageHeaderProps{
		Breadcrumb: navigation.Breadcrumbs(navigation.BreadcrumbsProps{Items: []navigation.BreadcrumbItem{
			{Text: "Tenants", Href: basePath + "/tenants"},
			{Text: "New"},
		}}),
		Title: "New tenant",
	})
	<div class="max-w-[520px]">
		@display.Card(display.CardProps{}) {
			<form hx-post={ basePath + "/tenants" } hx-target="this">
				<div class="mb-4">
					@forms.Input(forms.InputProps{
						BaseProps:   utils.BaseProps{ID: "name"},
						Name:        "name",
						Label:       "Tenant slug",
						Placeholder: "acme-corp",
						Required:    true,
						HelpText:    "A unique, URL-safe identifier. It cannot be changed later.",
					})
				</div>
				<div class="mb-4">
					@forms.Input(forms.InputProps{
						BaseProps:   utils.BaseProps{ID: "display_name"},
						Name:        "display_name",
						Label:       "Display name",
						Placeholder: "Acme Corporation",
						HelpText:    "Optional. Shown in the panel instead of the slug.",
					})
				</div>
				<div class="flex gap-2.5">
					@display.Button(display.ButtonProps{Text: "Create tenant", Type: display.ButtonHTMLSubmit, Variant: display.ButtonPrimary})
					@display.Button(display.ButtonProps{Text: "Cancel", Href: basePath + "/tenants", Variant: display.ButtonSecondary, BaseProps: utils.BaseProps{Class: classNoUnderline}})
				</div>
			</form>
		}
	</div>
}

// tenantStatusAction is the PageHeader action slot on the tenant detail
// page: the live tenant status rides on the title row.
templ tenantStatusAction(d tenantDetailData) {
	if d.Tenant != nil {
		@tenantStatusBadge(d.Tenant)
	}
}

templ tenantDetailPage(p pageData, d tenantDetailData) {
	@Layout(p, tenantDetailContent(d))
}

templ tenantDetailContent(d tenantDetailData) {
	@display.PageHeader(display.PageHeaderProps{
		Breadcrumb: navigation.Breadcrumbs(navigation.BreadcrumbsProps{Items: []navigation.BreadcrumbItem{
			{Text: "Tenants", Href: d.BasePath + "/tenants"},
			{Text: d.Tenant.DisplayName},
		}}),
		Title:    d.Tenant.DisplayName,
		Subtitle: d.Tenant.Name,
		Action:   tenantStatusAction(d),
	})
	<div class="mb-4">
		@tenantMetaCard(d)
	</div>
	<div class="mb-4">
		@membersCard(d)
	</div>
	@display.Card(display.CardProps{
		Header: dangerZoneHeader(),
	}) {
		<div class="flex flex-wrap gap-2.5">
			if d.Tenant.Suspended {
				@display.Button(display.ButtonProps{
					Text:    "Reactivate",
					Variant: display.ButtonPrimary,
					Size:    display.ButtonSizeSM,
					BaseProps: utils.BaseProps{Attrs: templ.Attributes{
						"hx-post":            d.BasePath + "/tenants/" + d.Tenant.ID.Get() + "/reactivate",
						"data-confirm":       "Reactivate this tenant? Members regain access immediately.",
						"data-confirm-title": "Reactivate tenant",
						"hx-disabled-elt":    "this",
					}},
				})
			} else {
				@display.Button(display.ButtonProps{
					Text:    "Suspend",
					Variant: display.ButtonSecondary,
					Size:    display.ButtonSizeSM,
					BaseProps: utils.BaseProps{Attrs: templ.Attributes{
						"hx-post":            d.BasePath + "/tenants/" + d.Tenant.ID.Get() + "/suspend",
						"data-confirm":       "Suspend this tenant? Members lose access until it is reactivated.",
						"data-confirm-title": "Suspend tenant",
						"hx-disabled-elt":    "this",
					}},
				})
			}
			@display.Button(display.ButtonProps{
				Text:    "Delete",
				Variant: display.ButtonDanger,
				Size:    display.ButtonSizeSM,
				Icon:    icon("trash"),
				BaseProps: utils.BaseProps{Attrs: templ.Attributes{
					"hx-post":            d.BasePath + "/tenants/" + d.Tenant.ID.Get() + "/delete",
					"data-confirm":       "Delete this tenant and remove all memberships? This cannot be undone.",
					"data-confirm-title": "Delete tenant",
					"hx-disabled-elt":    "this",
				}},
			})
		</div>
	}
}

// tenantMetaCard is the tenant's identity block: the id (copyable, for support
// tickets and API calls), the immutable slug, the live lifecycle state, and
// the current roster size. It answers "which tenant am I looking at" without
// making the admin infer it from the members below.
templ tenantMetaCard(d tenantDetailData) {
	@display.Card(display.CardProps{Title: "Tenant"}) {
		@display.DefinitionList(display.DefinitionListProps{
			Items: []display.DefinitionItem{
				{Term: "Tenant ID", DetailComponent: copyableID(d.Tenant.ID.Get())},
				{Term: "Slug", Detail: d.Tenant.Name},
				{Term: "Display name", Detail: d.Tenant.DisplayName},
				{Term: "Status", DetailComponent: tenantStatusAction(d)},
				{Term: "Members", Detail: strconv.Itoa(len(d.Members))},
			},
		})
	}
}
