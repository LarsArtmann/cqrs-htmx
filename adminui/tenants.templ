package adminui

import (
	"fmt"
	"strconv"

	"github.com/larsartmann/cqrs-htmx/usermgmt/v4"
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/forms"
	"github.com/larsartmann/templ-components/navigation"
	"github.com/larsartmann/templ-components/utils"
	"github.com/larsartmann/templ-components/utils/wire"
)

templ tenantsPage(p pageData, d tenantsListData) {
	@Layout(p, tenantsContent(p, d))
}

templ tenantsContent(p pageData, d tenantsListData) {
	@display.PageHeader(display.PageHeaderProps{
		Title:  p.label(labelPageTenants),
		Action: newTenantAction(p, d),
	})
	<div class="mb-4 flex items-center gap-2">
		@forms.FilterInput(forms.FilterInputProps{
			Name:        "q",
			Value:       d.Search,
			Placeholder: p.label(labelSearchTenantsPH),
			Action:      d.BasePath + "/tenants",
			DebounceMS:  350,
			Wire:        &wire.Action{URL: d.BasePath + "/tenants", Target: "#tenants-table"},
			BaseProps: utils.BaseProps{
				AriaLabel: p.label(labelSearchTenantsAria),
				Class:     "w-full max-w-xs",
				Attrs: templ.Attributes{
					"autocomplete": "off",
					"hx-get":       d.BasePath + "/tenants",
					"hx-trigger":   "submit",
					"hx-target":    "#tenants-table",
					"hx-swap":      "innerHTML",
					"hx-push-url":  "true",
					"hx-indicator": "#tenants-search-spinner",
				},
			},
		})
		<span id="tenants-search-spinner" class="htmx-indicator text-gray-400">
			@spinnerSM()
		</span>
	</div>
	// Lifecycle filter chips + sort control: plain links so the state is a
	// shareable URL, preserving the current search. Counts are the
	// search-scoped mix, so a chip never promises rows the search hides.
	// gray-600 (not 500): Tailwind v4's gray-500 misses 4.5:1 on white — the
	// first adminui axe sweep flagged it (2026-11-14).
	<div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-sm">
		@tenantStatusChip(d, "", p.label(labelChipAll), d.Total)
		@tenantStatusChip(d, "active", p.label(labelChipActive), d.StatusCounts["active"])
		@tenantStatusChip(d, "suspended", p.label(labelChipSuspended), d.StatusCounts["suspended"])
		@tenantStatusChip(d, "deleted", p.label(labelChipDeleted), d.StatusCounts["deleted"])
		<span class="text-gray-300" aria-hidden="true">|</span>
		<span class="text-gray-600 dark:text-gray-400">{ p.label(labelSortWord) }</span>
		@tenantSortLink(d, "name", p.label(labelSortName))
		<span class="text-gray-300" aria-hidden="true">/</span>
		@tenantSortLink(d, "members", p.label(labelHeaderMembers))
	</div>
	<div id="tenants-table">
		@tenantsTableContent(p, d)
	</div>
}

// tenantStatusChip is one lifecycle filter chip; current carries the active
// styling. The count rides the label so the chip is honest about what it
// shows.
templ tenantStatusChip(d tenantsListData, status, label string, count int) {
	if d.Status == status {
		<span class="rounded-full bg-gray-900 px-2.5 py-0.5 font-medium text-white">
			{ label } ({ strconv.Itoa(count) })
		</span>
	} else {
		<a
			class="rounded-full px-2.5 py-0.5 text-gray-600 no-underline hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800"
			href={ tenantListURL(d, status, d.Sort) }
		>{ label } ({ strconv.Itoa(count) })</a>
	}
}

// tenantSortLink is one half of the ordering toggle; current carries the
// active styling.
templ tenantSortLink(d tenantsListData, sort, label string) {
	if d.Sort == sort {
		<span class="font-medium text-gray-900">{ label }</span>
	} else {
		<a
			class="text-gray-600 no-underline hover:text-gray-900 dark:text-gray-400"
			href={ tenantListURL(d, d.Status, sort) }
		>{ label }</a>
	}
}

templ tenantsTableContent(p pageData, d tenantsListData) {
	if len(d.Tenants) == 0 {
		@display.Card(display.CardProps{Padding: display.CardPaddingNone}) {
			if d.Search != "" {
				@empty("tenants", p.label(labelEmptyTenantsSearchTitle), p.label(labelEmptyTenantsSearchHint), p.label(labelEmptyTenantsSearchAction), d.BasePath+"/tenants")
			} else {
				@empty("tenants", p.label(labelEmptyTenantsNoneTitle), p.label(labelEmptyTenantsNoneHint), p.label(labelEmptyTenantsNoneAction), d.BasePath+"/tenants/new")
			}
		}
	} else {
		@display.Table(display.TableProps{
			Headers:     []string{p.label(labelHeaderTenant), p.label(labelHeaderMembers), p.label(labelHeaderStatus), ""},
			Hover:       true,
			Body:        tenantsRows(d),
			CellPadding: display.TableCellPaddingCompact,
		})
		@listNote(len(d.Tenants), d.Total)
		// The pager rides tenantListURL (not the q-only listPageURL), so a
		// page turn keeps the lifecycle filter AND the ordering.
		@listPager(tenantListURL(d, d.Status, d.Sort), d.Page, d.TotalPages)
	}
}

// newTenantAction is the PageHeader action slot for the tenants list: the
// primary "New tenant" entry point rides on the title row.
templ newTenantAction(p pageData, d tenantsListData) {
	@display.Button(display.ButtonProps{
		Text:      p.label(labelActionNewTenant),
		Href:      d.BasePath + "/tenants/new",
		Variant:   display.ButtonPrimary,
		Size:      display.ButtonSizeSM,
		Icon:      icon("plus"),
		BaseProps: utils.BaseProps{Class: classNoUnderline},
	})
}

templ tenantsRows(d tenantsListData) {
	for _, row := range d.Tenants {
		<tr>
			<td class="px-4 py-2">
				<a class="flex flex-col no-underline" href={ d.BasePath + "/tenants/" + row.Tenant.ID.Get() }>
					<span class="font-medium text-gray-900">{ row.Tenant.DisplayName }</span>
					<span class={ "font-mono text-xs " + metadataTextXSClass }>{ row.Tenant.Name }</span>
				</a>
			</td>
			<td class="px-4 py-2 text-gray-600">
				<a class="no-underline hover:underline" href={ d.BasePath + "/tenants/" + row.Tenant.ID.Get() }>
					{ strconv.Itoa(row.MemberCount) }
					if row.MemberCount == 1 {
						<span class="text-gray-600 dark:text-gray-400"> member</span>
					} else {
						<span class="text-gray-600 dark:text-gray-400"> members</span>
					}
				</a>
			</td>
			<td class="px-4 py-2">
				@tenantStatusBadge(row.Tenant)
			</td>
			<td class="px-4 py-2 text-right">
				<a class="rounded-md px-2.5 py-1 text-sm text-gray-600 no-underline hover:bg-gray-100" href={ d.BasePath + "/tenants/" + row.Tenant.ID.Get() }>Manage</a>
			</td>
		</tr>
	}
}

// tenantStatusBadge renders a tenant's lifecycle state as one dot-prefixed
// status badge. Suspended is checked before deleted: a suspended-then-deleted
// tenant still reads as deleted, matching the list's previous precedence.
templ tenantStatusBadge(t *usermgmt.Tenant) {
	if t.Suspended {
		@statusBadge("suspended", display.BadgeWarning)
	} else if t.Deleted {
		@statusBadge("deleted", display.BadgeError)
	} else {
		@statusBadge("active", display.BadgeSuccess)
	}
}

templ tenantNewPage(p pageData, basePath string) {
	@Layout(p, tenantNewContent(p, basePath))
}

templ tenantNewContent(p pageData, basePath string) {
	@display.PageHeader(display.PageHeaderProps{
		Breadcrumb: navigation.Breadcrumbs(navigation.BreadcrumbsProps{Items: []navigation.BreadcrumbItem{
			{Text: p.label(labelPageTenants), Href: basePath + "/tenants"},
			{Text: p.label(labelActionNew), Href: basePath + "/tenants"},
		}}),
		Title: p.label(labelActionNewTenant),
	})
	<div class="max-w-[520px]">
		@display.Card(display.CardProps{}) {
			<form hx-post={ basePath + "/tenants" } hx-target="this">
				<div class="mb-4">
					@forms.Input(forms.InputProps{
						BaseProps: utils.BaseProps{
							ID: "name",
							// F152: admin.js auto-suggests the slug from the display
							// name; the field stays freely editable and the suggest
							// never overwrites a manual edit (data-slug-suggest marks
							// the target; the touched flag lives on the element).
							Attrs: templ.Attributes{"data-slug-suggest": ""},
						},
						Name:        "name",
						Label:       p.label(labelFormTenantSlug),
						Placeholder: "acme-corp",
						Required:    true,
						HelpText:    p.label(labelFormTenantSlugHelp),
					})
				</div>
				<div class="mb-4">
					@forms.Input(forms.InputProps{
						BaseProps:   utils.BaseProps{ID: "display_name"},
						Name:        "display_name",
						Label:       p.label(labelFormTenantDisplayName),
						Placeholder: "Acme Corporation",
						HelpText:    p.label(labelFormTenantDisplayNameHelp),
					})
				</div>
				<div class="flex gap-2.5">
					@display.Button(display.ButtonProps{Text: p.label(labelActionCreateTenant), Type: display.ButtonHTMLSubmit, Variant: display.ButtonPrimary})
					@display.Button(display.ButtonProps{Text: p.label(labelConfirmCancel), Href: basePath + "/tenants", Variant: display.ButtonSecondary, BaseProps: utils.BaseProps{Class: classNoUnderline}})
				</div>
			</form>
		}
	</div>
}

// tenantStatusAction is the PageHeader action slot on the tenant detail
// page: the live tenant status rides on the title row.
templ tenantStatusAction(d tenantDetailData) {
	if d.Tenant != nil {
		@tenantStatusBadge(d.Tenant)
	}
}

templ tenantDetailPage(p pageData, d tenantDetailData) {
	@Layout(p, tenantDetailContent(p, d))
}

templ tenantDetailContent(p pageData, d tenantDetailData) {
	// F155: a deleted tenant renders ONLY its tombstone. This branch is the
	// second lock after the handler's: the live view below cannot render for
	// tombstone data even if a future caller forgets the guard.
	if d.Tombstone != nil {
		@tenantTombstoneContent(p, d)
		return
	}
	@display.PageHeader(display.PageHeaderProps{
		Breadcrumb: navigation.Breadcrumbs(navigation.BreadcrumbsProps{Items: []navigation.BreadcrumbItem{
			{Text: p.label(labelPageTenants), Href: d.BasePath + "/tenants"},
			{Text: d.Tenant.DisplayName},
		}}),
		Title:    d.Tenant.DisplayName,
		Subtitle: d.Tenant.Name,
		Action:   tenantStatusAction(d),
	})
	<div class="mb-4">
		@tenantMetaCard(d)
	</div>
	if d.Tenant.Suspended {
			@tenantSuspendedBanner(p, d)
	}
	<div class="mb-4">
		@membersCard(p, d)
	</div>
	@display.Card(display.CardProps{
		Header: dangerZoneHeader(),
	}) {
		<div class="flex flex-wrap gap-2.5">
			if d.Tenant.Suspended {
				@display.Button(display.ButtonProps{
					Text:    p.label(labelActionReactivate),
					Variant: display.ButtonPrimary,
					Size:    display.ButtonSizeSM,
					BaseProps: utils.BaseProps{Attrs: templ.Attributes{
						"hx-post":            d.BasePath + "/tenants/" + d.Tenant.ID.Get() + "/reactivate",
						"data-confirm":       p.label(labelConfirmTenReactivateBod),
						"data-confirm-title": p.label(labelConfirmTenReactivate),
						"hx-disabled-elt":    "this",
					}},
				})
			} else {
				@display.Button(display.ButtonProps{
					Text:    p.label(labelActionSuspend),
					Variant: display.ButtonSecondary,
					Size:    display.ButtonSizeSM,
					BaseProps: utils.BaseProps{Attrs: templ.Attributes{
						"hx-post":            d.BasePath + "/tenants/" + d.Tenant.ID.Get() + "/suspend",
						"data-confirm":       tenantSuspendConfirm(p.Labels, d),
						"data-confirm-title": p.label(labelConfirmTenSuspend),
						"hx-disabled-elt":    "this",
					}},
				})
			}
			@display.Button(display.ButtonProps{
				Text:    p.label(labelActionDelete),
				Variant: display.ButtonDanger,
				Size:    display.ButtonSizeSM,
				Icon:    icon("trash"),
				BaseProps: utils.BaseProps{Attrs: templ.Attributes{
					"hx-post":            d.BasePath + "/tenants/" + d.Tenant.ID.Get() + "/delete",
					"data-confirm":       tenantDeleteConfirm(p.Labels, d),
					"data-confirm-title": p.label(labelConfirmTenDelete),
					"hx-disabled-elt":    "this",
				}},
			})
		</div>
	}
}

// tenantMetaCard is the tenant's identity block: the id (copyable, for support
// tickets and API calls), the immutable slug, the live lifecycle state, and
// the current roster size. It answers "which tenant am I looking at" without
// making the admin infer it from the members below.
templ tenantMetaCard(d tenantDetailData) {
	@display.Card(display.CardProps{Title: "Tenant", BaseProps: utils.BaseProps{Attrs: templ.Attributes{"data-sync-target": ""}}}) {
		@display.DefinitionList(display.DefinitionListProps{
			Items: []display.DefinitionItem{
				{Term: "Tenant ID", DetailComponent: copyableID(d.Tenant.ID.Get())},
				{Term: "Slug", Detail: d.Tenant.Name},
				{Term: "Display name", Detail: d.Tenant.DisplayName},
				{Term: "Status", DetailComponent: tenantStatusAction(d)},
				{Term: "Members", Detail: strconv.Itoa(d.TotalMembers)},
				{Term: "Roles", DetailComponent: roleDistributionDetail(d)},
			},
		})
	}
}

// roleDistributionDetail is the identity card's "who holds which roles here"
// row: one line per held role with its holder count ("owner ×1 · admin ×2").
// An empty roster renders a dash rather than a fabricated zero row.
templ roleDistributionDetail(d tenantDetailData) {
	if len(d.RoleDistribution) == 0 {
		<span class={ metadataTextClass } aria-hidden="true">—</span>
	} else {
		<span class={ metadataTextClass } title="How many members hold each role in this tenant">{ roleDistributionSummary(d.RoleDistribution) }</span>
	}
}

// tenantSuspendedBanner is the standing suspended state (T12): the fact that
// every member of this tenant is locked out is announced where the admin is
// looking, with the reactivate CTA in context — the same existing POST the
// danger zone offers, no new route.
templ tenantSuspendedBanner(p pageData, d tenantDetailData) {
	<div class="mb-4">
		@feedback.Alert(feedback.AlertProps{
			Type:    feedback.FeedbackWarning,
			Title:   "This tenant is suspended",
			Message: fmt.Sprintf("Its %d member(s) cannot sign in until it is reactivated.", len(d.Members)),
		})
		<div class="mt-2">
			@display.Button(display.ButtonProps{
				Text:    "Reactivate tenant",
				Variant: display.ButtonPrimary,
				Size:    display.ButtonSizeSM,
				BaseProps: utils.BaseProps{Attrs: templ.Attributes{
					"hx-post":            d.BasePath + "/tenants/" + d.Tenant.ID.Get() + "/reactivate",
					"data-confirm":       p.label(labelConfirmTenReactivateBod),
					"data-confirm-title": p.label(labelConfirmTenReactivate),
					"hx-disabled-elt":    "this",
				}},
			})
		</div>
	</div>
}

// tenantTombstonePage is the deleted tenant's read-only detail view (F154):
// identity only, with deletion facts resolved from the audit window. No
// members card, no actions — a deleted tenant has no live state to manage.
templ tenantTombstonePage(p pageData, d tenantDetailData) {
	@Layout(p, tenantTombstoneContent(p, d))
}

templ tenantTombstoneContent(p pageData, d tenantDetailData) {
	@display.PageHeader(display.PageHeaderProps{
		Breadcrumb: navigation.Breadcrumbs(navigation.BreadcrumbsProps{Items: []navigation.BreadcrumbItem{
			{Text: p.label(labelPageTenants), Href: d.BasePath + "/tenants"},
			{Text: d.Tenant.DisplayName},
		}}),
		Title:    d.Tenant.DisplayName,
		Subtitle: d.Tenant.Name,
		Action:   tenantStatusAction(d),
	})
	<div class="mb-4">
		@feedback.Alert(feedback.AlertProps{
			Type:    feedback.FeedbackInfo,
			Title:   p.label(labelTombstoneTitle),
			Message: "This tenant is deleted. Its memberships were revoked; this page is a read-only record.",
		})
	</div>
	<div class="max-w-[520px]">
		@display.Card(display.CardProps{Title: "Tenant"}) {
			@display.DefinitionList(display.DefinitionListProps{
				Items: []display.DefinitionItem{
					{Term: "Tenant ID", DetailComponent: copyableID(d.Tenant.ID.Get())},
					{Term: "Slug", Detail: d.Tenant.Name},
					{Term: "Display name", Detail: d.Tenant.DisplayName},
					{Term: p.label(labelHeaderStatus), DetailComponent: tenantStatusAction(d)},
					{Term: "Deleted", DetailComponent: tombstoneDeletedAt(p, d.Tombstone)},
					{Term: "Deleted by", DetailComponent: tombstoneDeletedBy(p, d.Tombstone)},
				},
			})
			if d.RosterExportURL != "" {
				<div class="mt-4">
					@display.Button(display.ButtonProps{
						Text:      p.label(labelActionExportRoster),
						Href:      d.RosterExportURL,
						Variant:   display.ButtonSecondary,
						Size:      display.ButtonSizeSM,
						BaseProps: utils.BaseProps{Class: classNoUnderline},
					})
				</div>
			}
		}
	</div>
}

// tombstoneDeletedAt renders the deletion time, or the honest "not recorded"
// when the audit window no longer holds the TenantDeleted entry (F154).
templ tombstoneDeletedAt(p pageData, tb *tenantTombstone) {
	if tb.Recorded && !tb.DeletedAt.IsZero() {
		<span title={ p.dateTime(tb.DeletedAt) }>{ p.date(tb.DeletedAt) }</span>
	} else {
		<span class={ metadataTextClass }>{ p.label(labelTombstoneNotRecorded) }</span>
	}
}

// tombstoneDeletedBy renders the resolving actor (email when the directory
// knows them), or "not recorded" for a pre-actor-chain or rotated-away entry.
templ tombstoneDeletedBy(p pageData, tb *tenantTombstone) {
	if tb.Recorded && tb.DeletedBy != "" {
		<span>{ tb.DeletedBy }</span>
	} else {
		<span class={ metadataTextClass }>{ p.label(labelTombstoneNotRecorded) }</span>
	}
}
