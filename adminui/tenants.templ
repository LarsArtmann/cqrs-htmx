package adminui

import (
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/forms"
	"github.com/larsartmann/templ-components/utils"
)

templ tenantsPage(p pageData, d tenantsListData) {
	@Layout(p) {
		@tenantsContent(d)
	}
}

templ tenantsContent(d tenantsListData) {
	<div class="mb-5 flex flex-wrap items-center gap-3">
		<h1 class="text-xl font-semibold">Tenants</h1>
		<div class="flex-1"></div>
		@display.Button(display.ButtonProps{
			Text:      "New tenant",
			Href:      d.BasePath + "/tenants/new",
			Variant:   display.ButtonPrimary,
			Size:      display.ButtonSizeSM,
			Icon:      icon("plus"),
			BaseProps: utils.BaseProps{Class: "no-underline"},
		})
	</div>
	<div class="rounded-[10px] border border-gray-200 shadow-sm" style="background:var(--surface)">
		@tenantsTable(d)
	</div>
}

templ tenantsTable(d tenantsListData) {
	if len(d.Tenants) == 0 {
		@empty("tenants", "No tenants yet", "Create a tenant to scope roles and memberships.")
	} else {
		<div class="overflow-x-auto">
			<table class="w-full text-sm">
				<thead><tr><th class="px-4 py-2 text-left font-semibold text-gray-500">Name</th><th class="px-4 py-2 text-left font-semibold text-gray-500">Status</th><th></th></tr></thead>
				<tbody>
					for _, t := range d.Tenants {
						<tr class="border-t border-gray-200 hover:bg-gray-50">
							<td class="px-4 py-2">
								<a class="flex flex-col no-underline" href={ d.BasePath + "/tenants/" + t.ID.Get() }>
									<span class="font-medium text-gray-900">{ t.DisplayName }</span>
									<span class="font-mono text-xs text-gray-400">{ t.Name }</span>
								</a>
							</td>
							<td class="px-4 py-2">
								if t.Suspended {
									@badge("suspended", "amber")
								} else if t.Deleted {
									@badge("deleted", "red")
								} else {
									@badge("active", "green")
								}
							</td>
							<td class="px-4 py-2 text-right">
								<a class="rounded-md px-2.5 py-1 text-sm text-gray-600 no-underline hover:bg-gray-100" href={ d.BasePath + "/tenants/" + t.ID.Get() }>Manage</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		@listNote(len(d.Tenants), d.Total)
	}
}

templ tenantNewPage(p pageData, basePath string) {
	@Layout(p) {
		<div class="mb-5 flex flex-wrap items-center gap-3">
			<a class="rounded-md px-2.5 py-1 text-sm text-gray-600 no-underline hover:bg-gray-100" href={ basePath + "/tenants" }>← Tenants</a>
		</div>
		<h1 class="mb-4 text-xl font-semibold">New tenant</h1>
		<div class="max-w-[520px] rounded-[10px] border border-gray-200 shadow-sm" style="background:var(--surface)">
			<div class="p-[18px]">
				<form hx-post={ basePath + "/tenants" } hx-target="this">
					<div class="mb-4">
						@forms.Input(forms.InputProps{
							BaseProps:   utils.BaseProps{ID: "name"},
							Name:        "name",
							Placeholder: "acme-corp",
							Required:    true,
							HelpText:    "A unique, URL-safe identifier.",
						})
					</div>
					<div class="mb-4">
						@forms.Input(forms.InputProps{
							BaseProps:   utils.BaseProps{ID: "display_name"},
							Name:        "display_name",
							Placeholder: "Acme Corporation",
						})
					</div>
					<div class="flex gap-2.5">
						@display.Button(display.ButtonProps{Text: "Create tenant", Type: display.ButtonHTMLSubmit, Variant: display.ButtonPrimary})
						@display.Button(display.ButtonProps{Text: "Cancel", Href: basePath + "/tenants", Variant: display.ButtonSecondary, BaseProps: utils.BaseProps{Class: "no-underline"}})
					</div>
				</form>
			</div>
		</div>
	}
}

templ tenantDetailPage(p pageData, d tenantDetailData) {
	@Layout(p) {
		<div class="mb-5 flex flex-wrap items-center gap-3">
			<a class="rounded-md px-2.5 py-1 text-sm text-gray-600 no-underline hover:bg-gray-100" href={ d.BasePath + "/tenants" }>← Tenants</a>
			<div class="flex-1"></div>
			if d.Tenant.Suspended {
				@badge("suspended", "amber")
			} else if d.Tenant.Deleted {
				@badge("deleted", "red")
			} else {
				@badge("active", "green")
			}
		</div>
		<h1 class="mb-1 text-xl font-semibold">{ d.Tenant.DisplayName }</h1>
		<div class="mb-5 font-mono text-xs text-gray-400">{ d.Tenant.Name }</div>
		<div class="mb-4">
			@membersCard(d)
		</div>
		<div class="rounded-[10px] border border-gray-200 shadow-sm" style="background:var(--surface)">
			<div class="flex items-center gap-2.5 border-b border-gray-200 px-[18px] py-[15px]"><span class="text-[15px] text-red-600">Danger zone</span></div>
			<div class="flex flex-wrap gap-2.5 p-[18px]">
				if d.Tenant.Suspended {
					@display.Button(display.ButtonProps{
						Text:    "Reactivate",
						Variant: display.ButtonPrimary,
						Size:    display.ButtonSizeSM,
						BaseProps: utils.BaseProps{Attrs: templ.Attributes{
							"hx-post":    d.BasePath + "/tenants/" + d.Tenant.ID.Get() + "/reactivate",
							"hx-confirm": "Reactivate this tenant?",
						}},
					})
				} else {
					@display.Button(display.ButtonProps{
						Text:    "Suspend",
						Variant: display.ButtonSecondary,
						Size:    display.ButtonSizeSM,
						BaseProps: utils.BaseProps{Attrs: templ.Attributes{
							"hx-post":    d.BasePath + "/tenants/" + d.Tenant.ID.Get() + "/suspend",
							"hx-confirm": "Suspend this tenant?",
						}},
					})
				}
				@display.Button(display.ButtonProps{
					Text:    "Delete",
					Variant: display.ButtonDanger,
					Size:    display.ButtonSizeSM,
					Icon:    icon("trash"),
					BaseProps: utils.BaseProps{Attrs: templ.Attributes{
						"hx-post":      d.BasePath + "/tenants/" + d.Tenant.ID.Get() + "/delete",
						"data-confirm": "Delete this tenant and remove all memberships? This cannot be undone.",
					}},
				})
			</div>
		</div>
	}
}
