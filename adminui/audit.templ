package adminui

templ auditPage(p pageData, d auditData) {
	@Layout(p) {
		<div class="mb-5 flex flex-wrap items-center gap-3">
			<h1 class="text-xl font-semibold">Audit log</h1>
		</div>
		<div class="rounded-[10px] border border-gray-200 shadow-sm" style="background:var(--surface)">
			if len(d.Entries) == 0 {
				@empty("audit", "No audit events", "User and tenant changes will be recorded here.")
			} else {
				<div class="overflow-x-auto">
					<table class="w-full text-sm">
						<thead><tr><th class="px-4 py-2 text-left font-semibold text-gray-500">Action</th><th class="px-4 py-2 text-left font-semibold text-gray-500">Who</th><th class="px-4 py-2 text-left font-semibold text-gray-500">Aggregate</th><th class="px-4 py-2 text-left font-semibold text-gray-500">When</th></tr></thead>
						<tbody>
							for _, e := range d.Entries {
								<tr class="border-t border-gray-200 hover:bg-gray-50">
									<td class="px-4 py-2"><span class="inline-block rounded-full px-2 py-0.5 text-xs font-medium text-white" style="background:var(--accent)">{ e.Action }</span></td>
									<td class="px-4 py-2">
										if e.Email != "" {
											<span class="font-medium">{ e.Email }</span>
										} else {
											<span class="text-gray-400">—</span>
										}
									</td>
									<td class="px-4 py-2 font-mono text-xs">{ e.AggregateID.String() }</td>
									<td class="px-4 py-2 text-gray-500">{ relTime(e.OccurredAt) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
