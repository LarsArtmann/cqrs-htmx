package adminui

import "github.com/larsartmann/templ-components/display"

templ auditPage(p pageData, d auditData) {
	@Layout(p) {
		<div class="mb-5 flex flex-wrap items-center gap-3">
			<h1 class="text-xl font-semibold">Audit log</h1>
		</div>
		if len(d.Entries) == 0 {
			@display.Card(display.CardProps{Padding: display.CardPaddingNone}) {
				@empty("audit", "No audit events", "User and tenant changes will be recorded here.")
			}
		} else {
			@display.Card(display.CardProps{Padding: display.CardPaddingNone}) {
				@display.Table(display.TableProps{
					Headers: []string{"Action", "Who", "Aggregate", "When"},
					Hover:   true,
					Body:    auditRows(d),
				})
			}
		}
	}
}

templ auditRows(d auditData) {
	for _, e := range d.Entries {
		<tr>
			<td class="px-4 py-3">
				@badge(e.Action, "accent")
			</td>
			<td class="px-4 py-3">
				if e.Email != "" {
					<span class="font-medium">{ e.Email }</span>
				} else {
					<span class="text-gray-400">—</span>
				}
			</td>
			<td class="px-4 py-3 font-mono text-xs">{ e.AggregateID.String() }</td>
			<td class="px-4 py-3 text-gray-500">
				@display.RelativeTime(display.RelativeTimeProps{Time: e.OccurredAt})
			</td>
		</tr>
	}
}
