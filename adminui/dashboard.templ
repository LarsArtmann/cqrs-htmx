package adminui

import (
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/htmx"
)

templ dashboardPage(p pageData, d dashboardData) {
	@Layout(p, dashboardContent(d))
}

templ dashboardContent(d dashboardData) {
	@dashboardStatsRegion(d)
	if len(d.Recent) == 0 {
		@display.Card(display.CardProps{Title: "Recent activity", Padding: display.CardPaddingNone}) {
			@empty("audit", "No activity yet", "User and tenant events will appear here.", "", "")
		}
	} else {
		@display.Card(display.CardProps{
			Title:   "Recent activity",
			Padding: display.CardPaddingNone,
		}) {
			@display.Table(display.TableProps{
				Headers:     []string{"Action", "Who", "When"},
				Hover:       true,
				Body:        recentActivityRows(d),
				Flush:       true,
				CellPadding: display.TableCellPaddingCompact,
			})
		}
	}
}

// dashboardStatsRegion is the polled stats block shared by the dashboard
// page and the /partials/stats endpoint. PolledRegion swaps itself
// (outerHTML), so the partial response must render the region — polling
// would stop after the first refresh if it returned bare children.
//
// ADR-lite (poll vs SSE): stats refresh via 30s HTMX polling, NOT the SSE
// feed. The SSE channel (when configured) is a control plane — sync-state
// signaling for the header sync-bar and the offline sync queue — and never
// carries stat payloads. Stats are cheap read-model count queries; polling
// keeps them fresh for every viewer with zero fan-out state and no per-page
// SSE payload contract. The two mechanisms do not overlap.
templ dashboardStatsRegion(d dashboardData) {
	@htmx.PolledRegion(htmx.PolledRegionProps{
		URL:           d.StatsURL,
		Every:         "30s",
		ShowTimestamp: true,
	}) {
		@display.Grid(display.GridProps{
			Cols:        display.GridColsAutoFit,
			MinColWidth: "190px",
			Gap:         display.GridGapMD,
		}) {
			for _, s := range d.Stats {
				@statCardView(s)
			}
		}
	}
}

templ recentActivityRows(d dashboardData) {
	for _, e := range d.Recent {
		<tr>
			<td class="px-4 py-2">
				@badge(e.Action, "accent")
			</td>
			<td class="px-4 py-2">
				if e.Email != "" {
					<span class="font-medium">{ e.Email }</span>
				} else {
					<span class="font-mono text-xs">{ e.AggregateID.String() }</span>
				}
			</td>
			<td class="px-4 py-2 text-gray-500">
				@display.RelativeTime(display.RelativeTimeProps{Time: e.OccurredAt})
			</td>
		</tr>
	}
}
