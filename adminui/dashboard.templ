package adminui

import (
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/htmx"
	"github.com/larsartmann/templ-components/utils"
)

templ dashboardPage(p pageData, d dashboardData, superAdmin bool) {
	@Layout(p, dashboardContent(p, d, superAdmin))
}

templ dashboardContent(p pageData, d dashboardData, superAdmin bool) {
	if d.NoAdminGrant {
		<div class="mb-4 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-700 dark:bg-amber-900/20 dark:text-amber-300">
			<strong>{ p.label(labelBannerNoAdminGrant) }</strong> { p.label(labelBannerNoAdminBody) }
		</div>
	} else if d.BusFactor {
		@busFactorBanner()
	}
	@dashboardStatsRegion(p, d, superAdmin)
	if len(d.Recent) == 0 {
		@display.Card(display.CardProps{Title: p.label(labelCardRecentActivity), Padding: display.CardPaddingNone}) {
			@empty("audit", p.label(labelEmptyActivityTitle), p.label(labelEmptyActivityHint), "", "")
		}
	} else {
		@display.Card(display.CardProps{
			Title:   p.label(labelCardRecentActivity),
			Padding: display.CardPaddingNone,
		}) {
			@display.Table(display.TableProps{
				Headers:     []string{p.label(labelHeaderAction), p.label(labelHeaderWho), p.label(labelHeaderWhen)},
				Hover:       true,
				Body:        recentActivityRows(d),
				Flush:       true,
				CellPadding: display.TableCellPaddingCompact,
			})
		}
	}
}

// dashboardStatsRegion is the polled stats block shared by the dashboard
// page and the /partials/stats endpoint. PolledRegion swaps itself
// (outerHTML), so the partial response must render the region — polling
// would stop after the first refresh if it returned bare children.
//
// ADR-lite (poll vs SSE): stats refresh via 30s HTMX polling, NOT the SSE
// feed. The SSE channel (when configured) is a control plane — sync-state
// signaling for the header sync-bar and the offline sync queue — and never
// carries stat payloads. Stats are cheap read-model count queries; polling
// keeps them fresh for every viewer with zero fan-out state and no per-page
// SSE payload contract. The two mechanisms do not overlap.
//
// The quick-actions row renders INSIDE the region: the polled response is the
// region itself, so a row outside it would vanish on the first refresh, and a
// row rendered both inside and outside would duplicate on the page.
templ dashboardStatsRegion(p pageData, d dashboardData, superAdmin bool) {
	@htmx.PolledRegion(htmx.PolledRegionProps{
		URL:           d.StatsURL,
		Every:         "30s",
		ShowTimestamp: true,
	}) {
		@quickActionsRow(p, d, superAdmin)
		@dashboardWindowCaption(d)
		@display.Grid(display.GridProps{
			Cols:        display.GridColsAutoFit,
			MinColWidth: "190px",
			Gap:         display.GridGapMD,
		}) {
			for _, s := range d.Stats {
				@statCardView(s)
			}
			@registrationsSparkCard(p, d.Registrations, d.WindowSpan)
		}
	}
}

// busFactorBanner is the single-operator risk variant of the amber chrome:
// when exactly ONE user holds every admin-tier wildcard grant, one departure
// or lost credential locks the platform out. It renders only when the zero
// case (NoAdminGrant) does not — zero is the bigger emergency and gets the
// stronger message alone.
templ busFactorBanner() {
	<div class="mb-4 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-700 dark:bg-amber-900/20 dark:text-amber-300">
		<strong>Bus factor of one.</strong> Exactly one user holds every admin-tier
		grant in the global domain. Grant a second platform admin from a user's
		detail page so a single departure cannot lock the platform out.
	</div>
}

// dashboardWindowCaption is the honesty caption under the stat grid: what the
// in-memory window holds and the exact span every derived number covers. It
// renders from the projection's own facts (same pattern as the audit page's
// retention caption), so it cannot drift from the data the cards read. An
// empty window renders no caption — there is nothing true to say about dates.
templ dashboardWindowCaption(d dashboardData) {
	if text := dashboardWindowCaptionText(d); text != "" {
		<p class={ "mb-2 text-xs " + metadataTextXSClass }>{ text }</p>
	}
}

// registrationsSparkCard is the 14-day registrations sparkline. An empty
// window renders the honest dash state — no polyline pretending a flat
// forever, no fabricated zero-day story; just a statement that nothing has
// been recorded yet.
templ registrationsSparkCard(p pageData, points []dayCount, span auditWindowSpan) {
	@display.Card(display.CardProps{Title: "Registrations per day", Padding: display.CardPaddingSM}) {
		if len(points) == 0 || !span.HasSpan {
			<p class={ "text-xs " + metadataTextXSClass }>{ p.label(labelSparkNoRegistrars) }</p>
		} else {
			<svg
				viewBox="0 0 140 40"
				class="h-10 w-full text-blue-600 dark:text-blue-400"
				role="img"
				aria-label={ sparklineAriaLabel(p.Labels, points) }
				preserveAspectRatio="none"
			>
				<polyline fill="none" stroke="currentColor" stroke-width="2" points={ sparklinePoints(points) }></polyline>
			</svg>
			<p class={ "mt-2 text-xs " + metadataTextXSClass }>{ sparklineAriaLabel(p.Labels, points) }</p>
		}
	}
}

// quickActionsRow is the dashboard's create entry points, linking to the
// existing /users/new and /tenants/new forms — the same destination as the
// lists' "New user"/"New tenant" header buttons, one click closer to hand.
// superAdmin gates the row: both creation routes are super-admin table rows,
// so tenant-admin mode renders NOTHING rather than a control whose target
// page does not exist in that mode.
templ quickActionsRow(p pageData, d dashboardData, superAdmin bool) {
	if superAdmin {
		<div class="mb-4 flex items-center gap-3">
			@display.Button(display.ButtonProps{
				Text:      p.label(labelActionCreateUser),
				Href:      d.BasePath + "/users/new",
				Variant:   display.ButtonPrimary,
				Size:      display.ButtonSizeSM,
				Icon:      icon("plus"),
				BaseProps: utils.BaseProps{Class: classNoUnderline},
			})
			@display.Button(display.ButtonProps{
				Text:      p.label(labelActionCreateTenant),
				Href:      d.BasePath + "/tenants/new",
				Variant:   display.ButtonSecondary,
				Size:      display.ButtonSizeSM,
				Icon:      icon("plus"),
				BaseProps: utils.BaseProps{Class: classNoUnderline},
			})
		</div>
	}
}

templ recentActivityRows(d dashboardData) {
	for _, e := range d.Recent {
		<tr>
			<td class="px-4 py-2">
				@badge(auditLabel(e.Action), auditActionBadge(e.Action))
			</td>
			<td class="px-4 py-2">
				if e.Email != "" && e.AggregateID.Get() != "" {
					<a class="font-medium no-underline hover:underline" href={ d.BasePath + "/users/" + e.AggregateID.Get() }>{ e.Email }</a>
				} else if e.Email != "" {
					<span class="font-medium">{ e.Email }</span>
				} else {
					<span class="font-mono text-xs">{ e.AggregateID.Get() }</span>
				}
			</td>
			<td class="px-4 py-2 text-gray-500">
				@display.RelativeTime(display.RelativeTimeProps{Time: e.OccurredAt})
			</td>
		</tr>
	}
}
