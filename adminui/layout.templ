package adminui

templ Layout(p pageData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="robots" content="noindex"/>
			if p.CSRFMeta != "" {
				@templ.Raw(p.CSRFMeta)
			}
			<title>{ p.Title } · { p.Brand }</title>
			<style>:root&#123;--accent:{ p.Accent };&#125;</style>
			<link rel="stylesheet" href={ p.BasePath + "/-/admin-tw.css" }/>
			<script src={ p.BasePath + "/-/htmx.js" }></script>
		</head>
		<body
			if p.SSEURL != "" {
				data-sse-url={ p.SSEURL }
			}
		>
			<div class="grid min-h-screen grid-cols-[248px_1fr] max-md:grid-cols-1">
				<aside
					class="admin-sidebar sticky top-0 flex h-screen flex-col gap-1.5 p-[18px_14px] text-gray-400 max-md:fixed max-md:inset-y-0 max-md:left-0 max-md:z-50 max-md:w-64 max-md:-translate-x-full max-md:transition-transform [&.open]:translate-x-0"
					style="background:var(--sidebar-bg)"
				>
					<div class="flex items-center gap-2.5 pt-1.5 pb-4 px-2.5 text-base font-bold text-gray-100">
						<span class="grid h-[26px] w-[26px] place-items-center rounded-lg text-sm font-extrabold text-white" style="background:var(--accent)">{ initials(p.Brand) }</span>
						{ p.Brand }
					</div>
					<nav class="flex flex-col gap-0.5">
						for _, item := range p.Nav {
							<a
								href={ p.BasePath + item.Href }
								class={ "flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium no-underline hover:text-gray-100 hover:bg-white/[0.07]", templ.KV("text-white", item.Active) }
								style={ templ.SafeCSS("background:" + navBg(item.Active)) }
							>
								<span class="h-[18px] w-[18px] shrink-0 opacity-90">@icon(item.Icon)</span>
								{ item.Label }
							</a>
						}
					</nav>
					<div class="mt-auto px-1.5 pt-0.5 text-xs opacity-55">cqrs-htmx admin</div>
				</aside>
				<div class="flex min-w-0 flex-col">
					<header
						class="sticky top-0 z-[5] flex items-center gap-3.5 border-b border-gray-200 px-6 py-3.5 backdrop-blur"
						style="background:color-mix(in srgb, var(--surface) 86%, transparent)"
					>
						<button
							class="admin-toggle hidden max-md:block"
							aria-label="Menu"
						>@icon("menu")</button>
						<div class="text-[17px]">{ p.Title }</div>
						<div class="flex-1"></div>
						if p.SSEURL != "" {
							<div class="sync-bar" data-sync-status="idle">
								<span class="sync-dot"></span>
								Synced
							</div>
						}
						if p.User != nil {
							<div class="flex items-center gap-2 font-medium text-gray-500">
								<span class="grid h-7 w-7 place-items-center rounded-full text-xs font-semibold text-white" style="background:var(--accent)">{ initials(p.User.Email) }</span>
								{ p.User.Email }
							</div>
							if p.LogoutURL != "" {
								<a
									class="inline-flex items-center gap-1 rounded-md px-2.5 py-1.5 text-sm text-gray-600 no-underline hover:bg-gray-100 hover:text-gray-900"
									href={ p.LogoutURL }
								>@icon("arrow-right-on-rectangle") Sign out</a>
							}
						}
					</header>
					<main class="w-full max-w-[1200px] p-6">
						{ children... }
					</main>
				</div>
			</div>
			<div
				class="admin-scrim fixed inset-0 z-40 hidden bg-black/40 max-md:block"
			></div>
			@toastHost()
			<script src={ p.BasePath + "/-/admin.js" }></script>
		</body>
	</html>
}
