package adminui

import (
	"strings"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/htmx"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/layout"
	"github.com/larsartmann/templ-components/navigation"
	"github.com/larsartmann/templ-components/utils"
)

templ Layout(p pageData, content templ.Component) {
	@layout.Base(layout.PageProps{
		Title:         p.Title + " · " + p.Brand,
		CSSPath:       p.BasePath + "/-/admin-tw.css",
		HTMXSrc:       p.BasePath + "/-/htmx.js",
		Nonce:         p.Nonce,
		SEO:           layout.SEOMeta{NoIndex: true},
		BodyDataAttrs: sseBodyAttrs(p.SSEURL),
		HeadContent:   headExtras(p),
		Footer:        pageFoot(p),
	}) {
		@layout.AppShell(layout.AppShellProps{
			BaseProps:       utils.BaseProps{Class: "admin-shell"},
			Sidebar:         sidebar(p),
			MobileNav:      mobileNav(p),
			Header:         topBar(p),
			Content:          content,
			Container:        true,
			SidebarWidth:     layout.SidebarWidthMD,
			ContainerWidth:   layout.ContainerWidthXL,
		})
	}
}

templ headExtras(p pageData) {
	if p.CSRFMeta != "" {
		@templ.Raw(p.CSRFMeta)
	}
	@templ.Raw(accentStyleTag(p))
}

templ sidebar(p pageData) {
	@navigation.SidebarNav(navigation.SidebarNavProps{
		BaseProps: utils.BaseProps{Class: "admin-sidebar-scope", AriaLabel: "Admin sections"},
		Brand:     brandMark(p),
		Items:     sidebarItems(p),
		Footer:    sidebarFooter(),
	})
}

templ brandMark(p pageData) {
	<span class="flex items-center gap-2.5">
		<span class="admin-accent-bg grid h-[26px] w-[26px] place-items-center rounded-lg text-sm font-extrabold text-white">{ initials(p.Brand) }</span>
		<span class="text-base font-bold text-white">{ p.Brand }</span>
	</span>
}

templ sidebarFooter() {
	<span class="text-xs text-gray-400">cqrs-htmx admin</span>
}

// userMenuTrigger is the custom DropdownProps.Trigger content for the header
// identity menu (templ-components v1.19.0): the functionally wired trigger
// button keeps popovertarget/aria; this component owns the visuals.
templ userMenuTrigger(email string) {
	<span class="flex items-center gap-2 rounded-md px-1 py-1 font-medium text-gray-500 hover:text-gray-700">
		@display.Avatar(display.AvatarProps{Initials: initials(email), Size: display.AvatarSizeSM})
		<span class="hidden text-sm sm:inline">{ email }</span>
	</span>
}

templ topBar(p pageData) {
	<div class="flex items-center justify-between gap-3.5 px-6 py-3.5">
		<div class="flex items-center gap-3.5">
			<button
				class="admin-toggle hidden max-lg:block"
				aria-label="Menu"
			>
				@icon("menu")
			</button>
			<div class="text-[17px]">{ p.Title }</div>
		</div>
		<div class="flex items-center gap-3.5">
			if p.SSEURL != "" {
				<div class="sync-bar" data-sync-status="idle">
					<span class="sync-dot"></span>
					Synced
				</div>
			}
			if p.User != nil {
				// Desktop: library Dropdown (native Popover API — click-toggle,
				// light-dismiss, Esc, top layer; positioner + keyboard-nav scripts
				// ship with the component, only the animation CSS is vendored in
				// tailwind.css). Since templ-components v1.19.0 the avatar + email
				// identity cluster rides INSIDE the trigger via DropdownProps.Trigger
				// (functionally wired button, consumer-owned visuals).
				if p.LogoutURL != "" {
					<div class="flex items-center gap-2 font-medium text-gray-500">
						@display.Avatar(display.AvatarProps{
							Initials: initials(p.User.Email),
							Size:     display.AvatarSizeSM,
							BaseProps: utils.BaseProps{
								Class: "lg:hidden",
							},
						})
						<div class="hidden lg:block">
							@display.Dropdown(display.DropdownProps{
								Label:    p.User.Email,
								Trigger:  userMenuTrigger(p.User.Email),
								Position: display.DropdownPositionRight,
								BaseProps: utils.BaseProps{
									ID: "admin-user-menu",
								},
								Items: []display.DropdownItem{
									{
										Text: "Sign out",
										Href: p.LogoutURL,
										Icon: icons.ArrowRightOnRectangle,
										Kind: display.DropdownItemLink,
									},
								},
							})
						</div>
						<a
							class="lg:hidden inline-flex items-center gap-1 rounded-md px-2.5 py-1.5 text-sm text-gray-600 no-underline hover:bg-gray-100 hover:text-gray-900"
							href={ p.LogoutURL }
						>
							@icon("arrow-right-on-rectangle")
							Sign out
						</a>
					</div>
				} else {
					<div class="flex items-center gap-2 font-medium text-gray-500">
						@display.Avatar(display.AvatarProps{Initials: initials(p.User.Email), Size: display.AvatarSizeSM})
						{ p.User.Email }
					</div>
				}
			}
		</div>
	</div>
}

templ mobileNav(p pageData) {
	<div class="admin-sidebar fixed inset-y-0 left-0 z-50 w-64 -translate-x-full transition-transform duration-200 lg:hidden [&.open]:translate-x-0">
		@sidebar(p)
	</div>
	<div class="admin-scrim fixed inset-0 z-40 hidden bg-black/40 lg:hidden [&.open]:block"></div>
}

templ pageFoot(p pageData) {
	@toastHost(p.Nonce)
	@htmx.GlobalErrorHandling(htmx.ErrorHandlingConfig{Nonce: p.Nonce})
	// Shared confirm dialog for destructive actions (filled dynamically by
	// admin.js from data-confirm/data-confirm-title on the triggering button).
	@confirmModal(p.Nonce)
	if p.SSEURL != "" {
		// sync-client.js must load before admin.js: it registers htmx:beforeRequest
		// and htmx:sendError listeners that admin.js's CSRF config depends on being
		// in place. Both scripts run synchronously, so load order is deterministic.
		<script src={ p.BasePath + "/-/sync-client.js" }></script>
	}
	<script src={ p.BasePath + "/-/admin.js" }></script>
}

func sidebarItems(p pageData) []navigation.SidebarNavItem {
	items := make([]navigation.SidebarNavItem, 0, len(p.Nav))
	for _, n := range p.Nav {
		items = append(items, navigation.SidebarNavItem{
			Label:  n.Label,
			Href:   p.BasePath + n.Href,
			Icon:   icons.Name(n.Icon),
			Active: n.Active,
		})
	}
	return items
}

func sseBodyAttrs(sseURL string) templ.Attributes {
	if sseURL == "" {
		return nil
	}
	return templ.Attributes{"data-sse-url": sseURL}
}

func accentStyleTag(p pageData) string {
	nonce := strings.ReplaceAll(p.Nonce, `"`, "")
	nonceAttr := ""
	if nonce != "" {
		nonceAttr = ` nonce="` + nonce + `"`
	}
	return `<style` + nonceAttr + `>:root{--accent:` + p.Accent + `}</style>`
}
