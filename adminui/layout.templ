package adminui

import (
	"strings"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/htmx"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/layout"
	"github.com/larsartmann/templ-components/navigation"
	"github.com/larsartmann/templ-components/utils"
)

templ Layout(p pageData, content templ.Component) {
	@layout.Base(layout.PageProps{
		Title:         p.Title + " · " + p.Brand,
		CSSPath:       p.BasePath + "/-/admin-tw.css",
		HTMXSrc:       p.BasePath + "/-/htmx.js",
		Nonce:         p.Nonce,
		SEO:           layout.SEOMeta{NoIndex: true},
		HTMLDataAttrs: htmlLangAttrs(p),
		BodyDataAttrs: sseBodyAttrs(p.SSEURL),
		HeadContent:   headExtras(p),
		Footer:        pageFoot(p),
	}) {
		// T25 F186: skip-to-content link (first Tab stop, visible on focus)
		// and the focusable anchor it targets, ahead of the app shell.
		<a href="#admin-content" class="admin-skip-link">{ p.label(labelChromeSkip) }</a>
		<span id="admin-content" tabindex="-1"></span>
		@layout.AppShell(layout.AppShellProps{
			BaseProps:      utils.BaseProps{Class: "admin-shell"},
			Sidebar:        sidebar(p),
			MobileNav:      mobileNav(p),
			Header:         topBar(p),
			Content:        content,
			Container:      true,
			SidebarWidth:   layout.SidebarWidthMD,
			ContainerWidth: layout.ContainerWidthXL,
		})
	}
}

templ headExtras(p pageData) {
	if p.CSRFMeta != "" {
		@templ.Raw(p.CSRFMeta)
	}
	// T25 F181: the panel's favicon (inline-SVG asset, served from the same
	// embedded asset set as the CSS/JS) and the theme-color metas — the two
	// colors are the panel's own surface tokens (--bg light/dark), so the
	// browser chrome follows the panel in either scheme.
	<link rel="icon" type="image/svg+xml" href={ p.BasePath + "/-/favicon.svg" }/>
	<meta name="theme-color" content="#f6f7f9" media="(prefers-color-scheme: light)"/>
	<meta name="theme-color" content="#0b1120" media="(prefers-color-scheme: dark)"/>
	// htmx injects its default indicator stylesheet at DOMContentLoaded
	// unless includeIndicatorStyles is false; the injected <style> carries
	// no nonce, so under a nonce CSP (e.g. the setup bundle's) the browser
	// blocks it with a console error per page load. The admin panel ships
	// its own indicator CSS (admin-tw.css), so the default is redundant —
	// turn it off. htmx reads this meta at DOMContentLoaded, so this
	// placement (after the script tag, still in head) is early enough.
	<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
	// Pre-paint theme resolution (see the @custom-variant dark note in
	// tailwind.css): reads localStorage 'theme', falls back to the system
	// preference, and applies .dark + color-scheme before first paint.
	@layout.ThemeScript(p.Nonce)
	@templ.Raw(accentStyleTag(p))
	// The cqrs-query htmx extension upgrades this panel's search to the
	// native HTTP QUERY method (RFC 10008) and downgrades to POST +
	// method-override only when an intermediary refuses the verb. Plain
	// synchronous script AFTER the htmx tag: defineExtension needs the htmx
	// global, and HeadContent renders after the HTMXSrc script tag.
	<script src={ p.BasePath + "/-/ext/cqrs-query.js" }></script>
}

templ sidebar(p pageData) {
	@navigation.SidebarNav(navigation.SidebarNavProps{
		BaseProps: utils.BaseProps{Class: "admin-sidebar-scope", AriaLabel: p.label(labelChromeSections)},
		Brand:     brandMark(p),
		Items:     sidebarItems(p),
		Footer:    sidebarFooter(p),
	})
}

templ brandMark(p pageData) {
	<span class="flex items-center gap-2.5">
		<span class="admin-accent-bg grid h-[26px] w-[26px] place-items-center rounded-lg text-sm font-extrabold text-white">{ initials(p.Brand) }</span>
		<span class="text-base font-bold text-white">{ p.Brand }</span>
	</span>
}

templ sidebarFooter(p pageData) {
	if p.ReadOnly {
		// Read-only notice chip: the panel is mounted without its write
		// routes ([Config.ReadOnly]), so the chrome must not imply the
		// creation/deletion forms it still renders are live.
		<span class="admin-readonly-chip inline-flex items-center gap-1 rounded-full border border-amber-300 bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-300">
			{ p.label(labelChromeReadOnly) }
		</span>
	}
	<span class="text-xs text-gray-600 dark:text-gray-400">{ p.label(labelChromeFooter) }</span>
}

// tenantSwitchTrigger is the switcher's trigger visuals; the functional
// button wiring (popovertarget/aria/keyboard) ships with the Dropdown
// component. The label names the tenant being viewed when there is one.
templ tenantSwitchTrigger(p pageData) {
	<span class="flex items-center gap-1.5 rounded-md px-2 py-1 font-medium text-gray-500 hover:text-gray-700">
		@icon(iconTenants)
		<span class="hidden text-sm md:inline">
			if p.CurrentTenantID != "" {
				{ tenantSwitchCurrentName(p) }
			} else {
				{ p.label(labelNavTenants) }
			}
		</span>
	</span>
}

// userMenuTrigger is the custom DropdownProps.Trigger content for the header
// identity menu (templ-components v1.19.0): the functionally wired trigger
// button keeps popovertarget/aria; this component owns the visuals.
templ userMenuTrigger(email string) {
	<span class="flex items-center gap-2 rounded-md px-1 py-1 font-medium text-gray-500 hover:text-gray-700">
		@display.Avatar(display.AvatarProps{Initials: initials(email), Size: display.AvatarSizeSM})
		<span class="hidden text-sm sm:inline">{ email }</span>
	</span>
}

templ topBar(p pageData) {
	<div class="flex items-center justify-between gap-3.5 px-6 py-3.5">
		<div class="flex items-center gap-3.5">
			<button
				class="admin-toggle hidden max-lg:block"
				aria-label={ p.label(labelChromeMenu) }
			>
				@icon("menu")
			</button>
			<div class="text-[17px]">{ p.Title }</div>
		</div>
		<div class="flex items-center gap-3.5">
			if len(p.TenantSwitcher) > 0 {
				// Tenant switcher (super-admin mode only — page() leaves the list
				// empty in ModeTenantAdmin): one click moves between tenants.
				// Same library Dropdown as the user menu: native Popover API,
				// light-dismiss, keyboard-nav scripts ship with the component.
				<div class="hidden lg:block">
					@display.Dropdown(display.DropdownProps{
						// Label doubles as the trigger's aria-label: it must match
						// the visible trigger text, which names the CURRENT tenant
						// on detail pages (WCAG 2.5.3 Label in Name; axe flagged
						// the static "Tenants" label against the tenant name the
						// trigger renders there — first adminui a11y sweep
						// 2026-11-14).
						Label:    tenantSwitchCurrentName(p),
						Trigger:  tenantSwitchTrigger(p),
						Position: display.DropdownPositionLeft,
						BaseProps: utils.BaseProps{
							ID:    "admin-tenant-switcher",
							Nonce: p.Nonce,
						},
						Items: tenantSwitchItems(p),
					})
				</div>
			}
			@layout.ThemeToggle(p.label(labelChromeTheme), p.Nonce)
			if p.SSEURL != "" {
				<div class="sync-bar" data-sync-status="idle">
					<span class="sync-dot"></span>
					{ p.label(labelChromeSynced) }
				</div>
			}
			if p.User != nil {
				// Desktop: library Dropdown (native Popover API — click-toggle,
				// light-dismiss, Esc, top layer; positioner + keyboard-nav scripts
				// ship with the component, only the animation CSS is vendored in
				// tailwind.css). Since templ-components v1.19.0 the avatar + email
				// identity cluster rides INSIDE the trigger via DropdownProps.Trigger
				// (functionally wired button, consumer-owned visuals).
				if p.LogoutURL != "" {
					<div class="flex items-center gap-2 font-medium text-gray-500">
						@display.Avatar(display.AvatarProps{
							Initials: initials(p.User.Email),
							Size:     display.AvatarSizeSM,
							BaseProps: utils.BaseProps{
								Class: "lg:hidden",
							},
						})
					<div class="hidden lg:block">
						@display.Dropdown(display.DropdownProps{
							// Label doubles as the trigger button's aria-label, and
							// WCAG 2.5.3 Label in Name requires it to contain the
							// FULL visible text: an email-only label failed axe's
							// label-content-name-mismatch (it omits the avatar
							// initials rendered next to it), and an empty one fails
							// too (nothing to match). Name it initials + email —
							// exactly what sighted users see (first adminui a11y
							// sweep, 2026-11-14).
							Label:    initials(p.User.Email) + " " + p.User.Email,
							Trigger:  userMenuTrigger(p.User.Email),
							Position: display.DropdownPositionRight,
							BaseProps: utils.BaseProps{
								ID:    "admin-user-menu",
								Nonce: p.Nonce,
							},
							Items: []display.DropdownItem{
								{
									Text: p.label(labelChromeSignOut),
										Href: p.LogoutURL,
										Icon: icons.ArrowRightOnRectangle,
										Kind: display.DropdownItemLink,
									},
								},
							})
						</div>
						<a
							class="lg:hidden inline-flex items-center gap-1 rounded-md px-2.5 py-1.5 text-sm text-gray-600 no-underline hover:bg-gray-100 hover:text-gray-900"
							href={ p.LogoutURL }
						>
							@icon("arrow-right-on-rectangle")
							{ p.label(labelChromeSignOut) }
						</a>
					</div>
				} else {
					<div class="flex items-center gap-2 font-medium text-gray-500">
						@display.Avatar(display.AvatarProps{Initials: initials(p.User.Email), Size: display.AvatarSizeSM})
						{ p.User.Email }
					</div>
				}
			}
		</div>
	</div>
}

templ mobileNav(p pageData) {
	<div class="admin-sidebar fixed inset-y-0 left-0 z-50 w-64 -translate-x-full transition-transform duration-200 lg:hidden [&.open]:translate-x-0">
		@sidebar(p)
	</div>
	<div class="admin-scrim fixed inset-0 z-40 hidden bg-black/40 lg:hidden [&.open]:block"></div>
}

templ pageFoot(p pageData) {
	@toastHost(p.Nonce)
	@htmx.GlobalErrorHandling(htmx.ErrorHandlingConfig{Nonce: p.Nonce})
	// Shared confirm dialog for destructive actions (filled dynamically by
	// admin.js from data-confirm/data-confirm-title on the triggering button).
	@confirmModal(p)
	// T18 F131: the command palette. A NATIVE <dialog> (top layer, focus trap,
	// Escape-to-close all come from the platform — no focus-trap script), so
	// it is CSP-safe with no inline handlers. It renders empty: admin.js
	// builds the link index at OPEN time from the page's own DOM (the
	// data-palette contract documented on paletteDialogItems), so the palette
	// never needs a server endpoint and never shows a stale item list.
	@paletteDialog(p)
	if p.SSEURL != "" {
		// sync-client.js must load before admin.js: it registers htmx:beforeRequest
		// and htmx:sendError listeners that admin.js's CSRF config depends on being
		// in place. Both scripts run synchronously, so load order is deterministic.
		<script src={ p.BasePath + "/-/sync-client.js" }></script>
	}
	<script src={ p.BasePath + "/-/admin.js" }></script>
}

func sidebarItems(p pageData) []navigation.SidebarNavItem {
	items := make([]navigation.SidebarNavItem, 0, len(p.Nav))
	for _, n := range p.Nav {
		href := p.BasePath + n.Href
		if n.Verbatim {
			href = n.Href
		}
		items = append(items, navigation.SidebarNavItem{
			Label:  n.Label,
			Href:   href,
			Icon:   icons.Name(n.Icon),
			Active: n.Active,
		})
	}
	return items
}

func sseBodyAttrs(sseURL string) templ.Attributes {
	if sseURL == "" {
		return nil
	}
	return templ.Attributes{"data-sse-url": sseURL}
}

func accentStyleTag(p pageData) string {
	nonce := strings.ReplaceAll(p.Nonce, `"`, "")
	nonceAttr := ""
	if nonce != "" {
		nonceAttr = ` nonce="` + nonce + `"`
	}
	return `<style` + nonceAttr + `>:root{--accent:` + p.Accent + `}</style>`
}

// paletteDialog is the command palette shell (T18 F131/F134): a native
// <dialog> (CSP-safe: the classes reuse the vendored tc-overlay/tc-modal
// animation profile the library already ships, no inline script), holding a
// search input, a results listbox admin.js fills at open time, and a
// collapsed shortcut-help section toggled by the "?" key (F134's help lives
// HERE, not on a separate overlay page). The list starts with a single
// hidden empty-state row; the real index is rebuilt from the DOM on every
// open (palette index contract, admin.js T18 block):
//
//	data-palette-label + data-palette-href  — explicit entries (future regions)
//	.admin-sidebar-scope nav a[href]         — panel pages
//	#users-table / #tenants-table /
//	#members-directory-table tbody tr        — the CURRENT page's rows
//	#audit-panel a[href]                     — the audit filter chips
templ paletteDialog(p pageData) {
	<dialog
		id="admin-palette"
		class="tc-overlay tc-modal mt-[12vh] mb-auto h-fit w-[calc(100%-2rem)] max-w-lg rounded-xl bg-white p-0 shadow-xl dark:bg-gray-900"
		aria-label={ p.label(labelChromePalette) }
	>
		<div class="border-gray-200 border-b dark:border-gray-700">
			<input
				type="text"
				id="admin-palette-input"
				class="w-full bg-transparent px-4 py-3.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-hidden dark:text-white dark:placeholder:text-gray-500"
				role="combobox"
				aria-expanded="true"
				aria-controls="admin-palette-list"
				aria-autocomplete="list"
				autocomplete="off"
				placeholder={ p.label(labelChromePalettePH) }
				aria-label={ p.label(labelChromePalettePH) }
				data-palette-input
			/>
		</div>
		<div
			id="admin-palette-list"
			role="listbox"
			aria-label={ p.label(labelChromePalette) }
			class="max-h-[50vh] overflow-y-auto overscroll-contain p-2"
			data-palette-list
		>
			<div class="px-3 py-6 text-center text-sm text-gray-500 dark:text-gray-400" data-palette-empty data-palette-hidden="true">
				{ p.label(labelChromePaletteEmpty) }
			</div>
		</div>
		<div
			id="admin-palette-help"
			class="hidden border-t border-gray-200 px-4 py-3 text-xs text-gray-600 dark:border-gray-700 dark:text-gray-400"
			data-palette-help
		>
			<p class="mb-1.5 font-semibold text-gray-900 dark:text-white">{ p.label(labelChromePaletteHelpTitle) }</p>
			<ul class="space-y-1">
				<li><kbd class="font-mono">Ctrl/Cmd K</kbd> — { p.label(labelChromePaletteHelpOpen) }</li>
				<li><kbd class="font-mono">?</kbd> — { p.label(labelChromePaletteHelpHelp) }</li>
				<li><kbd class="font-mono">↑ ↓</kbd> — { p.label(labelChromePaletteHelpNav) }</li>
				<li><kbd class="font-mono">Enter</kbd> — { p.label(labelChromePaletteHelpJump) }</li>
				<li><kbd class="font-mono">Esc</kbd> — { p.label(labelChromePaletteHelpClose) }</li>
			</ul>
		</div>
	</dialog>
}
