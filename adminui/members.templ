package adminui

import (
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/forms"
	"github.com/larsartmann/templ-components/utils"
)

// membersCard renders the members table with add/remove/edit-role controls.
// Shared by the tenant detail page (super-admin) and the members page
// (tenant-admin). Role options come from AssignableRoles (typed source of
// truth), not hardcoded.
templ membersCard(d tenantDetailData) {
	@display.Card(display.CardProps{
		Title: "Members",
	}) {
		if len(d.Members) == 0 {
			@empty("members", "No members", "Add a user below to grant tenant access.")
		} else {
			<div class="overflow-x-auto">
				<table class="w-full text-sm">
					<thead><tr><th class="px-4 py-2 text-left font-semibold text-gray-500">Actor</th><th class="px-4 py-2 text-left font-semibold text-gray-500">Role</th><th></th></tr></thead>
					<tbody>
						for _, m := range d.Members {
							<tr class="border-t border-gray-200 hover:bg-gray-50">
								<td class="px-4 py-2 font-mono text-xs">{ m.Actor.PrefixedString() }</td>
								<td class="px-4 py-2">
									<form class="flex items-center gap-1.5" hx-post={ d.UpdateRoleBase + "/" + m.Actor.PrefixedString() }>
										@forms.Select(forms.SelectProps{
											Name:      "role",
											Options:   roleSelectOptions(d.AssignableRoles, m.Roles),
											BaseProps: utils.BaseProps{Class: "max-w-[120px]"},
										})
										@display.Button(display.ButtonProps{Text: "Set", Type: display.ButtonHTMLSubmit, Variant: display.ButtonSecondary, Size: display.ButtonSizeSM})
									</form>
								</td>
								<td class="px-4 py-2 text-right">
									@display.Button(display.ButtonProps{
										Variant: display.ButtonSecondary,
										Size:    display.ButtonSizeSM,
										Icon:    icon("trash"),
										BaseProps: utils.BaseProps{Attrs: templ.Attributes{
											"hx-post":      d.RemoveMemberBase + "/" + m.Actor.PrefixedString() + "/delete",
											"hx-confirm":   "Remove " + m.Actor.PrefixedString() + " from this tenant?",
											"data-confirm": "Remove " + m.Actor.PrefixedString() + " from this tenant?",
										}},
									})
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<div class="border-t border-gray-200 pt-4 mt-4">
			<form class="flex items-center gap-2" hx-post={ d.AddMemberURL }>
				@forms.Input(forms.InputProps{
					Type:        forms.InputEmail,
					Name:        "email",
					Placeholder: "user@example.com",
					Required:    true,
					BaseProps:   utils.BaseProps{Class: "max-w-[240px]"},
				})
				@forms.Select(forms.SelectProps{
					Name:      "role",
					Options:   roleSelectOptions(d.AssignableRoles, nil),
					BaseProps: utils.BaseProps{Class: "max-w-[150px]"},
				})
				@display.Button(display.ButtonProps{
					Text:    "Add member",
					Type:    display.ButtonHTMLSubmit,
					Variant: display.ButtonPrimary,
					Size:    display.ButtonSizeSM,
					Icon:    icon("plus"),
				})
			</form>
		</div>
	}
}

// tenantHeader renders the page title + tenant status badge + display name.
// Extracted as a component because templ's parser rejects if/else blocks
// directly inside @Layout children.
templ tenantHeader(d tenantDetailData) {
	<div class="mb-5 flex flex-wrap items-center gap-3">
		<h1 class="text-xl font-semibold">Members</h1>
		<div class="flex-1"></div>
		if d.Tenant != nil {
			if d.Tenant.Suspended {
				@badge("suspended", "amber")
			} else {
				@badge("active", "green")
			}
		}
	</div>
	if d.Tenant != nil {
		<div class="mb-4 text-sm text-gray-500">{ d.Tenant.DisplayName } · <span class="font-mono text-xs">{ d.Tenant.Name }</span></div>
	}
}

// membersPage is the tenant-scoped members view (ModeTenantAdmin).
templ membersPage(p pageData, d tenantDetailData) {
	@Layout(p) {
		@tenantHeader(d)
		@membersCard(d)
	}
}
