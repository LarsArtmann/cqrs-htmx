package adminui

// membersCard renders the members table with add/remove/edit-role controls.
// Shared by the tenant detail page (super-admin) and the members page
// (tenant-admin). Role options come from AssignableRoles (typed source of
// truth), not hardcoded.
templ membersCard(d tenantDetailData) {
	<div class="card">
		<div class="card__header"><span class="card__title">Members</span></div>
		if len(d.Members) == 0 {
			@empty("members", "No members", "Add a user below to grant tenant access.")
		} else {
			<div class="table-wrap">
				<table class="data">
					<thead><tr><th>Actor</th><th>Role</th><th></th></tr></thead>
					<tbody>
						for _, m := range d.Members {
							<tr>
								<td class="mono">{ m.Actor.PrefixedString() }</td>
								<td>
									<form style="display:flex;gap:6px;align-items:center" hx-post={ d.UpdateRoleBase + "/" + m.Actor.PrefixedString() }>
										<select class="select" name="role" style="max-width:120px">
											for _, r := range d.AssignableRoles {
												<option value={ string(r) } { selectedAttr(m.Roles, r) }>{ string(r) }</option>
											}
										</select>
										<button class="btn btn--ghost btn--sm" type="submit">Set</button>
									</form>
								</td>
								<td style="text-align:right">
									<button
										class="btn btn--ghost btn--sm"
										hx-post={ d.RemoveMemberBase + "/" + m.Actor.PrefixedString() + "/delete" }
										hx-confirm={ "Remove " + m.Actor.PrefixedString() + " from this tenant?" }
										data-confirm={ "Remove " + m.Actor.PrefixedString() + " from this tenant?" }
									>
										@icon("trash")
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<div class="card__body" style="border-top:1px solid var(--border)">
			<form class="toolbar" style="margin:0" hx-post={ d.AddMemberURL }>
				<input class="input" type="email" name="email" placeholder="user@example.com" required style="max-width:240px"/>
				<select class="select" name="role" style="max-width:150px">
					for _, r := range d.AssignableRoles {
						<option value={ string(r) }>{ string(r) }</option>
					}
				</select>
				<button class="btn btn--primary btn--sm" type="submit">@icon("plus") Add member</button>
			</form>
		</div>
	</div>
}

// tenantHeader renders the page title + tenant status badge + display name.
// Extracted as a component because templ's parser rejects if/else blocks
// directly inside @Layout children.
templ tenantHeader(d tenantDetailData) {
	<div class="admin-content__head">
		<h1>Members</h1>
		<div class="spacer"></div>
		if d.Tenant != nil {
			if d.Tenant.Suspended {
				@badge("suspended", "amber")
			} else {
				@badge("active", "green")
			}
		}
	</div>
	if d.Tenant != nil {
		<div class="muted" style="margin-bottom:18px">{ d.Tenant.DisplayName } · <span class="mono">{ d.Tenant.Name }</span></div>
	}
}

// membersPage is the tenant-scoped members view (ModeTenantAdmin).
templ membersPage(p pageData, d tenantDetailData) {
	@Layout(p) {
		@tenantHeader(d)
		@membersCard(d)
	}
}
