package adminui

import (
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/htmx"
	"github.com/larsartmann/templ-components/utils"
)

// membersCard renders the members table with add/remove/edit-role controls.
// Shared by the tenant detail page (super-admin) and the members page
// (tenant-admin). Role options come from AssignableRoles (typed source of
// truth), not hardcoded.
//
// Rows lead with the PERSON behind the membership (email + name, resolved
// through the directory) rather than the raw "user:01HZ…" actor token: the
// admin's job is deciding who has access, and an opaque id makes that a
// lookup exercise.
templ membersCard(p pageData, d tenantDetailData) {
	@display.Card(display.CardProps{
		Title: p.label(labelPageMembers),
	}) {
		if d.AddMemberError != "" {
			<div class="mb-4">
				@feedback.Alert(feedback.AlertProps{
					Type:    feedback.FeedbackError,
					Title:   "That account does not exist yet",
					Message: d.AddMemberError,
				})
				if d.AddMemberCreateHref != "" {
					<div class="mt-2">
						@display.Button(display.ButtonProps{
							Text:      "Create the user",
							Href:      d.AddMemberCreateHref,
							Variant:   display.ButtonSecondary,
							Size:      display.ButtonSizeSM,
							BaseProps: utils.BaseProps{Class: classNoUnderline},
						})
					</div>
				}
			</div>
		}
		if len(d.Members) == 0 {
			@empty("members", p.label(labelEmptyMembersTitle), p.label(labelEmptyMembersHint), "", "")
		} else {
			@display.Table(display.TableProps{
				Headers:     []string{p.label(labelHeaderMember), p.label(labelHeaderRoles), p.label(labelHeaderAdded), ""},
				Hover:       true,
				Body:        membersRows(p, d),
				Flush:       true,
				CellPadding: display.TableCellPaddingCompact,
			})
			// F157: the roster paginates like every other list; the caption
			// quotes the FULL roster so a page never reads as the whole story.
			@listNote(len(d.Members), d.TotalMembers)
			@listPager(d.RosterURL, d.Page, d.TotalPages)
		}
		if d.RosterExportURL != "" {
			// F156: the export carries the FULL roster, not the visible page —
			// the link sits below the table so the page boundary never implies
			// an export boundary.
			<div class="mt-2">
				@display.Button(display.ButtonProps{
					Text:      p.label(labelActionExportRoster),
					Href:      d.RosterExportURL,
					Variant:   display.ButtonSecondary,
					Size:      display.ButtonSizeSM,
					BaseProps: utils.BaseProps{Class: classNoUnderline},
				})
			</div>
		}
		<div class="border-t border-gray-200 pt-4 mt-4">
			<form class="flex flex-wrap items-center gap-2" hx-post={ d.AddMemberURL }>
				// T08 F053: the type-ahead combobox replaces the 200-email
				// datalist — the directory is asked per keystroke
				// (/users/suggest), never shipped with the page.
				@suggestCombobox("admin-member-email-input", "email", "email", d.AddMemberEmail, "user@example.com", "Add member email", d.SuggestURL, "")
				@roleCheckboxGroup(d.AssignableRoles, nil, "Role")
				// display.Button with the Children slot (#405): LoadingButton content
				// (label swap + spinner) inside the library's Primary+SM classes.
				@display.Button(display.ButtonProps{
					Type:     display.ButtonHTMLSubmit,
					Variant:  display.ButtonPrimary,
					Size:     display.ButtonSizeSM,
					Children: htmx.LoadingButton("Add member", "Adding…", feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM, Color: "text-white"})),
				})
			</form>
		</div>
	}
	if d.TransferURL != "" {
		// T22: ownership transfer under ONE confirm naming BOTH sides. The
		// select carries, per candidate, the composed two-sided confirm body;
		// admin.js copies the selected option's body onto the submit button's
		// data-confirm at submit time, so the modal always names the exact
		// pairing the admin picked.
		<div class="border-t border-gray-200 pt-4 mt-4">
			<form class="flex flex-wrap items-center gap-2" hx-post={ d.TransferURL } data-transfer-confirm>
				<div class="text-sm text-gray-600 dark:text-gray-400">Ownership:</div>
				<select name="email" required aria-label={ p.label(labelActionTransferOwner) }
					class="rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-sm text-gray-900 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100">
					for _, c := range d.TransferCandidates {
						<option value={ c.Email } data-confirm-body={ c.ConfirmBody }>{ c.Email }</option>
					}
				</select>
				@display.Button(display.ButtonProps{
					Type:     display.ButtonHTMLSubmit,
					Variant:  display.ButtonSecondary,
					Size:     display.ButtonSizeSM,
					Children: htmx.LoadingButton(p.label(labelActionTransferOwner), "Transferring…", feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM})),
					BaseProps: utils.BaseProps{Attrs: templ.Attributes{
						"data-confirm":       p.label(labelConfirmBody),
						"data-confirm-title": p.label(labelConfirmTenTransfer),
					}},
				})
			</form>
		</div>
	}
}

templ membersRows(p pageData, d tenantDetailData) {
	for _, m := range d.Members {
		<tr>
			<td class="px-4 py-2">
				<div class="flex items-center gap-2.5">
					@display.Avatar(display.AvatarProps{Initials: initials(m.displayName()), Size: display.AvatarSizeSM})
					<div>
						if m.IsUser && d.UserDetailBase != "" {
							<a class="font-medium text-gray-900 no-underline hover:underline" href={ d.UserDetailBase + m.Actor.Raw() }>{ m.displayName() }</a>
						} else {
							<span class="font-medium text-gray-900">{ m.displayName() }</span>
						}
						if m.Name != "" {
							<div class={ "text-xs " + metadataTextXSClass }>{ m.Name }</div>
						}
						if !m.IsUser {
							<div class={ "font-mono text-[11px] " + metadataTextXSClass }>{ m.Actor.PrefixedString() }</div>
						}
					</div>
				</div>
			</td>
			<td class="px-4 py-2">
				<div class="flex flex-wrap items-center gap-1.5">
					for _, r := range m.Roles {
						@roleBadge(string(r))
					}
					<form class="flex items-center gap-1.5" hx-post={ d.UpdateRoleBase + "/" + m.Actor.PrefixedString() }>
						@roleCheckboxGroup(d.AssignableRoles, m.Roles, "Set roles for " + m.displayName())
						// Same Children-slot pattern as the Add member submit (Secondary
						// variant): LoadingButton shows "Saving…" while the POST runs.
						// The confirm carries the downgrade escalation (T12): dropping
						// the sole admin-tier role strands the tenant like a removal.
						@display.Button(display.ButtonProps{
							Type:     display.ButtonHTMLSubmit,
							Variant:  display.ButtonSecondary,
							Size:     display.ButtonSizeSM,
							Children: htmx.LoadingButton("Set", "Saving…", feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM})),
							BaseProps: utils.BaseProps{Attrs: templ.Attributes{
								"data-confirm":       memberRoleChangeConfirm(d, m),
								"data-confirm-title": p.label(labelConfirmMemberRoles),
							}},
						})
					</form>
				</div>
			</td>
			<td class="px-4 py-2 text-gray-500">
				if !m.AddedAt.IsZero() {
					<span title={ p.dateTime(m.AddedAt) }>
						@display.RelativeTime(display.RelativeTimeProps{Time: m.AddedAt})
					</span>
				} else {
					<span class="text-gray-600 dark:text-gray-400" aria-hidden="true">—</span>
				}
				if m.AddedBy != "" {
					<div class={ "text-xs " + metadataTextXSClass } title="Whose grant created this membership">by { m.AddedBy }</div>
				}
			</td>
			<td class="px-4 py-2 text-right">
				@display.Button(display.ButtonProps{
					Variant: display.ButtonSecondary,
					Size:    display.ButtonSizeSM,
					Icon:    icon("trash"),
					// Icon-only button: name it for screen readers (axe
					// button-name, first adminui a11y sweep 2026-11-14).
					BaseProps: utils.BaseProps{Attrs: templ.Attributes{
						"aria-label":         "Remove " + m.displayName() + " from this tenant",
						"hx-post":            d.RemoveMemberBase + "/" + m.Actor.PrefixedString() + "/delete",
						"data-confirm":       memberRemoveConfirm(d, m),
						"data-confirm-title": p.label(labelConfirmMemberRemove),
						"hx-disabled-elt":    "this",
					}},
				})
			</td>
		</tr>
	}
}

// tenantHeader renders the page title + tenant status badge + display name
// via the PageHeader pattern (status in the action slot, identity as the
// subtitle).
templ tenantHeader(p pageData, d tenantDetailData) {
	@display.PageHeader(display.PageHeaderProps{
		Title:    p.label(labelPageMembers),
		Subtitle: tenantSubtitle(d.Tenant),
		Action:   tenantHeaderStatus(d),
	})
}

templ tenantHeaderStatus(d tenantDetailData) {
	if d.Tenant != nil {
		if d.Tenant.Suspended {
			@badge("suspended", display.BadgeWarning)
		} else {
			@badge("active", display.BadgeSuccess)
		}
	}
}

// membersPage is the tenant-scoped members view (ModeTenantAdmin).
templ membersPage(p pageData, d tenantDetailData) {
	@Layout(p, membersContent(p, d))
}

templ membersContent(p pageData, d tenantDetailData) {
	@tenantHeader(p, d)
	@membersCard(p, d)
}
