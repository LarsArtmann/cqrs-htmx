package adminui

import (
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/forms"
	"github.com/larsartmann/templ-components/htmx"
	"github.com/larsartmann/templ-components/utils"
)

// membersCard renders the members table with add/remove/edit-role controls.
// Shared by the tenant detail page (super-admin) and the members page
// (tenant-admin). Role options come from AssignableRoles (typed source of
// truth), not hardcoded.
templ membersCard(d tenantDetailData) {
	@display.Card(display.CardProps{
		Title: "Members",
	}) {
		if len(d.Members) == 0 {
			@empty("members", "No members", "Add a user below to grant tenant access.", "", "")
		} else {
			@display.Table(display.TableProps{
				Headers:     []string{"Actor", "Role", ""},
				Hover:       true,
				Body:        membersRows(d),
				Flush:       true,
				CellPadding: display.TableCellPaddingCompact,
			})
		}
		<div class="border-t border-gray-200 pt-4 mt-4">
			<form class="flex items-center gap-2" hx-post={ d.AddMemberURL }>
				@forms.Input(forms.InputProps{
					Type:        forms.InputEmail,
					Name:        "email",
					Placeholder: "user@example.com",
					Required:    true,
					BaseProps:   utils.BaseProps{Class: "max-w-[240px]"},
				})
				@forms.Select(forms.SelectProps{
					Name:      "role",
					Options:   roleSelectOptions(d.AssignableRoles, nil),
					BaseProps: utils.BaseProps{Class: "max-w-[150px]"},
				})
				// Hand-rolled submit carrying the library's ButtonPrimary+SM class
				// strings verbatim (display.Button cannot host LoadingButton content —
				// no children slot). LoadingButton swaps the label to "Adding…" + a
				// spinner while the enclosing form's htmx request runs.
				<button
					type="submit"
					class="inline-flex items-center justify-center rounded-md font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer bg-blue-600 text-white hover:bg-blue-500 dark:bg-blue-500 dark:hover:bg-blue-400 focus-visible:outline-blue-600 dark:focus-visible:outline-blue-500 px-2.5 py-1.5 text-xs"
				>
					@htmx.LoadingButton("Add member", "Adding…", feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM, Color: "text-white"}))
				</button>
			</form>
		</div>
	}
}

templ membersRows(d tenantDetailData) {
	for _, m := range d.Members {
		<tr>
			<td class="px-4 py-2 font-mono text-xs">{ m.Actor.PrefixedString() }</td>
			<td class="px-4 py-2">
				<form class="flex items-center gap-1.5" hx-post={ d.UpdateRoleBase + "/" + m.Actor.PrefixedString() }>
					@forms.Select(forms.SelectProps{
						Name:      "role",
						Options:   roleSelectOptions(d.AssignableRoles, m.Roles),
						BaseProps: utils.BaseProps{Class: "max-w-[120px]"},
					})
					// Same hand-rolled pattern as the Add member submit (Secondary
					// variant): LoadingButton shows "Saving…" while the POST runs.
					<button
						type="submit"
						class="inline-flex items-center justify-center rounded-md font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer bg-white text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 dark:bg-gray-800 dark:text-white dark:ring-gray-600 dark:hover:bg-gray-700 px-2.5 py-1.5 text-xs"
					>
						@htmx.LoadingButton("Set", "Saving…", feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM}))
					</button>
				</form>
			</td>
			<td class="px-4 py-2 text-right">
				@display.Button(display.ButtonProps{
					Variant: display.ButtonSecondary,
					Size:    display.ButtonSizeSM,
					Icon:    icon("trash"),
					BaseProps: utils.BaseProps{Attrs: templ.Attributes{
						"hx-post":        d.RemoveMemberBase + "/" + m.Actor.PrefixedString() + "/delete",
						"hx-confirm":     "Remove " + m.Actor.PrefixedString() + " from this tenant?",
						"data-confirm":   "Remove " + m.Actor.PrefixedString() + " from this tenant?",
						"hx-disabled-elt": "this",
					}},
				})
			</td>
		</tr>
	}
}

// tenantHeader renders the page title + tenant status badge + display name
// via the PageHeader pattern (status in the action slot, identity as the
// subtitle).
templ tenantHeader(d tenantDetailData) {
	@display.PageHeader(display.PageHeaderProps{
		Title:    "Members",
		Subtitle: tenantSubtitle(d.Tenant),
		Action:   tenantHeaderStatus(d),
	})
}

templ tenantHeaderStatus(d tenantDetailData) {
	if d.Tenant != nil {
		if d.Tenant.Suspended {
			@badge("suspended", "amber")
		} else {
			@badge("active", "green")
		}
	}
}

// membersPage is the tenant-scoped members view (ModeTenantAdmin).
templ membersPage(p pageData, d tenantDetailData) {
	@Layout(p, membersContent(d))
}

templ membersContent(d tenantDetailData) {
	@tenantHeader(d)
	@membersCard(d)
}
