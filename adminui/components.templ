package adminui

import (
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/icons"
)

templ icon(name string) {
	@templ.Raw(iconSVG(name))
}

templ badge(text, kind string) {
	@display.Badge(display.BadgeProps{
		Text: text,
		Type: badgeKindToType(kind),
		Pill: true,
	})
}

templ roleBadge(role string) {
	@display.Badge(display.BadgeProps{
		Text: role,
		Type: roleBadgeType(role),
		Pill: true,
	})
}

templ statCardView(c statCard) {
	@display.StatCard(display.StatCardProps{
		Value: c.Value,
		Label: c.Label,
		Icon:  icons.Name(c.Icon),
	})
}

templ empty(iconName, title, hint string) {
	@display.EmptyState(display.EmptyStateProps{
		Icon:        icons.Name(iconName),
		Title:       title,
		Description: hint,
	})
}

templ toastHost() {
	<div class="toast-host"></div>
}

// listNote renders a "showing N of M" hint when a list is truncated by the
// MaxListRows cap. shown is the rendered count; total is the unfiltered match
// count. Renders nothing when all rows fit.
templ listNote(shown, total int) {
	@display.ListNote(display.ListNoteProps{Shown: shown, Total: total})
}
