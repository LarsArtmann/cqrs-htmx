package adminui

templ icon(name string) {
	@templ.Raw(iconSVG(name))
}

templ badge(text, kind string) {
	if kind == "" {
		<span class="badge">{ text }</span>
	} else {
		<span class={ "badge", "badge--" + kind }>{ text }</span>
	}
}

templ roleBadge(role string) {
	@badge(role, roleBadgeKind(role))
}

templ statCardView(c statCard) {
	<div class="stat-card">
		<div class="stat-card__icon">@icon(c.Icon)</div>
		<div>
			<div class="stat-card__label">{ c.Label }</div>
			<div class="stat-card__value">{ c.Value }</div>
		</div>
	</div>
}

templ empty(iconName, title, hint string) {
	<div class="empty">
		<div class="empty__icon">@icon(iconName)</div>
		<div style="font-weight:600;color:var(--text)">{ title }</div>
		if hint != "" {
			<div style="margin-top:4px">{ hint }</div>
		}
	</div>
}

templ spinner() {
	<span class="htmx-indicator spin" aria-hidden="true">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
	</span>
}

templ toastHost() {
	<div class="toast-host"></div>
}
