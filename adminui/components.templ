package adminui

import (
	"strconv"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/forms"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/utils"
	"github.com/larsartmann/templ-components/utils/svg"

	identitymodel "github.com/larsartmann/cqrs-htmx/identity-model/v4"
)

templ icon(name string) {
	@icons.IconWithStrokeWidth(icons.Name(name), "h-[18px] w-[18px]", 1.8)
}

templ badge(text string, kind display.BadgeType) {
	@display.Badge(display.BadgeProps{
		Text: text,
		Type: kind,
		Pill: true,
	})
}

// statusBadge is badge() plus a status dot: the glanceable variant for
// state-like values (active/suspended, verified, MFA on/off). Accent badges
// (audit actions) stay dotless on purpose — the dot encodes a STATE, and an
// action is not a state.
templ statusBadge(text string, kind display.BadgeType) {
	@display.Badge(display.BadgeProps{
		Text: text,
		Type: kind,
		Pill: true,
		Dot:  true,
	})
}

templ roleBadge(role string) {
	@display.Badge(display.BadgeProps{
		Text: role,
		Type: roleBadgeType(role),
		Pill: true,
	})
}

// roleCheckboxGroup renders the assignable roles as an inline checkbox group
// posting `roles` (the field name the platform-access card already uses), the
// member's current roles pre-checked. A membership can hold several roles —
// the single select this replaces flattened them to one — and the group needs
// no JS: unchecked boxes simply post nothing. None checked is refused by the
// handler with a toast, so a membership can never be silently emptied here.
templ roleCheckboxGroup(assignable, current []identitymodel.Role, groupLabel string) {
	<div class="flex flex-wrap items-center gap-x-3 gap-y-1" role="group" aria-label={ groupLabel }>
		for _, role := range assignable {
			// F153: each checkbox carries the role's description (roleDescriptions)
			// as help text + a title tooltip, so the blast radius is visible
			// before the grant, not after it.
			@forms.Checkbox(forms.CheckboxProps{
				Name:     "roles",
				Value:    string(role),
				Label:    string(role),
				Checked:  hasRole(current, role),
				HelpText: roleDescriptions(role),
				BaseProps: utils.BaseProps{Attrs: templ.Attributes{
					"title": roleDescriptions(role),
				}},
			})
		}
	</div>
}

templ statCardView(c statCard) {
	@display.StatCard(display.StatCardProps{
		Value:     c.Value,
		Label:     c.Label,
		Icon:      icons.Name(c.Icon),
		Tone:      c.Tone,
		Href:      c.Href,
		Change:    c.Change,
		Trend:     c.Trend,
		BaseProps: utils.BaseProps{Class: statCardClass(c.Href)},
	})
}

templ empty(iconName, title, hint, actionText, actionHref string) {
	@display.EmptyState(display.EmptyStateProps{
		Icon:        icons.Name(iconName),
		Title:       title,
		Description: hint,
		ActionText:  actionText,
		ActionHref:  actionHref,
	})
}

templ toastHost(nonce string) {
	@feedback.ToastContainer(nonce)
}

// spinnerSM is the small in-flight indicator shared by the search rows.
templ spinnerSM() {
	@feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM})
}

// usersSkeleton is the users list's loading placeholder (T17 F124). It
// renders as an htmx-indicator: invisible in the server response (the CSS
// convention keeps .htmx-indicator at opacity 0 until htmx adds
// .htmx-request), visible only while the FIRST in-flight swap of the session
// loads the rows — admin.js removes the node after that first swap, so an
// already-loaded window never flashes a skeleton again (F125: the search
// wire's hx-indicator points here). Each bar is an .admin-skeleton shimmer
// block; the animation is frozen under prefers-reduced-motion and the
// html.admin-reduced-motion mirror (the T16 pattern).
templ usersSkeleton() {
	<div id="users-skeleton" class="htmx-indicator" role="status" aria-label="Loading users">
		<div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-900">
			for i := 0; i < 5; i++ {
				<div class="mb-3 flex items-center gap-3 last:mb-0">
					<div class="admin-skeleton h-8 w-8 shrink-0 rounded-full"></div>
					<div class="flex-1">
						<div class="admin-skeleton mb-1.5 h-3 w-1/3 rounded"></div>
						<div class="admin-skeleton h-2.5 w-1/2 rounded"></div>
					</div>
				</div>
			}
		</div>
	</div>
}

// copyableID renders a machine identifier with a one-click copy affordance.
// Used wherever an admin may need to paste an id into an API call, support
// ticket, or log search (tenant id, user id).
templ copyableID(id string) {
	<span class="flex items-center gap-2">
		<span class="font-mono text-xs">{ id }</span>
		@display.CopyButton(display.CopyButtonProps{Text: id})
	</span>
}

templ dangerZoneHeader() {
	<div class="flex flex-col gap-0.5">
		<span class="text-[11px] font-semibold tracking-wider text-red-600 uppercase">Irreversible actions</span>
		<h3 class="text-base font-semibold text-red-600">Danger zone</h3>
	</div>
}

// stateBadge renders one of two labels depending on a boolean condition. kindIf
// is the badge kind shown when cond is true; kindElse is used otherwise. Shared
// by verifiedBadge and totpBadge.
templ stateBadge(cond bool, labelIf string, kindIf display.BadgeType, labelElse string, kindElse display.BadgeType) {
	if cond {
		@statusBadge(labelIf, kindIf)
	} else {
		@statusBadge(labelElse, kindElse)
	}
}

templ verifiedBadge(verified bool) {
	@stateBadge(verified, "verified", display.BadgeSuccess, "unverified", display.BadgeNeutral)
}

templ totpBadge(enabled bool) {
	@stateBadge(enabled, "enabled", display.BadgeInfo, "disabled", display.BadgeNeutral)
}

// listPager renders the pagination footer for a list page. baseURL must
// already carry every active list-state param (build it with the list's URL
// builder — listPageURL, tenantListURL, userListURL, auditListURL) — the
// component stamps or replaces only the page parameter, so the state survives
// every click. Pages render as a windowed strip (1 … 4 5 6 … N, via
// pagerWindow): first/last always present, three pages around the current
// one, ellipsis markers where numbers were dropped — a 40-page footer no
// longer scrolls. Links full-navigate: browser history and back/forward stay
// honest (M058 decision). Renders nothing on a single page. The markup and
// classes mirror the library Pagination this replaces (its windowing was
// fixed-width and its window math untestable from the panel; the pure
// pagerWindow is).
templ listPager(baseURL string, page, totalPages int) {
	if totalPages > 1 {
		<div class="mt-4">
			<nav aria-label="Pagination" class="flex items-center justify-between">
				<div class="flex flex-1 justify-between sm:hidden">
					@pagerMobileButton(page > 1, pagerPageURL(baseURL, page-1), "pager-prev", "Previous")
					@pagerMobileButton(page < totalPages, pagerPageURL(baseURL, page+1), "pager-next", "Next")
				</div>
				<div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
					<div>
						<p class="text-sm text-gray-700 dark:text-gray-300">
							Showing page
							<span class="font-medium">{ strconv.Itoa(page) }</span>
							of
							<span class="font-medium">{ strconv.Itoa(totalPages) }</span>
						</p>
					</div>
					<div>
						<ol class="isolate inline-flex -space-x-px rounded-md shadow-xs" aria-label="Pagination">
							<li>
								@pagerArrow(page > 1, pagerPageURL(baseURL, page-1), "rounded-s-md", "pager-prev", "Previous page", "Previous", svg.PathArrowLeft)
							</li>
							for _, step := range pagerWindow(page, totalPages) {
								if step.Ellipsis {
									<li>
										<span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 dark:text-gray-300 ring-1 ring-inset ring-gray-300 dark:ring-gray-600">…</span>
									</li>
								} else if step.Page == page {
									<li>
										<span
											aria-current="page"
											class="relative z-10 inline-flex items-center bg-blue-600 dark:bg-blue-500 px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:focus-visible:outline-blue-500"
										>{ strconv.Itoa(step.Page) }</span>
									</li>
								} else {
									<li>
										<a
											href={ templ.SafeURL(pagerPageURL(baseURL, step.Page)) }
											class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 dark:text-gray-200 ring-1 ring-inset ring-gray-300 dark:ring-gray-600 hover:bg-gray-50 dark:hover:bg-gray-800 focus:z-20 focus:outline-offset-0"
											data-focus-restore={ "pager-page-" + strconv.Itoa(step.Page) }
										>{ strconv.Itoa(step.Page) }</a>
									</li>
								}
							}
							<li>
								@pagerArrow(page < totalPages, pagerPageURL(baseURL, page+1), "rounded-e-md", "pager-next", "Next page", "Next", svg.PathArrowRight)
							</li>
						</ol>
					</div>
				</div>
			</nav>
		</div>
	}
}

// pagerMobileButton is the windowed pager's small-screen Previous/Next
// control: an enabled link or a disabled span (the library Pagination's
// mobile row markup).
templ pagerMobileButton(enabled bool, href, restoreID, text string) {
	if enabled {
		<a
			href={ templ.SafeURL(href) }
			class="relative inline-flex items-center rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700"
			data-focus-restore={ restoreID }
		>{ text }</a>
	} else {
		<span class={ "relative inline-flex items-center rounded-md border border-gray-300 dark:border-gray-600 bg-gray-100 dark:bg-gray-900 px-4 py-2 text-sm font-medium " + pagerDisabledTextClass + " cursor-not-allowed" }>{ text }</span>
	}
}

// pagerArrow is the windowed pager's desktop Previous/Next chevron: an
// enabled link or a disabled span (the library Pagination's arrow markup).
// roundedClass is the complete border-radius utility (e.g. "rounded-s-md") —
// passed as a literal so Tailwind's content scanner can detect it.
// restoreID is the data-focus-restore marker admin.js uses to put keyboard
// focus back on the control after a swap replaces its region (T15 F110).
templ pagerArrow(enabled bool, href, roundedClass, restoreID, ariaLabel, srText string, path string) {
	if enabled {
		<a
			href={ templ.SafeURL(href) }
			class={ "relative inline-flex items-center px-2 py-2 text-gray-600 dark:text-gray-500 ring-1 ring-inset ring-gray-300 dark:ring-gray-600 hover:bg-gray-50 dark:hover:bg-gray-800 focus:z-20 focus:outline-offset-0", roundedClass }
			aria-label={ ariaLabel }
			data-focus-restore={ restoreID }
		>
			<span class="sr-only">{ srText }</span>
			@svg.FillIcon("h-5 w-5", path, false)
		</a>
	} else {
		<span class={ "relative inline-flex items-center px-2 py-2 " + pagerDisabledTextClass + " ring-1 ring-inset ring-gray-300 dark:ring-gray-600 cursor-not-allowed", roundedClass } aria-disabled="true" tabindex="-1" data-focus-restore={ restoreID }>
			<span class="sr-only">{ srText }</span>
			@svg.FillIcon("h-5 w-5", path, false)
		</span>
	}
}

// Metadata text ramp tokens (contrast design pass, T15 F106/F107): the ramp
// floor is gray-600 in light mode (4.83:1 on white, above the WCAG AA 4.5:1
// bar for small text) and gray-400 in dark mode (fine on the dark surfaces).
// Every metadata/chrome hint on the panel renders through these tokens
// instead of ad-hoc light-mode gray-300/400 text literals, so the axe
// color-contrast findings they caused stay fixed by construction.
const (
	// metadataTextClass is the floor for metadata hints (slugs, member
	// names, footers, captions, empty-state notes).
	metadataTextClass = "text-gray-600 dark:text-gray-400"
	// metadataTextXSClass names the same floor for the xs-size ramp
	// (table cell hints, inline detail spans).
	metadataTextXSClass = "text-gray-600 dark:text-gray-400"
	// pagerDisabledTextClass is the disabled-pager ramp (still readable —
	// muted by the cursor rule, not by contrast).
	pagerDisabledTextClass = "text-gray-600 dark:text-gray-500"
)

// listNote renders a "showing N of M" hint when a list is truncated by the
// page window. shown is the rendered count; total is the unfiltered match
// count. Renders nothing when all rows fit. The card(empty | table +
// listNote + listPager) skeleton repeating across list pages is deliberate
// composition of these extracted primitives, not duplication to unify — the
// pages diverge (search variants, URL building, CTAs), so a page-template
// abstraction would take more parameters than the skeletons have lines
// (accepted, art-dupl round 2026-10-07).
templ listNote(shown, total int) {
	@display.ListNote(display.ListNoteProps{
		Shown: shown,
		Total: total,
		// aria-live="polite" (T15 F109): a search/filter swap re-renders
		// the count under the user; the polite live region announces the
		// new count without stealing focus.
		BaseProps: utils.BaseProps{Attrs: templ.Attributes{"aria-live": "polite"}},
	})
}

// confirmModal is the ONE shared confirmation dialog for all destructive
// adminui actions (user delete, tenant suspend/reactivate/delete, member
// remove, external-account unlink). Action buttons carry data-confirm (body
// text) and data-confirm-title; admin.js intercepts htmx:confirm, fills this
// dialog dynamically, and issues the original request only when the Confirm
// button is clicked. Cancel, backdrop click, and Escape close without acting
// (all native <dialog> behavior). The server-side handlers are unchanged —
// the modal is purely progressive enhancement over the same htmx requests.
// Rendered once per page via pageFoot.
// confirmModal is driven by the page's label table (T16): the shared shell
// strings ride p.label, while each action's specific body text arrives via
// data-confirm on the triggering button.
templ confirmModal(p pageData) {
	@display.Modal(display.ModalProps{
		BaseProps: utils.BaseProps{ID: "admin-confirm-modal", Nonce: p.Nonce},
		Title:     p.label(labelConfirmTitle),
		Size:      display.ModalSizeMD,
	}) {
		<p id="admin-confirm-body" class="text-sm text-gray-600 dark:text-gray-300">{ p.label(labelConfirmBody) }</p>
		<div class="mt-5 flex justify-end gap-2">
			@display.Button(display.ButtonProps{
				Type:    display.ButtonHTMLButton,
				Variant: display.ButtonSecondary,
				Text:    p.label(labelConfirmCancel),
				BaseProps: utils.BaseProps{Attrs: templ.Attributes{
					"data-tc-close": "modal",
				}},
			})
			@display.Button(display.ButtonProps{
				Type:      display.ButtonHTMLButton,
				Variant:   display.ButtonDanger,
				Text:      p.label(labelConfirmOK),
				BaseProps: utils.BaseProps{ID: "admin-confirm-ok"},
			})
		</div>
	}
}

// suggestCombobox is the T08 type-ahead field shell (F051): an input with
// combobox semantics (role="combobox", aria-expanded, aria-autocomplete) and
// the listbox popup region it controls via aria-controls. admin.js owns the
// behavior: it fetches data-suggest-src with the typed prefix (debounced) or,
// when no src is set, filters the JSON option list in data-suggest-options
// locally — one component, both modes.
//
// The listbox starts hidden and empty; options are created client-side only,
// so the page never ships a directory slice (the 200-email datalist cap is
// retired, not replaced by a bigger static payload).
templ suggestCombobox(id, inputType, name, value, placeholder, ariaLabel, src, optionsJSON string) {
	<div class="relative" data-suggest
		data-suggest-src={ src }
		if optionsJSON != "" {
			data-suggest-options={ optionsJSON }
		}>
		<input
			type={ inputType }
			id={ id }
			name={ name }
			value={ value }
			placeholder={ placeholder }
			aria-label={ ariaLabel }
			required
			autocomplete="off"
			role="combobox"
			aria-expanded="false"
			aria-autocomplete="list"
			aria-haspopup="listbox"
			data-suggest-input
			aria-controls={ id + "-listbox" }
		/>
		<ul
			id={ id + "-listbox" }
			role="listbox"
			aria-label={ ariaLabel }
			hidden
			class="absolute z-20 mt-1 max-h-60 w-full overflow-auto rounded-md border border-gray-300 bg-white py-1 text-sm shadow-lg dark:border-gray-700 dark:bg-gray-800"
			data-suggest-list
		></ul>
	</div>
}
