package adminui

import (
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/navigation"
	"github.com/larsartmann/templ-components/utils"
)

templ icon(name string) {
	@icons.IconWithStrokeWidth(icons.Name(name), "h-[18px] w-[18px]", 1.8)
}

templ badge(text, kind string) {
	@display.Badge(display.BadgeProps{
		Text: text,
		Type: badgeKindToType(kind),
		Pill: true,
	})
}

// statusBadge is badge() plus a status dot: the glanceable variant for
// state-like values (active/suspended, verified, MFA on/off). Accent badges
// (audit actions) stay dotless on purpose — the dot encodes a STATE, and an
// action is not a state.
templ statusBadge(text, kind string) {
	@display.Badge(display.BadgeProps{
		Text: text,
		Type: badgeKindToType(kind),
		Pill: true,
		Dot:  true,
	})
}

templ roleBadge(role string) {
	@display.Badge(display.BadgeProps{
		Text: role,
		Type: roleBadgeType(role),
		Pill: true,
	})
}

templ statCardView(c statCard) {
	@display.StatCard(display.StatCardProps{
		Value: c.Value,
		Label: c.Label,
		Icon:  icons.Name(c.Icon),
		Tone:  c.Tone,
		Href:  c.Href,
		BaseProps: utils.BaseProps{Class: statCardClass(c.Href)},
	})
}

templ empty(iconName, title, hint, actionText, actionHref string) {
	@display.EmptyState(display.EmptyStateProps{
		Icon:        icons.Name(iconName),
		Title:       title,
		Description: hint,
		ActionText:  actionText,
		ActionHref:  actionHref,
	})
}

templ toastHost(nonce string) {
	@feedback.ToastContainer(nonce)
}

templ userIDDetail(id string) {
	<span class="flex items-center gap-2">
		<span class="font-mono text-xs">{ id }</span>
		@display.CopyButton(display.CopyButtonProps{Text: id})
	</span>
}

templ dangerZoneHeader() {
	<div class="flex flex-col gap-0.5">
		<span class="text-[11px] font-semibold tracking-wider text-red-600/70 uppercase">Irreversible actions</span>
		<h3 class="text-base font-semibold text-red-600">Danger zone</h3>
	</div>
}

// stateBadge renders one of two labels depending on a boolean condition. kindIf
// is the badge kind shown when cond is true; kindElse is used otherwise (empty
// string means default styling). Shared by verifiedBadge and totpBadge.
templ stateBadge(cond bool, labelIf, kindIf, labelElse, kindElse string) {
	if cond {
		@statusBadge(labelIf, kindIf)
	} else {
		@statusBadge(labelElse, kindElse)
	}
}

templ verifiedBadge(verified bool) {
	@stateBadge(verified, "verified", "green", "unverified", "")
}

templ totpBadge(enabled bool) {
	@stateBadge(enabled, "enabled", "blue", "disabled", "")
}

// listPager renders the pagination footer for a list page. baseURL must
// already carry any active search query (build it with listPageURL) — the
// component appends or replaces the page parameter. Links full-navigate:
// browser history and back/forward stay honest (M058 decision). Renders
// nothing on a single page.
templ listPager(baseURL string, page, totalPages int) {
	if totalPages > 1 {
		<div class="mt-4">
			@navigation.Pagination(navigation.PaginationProps{
				CurrentPage: uint(page),
				TotalPages:  uint(totalPages),
				BaseURL:     baseURL,
			})
		</div>
	}
}

// listNote renders a "showing N of M" hint when a list is truncated by the
// page window. shown is the rendered count; total is the unfiltered match
// count. Renders nothing when all rows fit.
templ listNote(shown, total int) {
	@display.ListNote(display.ListNoteProps{Shown: shown, Total: total})
}

// confirmModal is the ONE shared confirmation dialog for all destructive
// adminui actions (user delete, tenant suspend/reactivate/delete, member
// remove, external-account unlink). Action buttons carry data-confirm (body
// text) and data-confirm-title; admin.js intercepts htmx:confirm, fills this
// dialog dynamically, and issues the original request only when the Confirm
// button is clicked. Cancel, backdrop click, and Escape close without acting
// (all native <dialog> behavior). The server-side handlers are unchanged —
// the modal is purely progressive enhancement over the same htmx requests.
// Rendered once per page via pageFoot.
templ confirmModal(nonce string) {
	@display.Modal(display.ModalProps{
		BaseProps: utils.BaseProps{ID: "admin-confirm-modal", Nonce: nonce},
		Title:     "Are you sure?",
		Size:      display.ModalSizeMD,
	}) {
		<p id="admin-confirm-body" class="text-sm text-gray-600 dark:text-gray-300">This action cannot be undone.</p>
		<div class="mt-5 flex justify-end gap-2">
			<button
				type="button"
				data-tc-close="modal"
				class="inline-flex cursor-pointer items-center justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 ring-1 ring-gray-300 ring-inset transition-colors hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-gray-800 dark:text-white dark:ring-gray-600 dark:hover:bg-gray-700"
			>
				Cancel
			</button>
			<button
				type="button"
				id="admin-confirm-ok"
				class="inline-flex cursor-pointer items-center justify-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white transition-colors hover:bg-red-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-red-500 dark:hover:bg-red-400 dark:focus-visible:outline-red-500"
			>
				Confirm
			</button>
		</div>
	}
}
