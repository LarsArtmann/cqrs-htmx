{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "plugins": ["https://plugins.dprint.dev/markdown-0.22.1.wasm"],
  "markdown": {
    "lineWidth": 120,
    "textWrap": "maintain"
  },
  "includes": ["**/*.md"],
  "excludes": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/*_templ.go",
    "e2e/node_modules/**"
  ]
}
