# Build artifacts (root-level compiled binaries)
/cqrs-htmx
# the 42 MB `go build -o server` product that entered the tree via a daemon
# commit (2026-11-18, gotcha 63); explicit names, never a shadowing pattern
/server
/demo
# `go build ./cmd/...` drops the binary next to its source (7.9 MB, caught by
# CI's large-file guard 2026-11-02); name each one explicitly so no pattern can
# ever shadow a source file.
/cmd/cqrs-htmx-upgrade/cqrs-htmx-upgrade
/basic
/datastar-demo
/catalog-demo
/admin-demo
/dashboard-demo
/middleware-demo
/observability-demo
/e2e/server/server
/samber-do-demo
# Dependencies
node_modules/
# Sensitive files
*.db

# Example binaries
examples/basic/basic
examples/datastar-demo/datastar-demo
examples/catalog-demo/catalog-demo
# catalog-demo: the runtime EventCatalog export (catalog/v4 library tree);
# the COMMITTED examples/catalog-demo/eventcatalog/ is the GFL-owned export
# (order-saga.gfl via gfl export eventcatalog) and must stay tracked.
examples/catalog-demo/eventcatalog-runtime/
examples/admin-demo/admin-demo
examples/dashboard-demo/dashboard-demo
examples/async-startup-demo/async-startup-demo
examples/middleware-demo/middleware-demo
examples/middleware-showcase/middleware-showcase
examples/observability-demo/observability-demo
examples/samber-do-demo/samber-do-demo
examples/setup-demo/setup-demo
examples/sync-demo/sync-demo
examples/system-demo/system-demo
examples/tracking-demo/tracking-demo
# Nix build output
/result
# Generated reports (buildflow coverage / jscpd / lint output)
/reports/
/report/
# Buildflow pre-commit resume state (regenerated on every buildflow run)
/.buildflow-resume.json
# Build artifacts
/v3
# Templ generated files are gitignored EXCEPT in modules that commit them
# (adminui, loginpage, dashboardui) so consumers import them directly
# without running the templ code generator.
*_templ.go
!adminui/*_templ.go
!loginpage/*_templ.go
!dashboardui/*_templ.go

