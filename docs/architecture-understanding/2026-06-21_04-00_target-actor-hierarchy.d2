direction: down

style: { fill: "#0e0e10" }

title: "TARGET STATE — Actor-Centric Identity Model (Users + Bots unified under Actor)"
title.style: { font-color: "#f4f4f0" }

# Actor Union
Actor: {
  shape: rectangle
  style: {fill: "#18181d"; stroke: "#6eb5ff"; font-color: "#6eb5ff"}
  label: "interface Actor (sealed)\n\n• ID(): ActorID\n• Type(): ActorType\n• DisplayName(): string\n• actor()  // unexported seal"
}

ActorID: {
  shape: rectangle
  style: {fill: "#18181d"; stroke: "#6eb5ff"; font-color: "#6eb5ff"}
  label: "interface ActorID (sealed)\n\n• String(): string\n• Kind(): ActorKind\n• actorID()  // unexported seal"
}

# Variants
UserID: {
  shape: rectangle
  style: {fill: "#0e0e10"; stroke: "#6eb5ff"; font-color: "#f4f4f0"}
  label: "UserID\n= brandid.ID[userBrand, string]\n\n• Get(): string\n• IsZero(): bool"
}

BotID: {
  shape: rectangle
  style: {fill: "#0e0e10"; stroke: "#6eb5ff"; font-color: "#f4f4f0"}
  label: "BotID\n= brandid.ID[botBrand, string]\n\n• Get(): string\n• IsZero(): bool"
}

User: {
  shape: rectangle
  style: {fill: "#18181d"; stroke: "#6eb5ff"; font-color: "#f4f4f0"}
  label: "User — Human Actor\n\n• ID: UserID\n• Email: string\n• DisplayName: string\n• Credentials: []WebAuthnCredential\n• ExternalAccounts: []ExternalAccount\n• TOTPEnabled: bool"
}

Bot: {
  shape: rectangle
  style: {fill: "#18181d"; stroke: "#6eb5ff"; font-color: "#f4f4f0"}
  label: "Bot — Machine Actor\n\n• ID: BotID\n• Name: string\n• TenantID: TenantID\n• Scopes: []Scope\n• APIToken: APIToken (hashed)\n• LastSeenAt: time.Time"
}

# Tenant
TenantID: {
  shape: rectangle
  style: {fill: "#0e0e10"; stroke: "#f4d35e"; font-color: "#f4d35e"}
  label: "TenantID\n= brandid.ID[tenantBrand, string]\n\nReplaces free-form domain string"
}

Tenant: {
  shape: rectangle
  style: {fill: "#18181d"; stroke: "#f4d35e"; font-color: "#f4f4f0"}
  label: "Tenant — Organizational Boundary\n\n• ID: TenantID\n• Name: string\n• Status: TenantStatus (active|suspended|deleted)\n• CreatedAt: time.Time"
}

# Membership
Membership: {
  shape: rectangle
  style: {fill: "#18181d"; stroke: "#6eb5ff"; font-color: "#f4f4f0"}
  label: "Membership — Actor to Tenant link\n\n• ActorID: ActorID\n• TenantID: TenantID\n• Roles: []Role (scoped to THIS tenant)\n• AddedAt: time.Time"
}

# Authz
Authz: {
  shape: rectangle
  style: {fill: "#0e0e10"; stroke: "#6eb5ff"; font-color: "#f4f4f0"}
  label: "Authz (RBAC with typed TenantID)\n\n• Enforce(actorID, tenantID, obj, act)\n• RolesForActor(ActorID, TenantID)\n• ImplicitRolesForActor(ActorID, TenantID)"
}

KeyInsight: {
  shape: page
  style: {fill: "#16161a"; stroke: "#ffb347"; font-color: "#ffb347"}
  label: "KEY INSIGHT: Actor is the unifying abstraction.\nAuthorization, sessions, and audit all key on ActorID.\nUser and Bot are just auth-mechanism variants."
}

# Relationships
Actor <- User: { style: { stroke: "#6eb5ff"; font-color: "#f4f4f0" } }
Actor <- Bot: { style: { stroke: "#6eb5ff"; font-color: "#f4f4f0" } }
ActorID <- UserID: { style: { stroke: "#6eb5ff"; font-color: "#f4f4f0" } }
ActorID <- BotID: { style: { stroke: "#6eb5ff"; font-color: "#f4f4f0" } }

User -> Membership: { style: { stroke: "#6eb5ff"; font-color: "#f4f4f0" } }
Bot -> Membership: { style: { stroke: "#6eb5ff"; font-color: "#f4f4f0" } }
Membership -> Tenant: { style: { stroke: "#f4d35e"; font-color: "#f4f4f0" } }
Authz -> Membership: { style: { stroke: "#6eb5ff"; font-color: "#f4f4f0" } }
Tenant -> TenantID: { style: { stroke: "#f4d35e"; font-color: "#f4f4f0" } }

KeyInsight -> Actor: { style: { stroke: "#ffb347"; font-color: "#ffb347" } }
