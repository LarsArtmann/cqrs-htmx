direction: down

title: "TARGET STATE — Impersonation Flow (Session Origin Tracking + Audit Trail)"

# Actors
Admin: {
  shape: person
  style: {fill: "#0f3460"; stroke: "#16c79a"}
  label: "Super Admin\nactorID: user_01J..."
}

TargetUser: {
  shape: person
  style: {fill: "#16213e"; stroke: "#e8c546"}
  label: "Target User\nactorID: user_01J..."
}

# Session types
SessionOrigin: {
  shape: rectangle
  style: {fill: "#0f3460"; stroke: "#16c79a"; font-color: "#16c79a"}
  label: "interface SessionOrigin (sealed)\n\n• origin()  // unexported seal"
}

DirectLoginOrigin: {
  shape: rectangle
  style: {fill: "#1a1a2e"; stroke: "#16c79a"}
  label: "DirectLogin\n\n• AuthenticatedAs: ActorID\n  (== Session.ActorID)"
}

ImpersonationOrigin: {
  shape: rectangle
  style: {fill: "#1a1a2e"; stroke: "#e94560"}
  label: "Impersonation\n\n• By: ActorID (the impersonator)\n• Reason: string (mandatory)\n• At: time.Time"
}

NormalSession: {
  shape: rectangle
  style: {fill: "#191919"; stroke: "#16c79a"}
  label: "Normal Session\n\n• Token: string\n• ActorID: ActorID\n• Origin: DirectLogin"
}

ImpersonationSession: {
  shape: rectangle
  style: {fill: "#16213e"; stroke: "#e94560"; font-color: "#e94560"}
  label: "Impersonation Session\n\n• Token: string\n• ActorID: ActorID (= Target)\n• Origin: Impersonation{By: Admin}"
}

# Context propagation
RequestContext: {
  shape: rectangle
  style: {fill: "#0f3460"; stroke: "#16c79a"}
  label: "HTTP Request Context\n\n• ActorID: TargetUser.ActorID\n• Impersonator: Admin.ActorID\n• CorrelationID: links chain"
}

# Audit
ImpersonationLog: {
  shape: cylinder
  style: {fill: "#1a1a2e"; stroke: "#e94560"}
  label: "Event-Sourced Audit Log\n(separate stream)\n\nImpersonationStarted{Actor, By, Reason}\nImpersonationEnded{Actor, By}"
}

CQRSCommand: {
  shape: hexagon
  style: {fill: "#16213e"; stroke: "#16c79a"}
  label: "CQRS Command\n\nmetadata:\nactor = TargetUser\nperformed_by = Admin\nimpersonated = true"
}

# Security
SecurityGuard: {
  shape: page
  style: {fill: "#3d1219"; stroke: "#e94560"}
  label: "SECURITY GUARDS\n\n- Only super_admin can impersonate\n- Cannot impersonate another super_admin\n- Cannot escalate privileges\n- Reason field mandatory\n- Max session duration enforced\n- All actions logged to separate stream"
}

# Flow
SessionOrigin <- DirectLoginOrigin: implements
SessionOrigin <- ImpersonationOrigin: implements

Admin -> SecurityGuard: "checked first"
Admin -> ImpersonationLog: "1. BeginImpersonation(target, reason)"
ImpersonationLog -> ImpersonationSession: "2. Creates session\nActorID=target\nOrigin=Impersonation{By=admin}"
ImpersonationSession -> RequestContext: "3. Session middleware injects\nActorID + Impersonator into ctx"
RequestContext -> CQRSCommand: "4. Every command carries\nboth identities"
CQRSCommand -> ImpersonationLog: "5. Actions audited\nwith full actor chain"
Admin -> ImpersonationLog: "6. EndImpersonation()"

NormalSession -> SessionOrigin: "uses DirectLogin"
