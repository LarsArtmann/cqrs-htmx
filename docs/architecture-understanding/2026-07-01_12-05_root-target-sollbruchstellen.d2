    style.stroke: "#5eead4"
  }

  constants -> core: "shared constants"

  sse: {
    label: "cqrshtmx/sse\nSSEEvent, SSEStream, Broadcaster\nJournalSSEStore, SSEEventStore\n5 files sub-package"
    style.fill: "#0d2a22"
    style.stroke: "#5eead4"
    style.stroke-width: 2
  }

  ws: {
    label: "cqrshtmx/ws\nWSMessage, ParseWSMessage\nWSBroadcaster, WS dispatch\n4 files sub-package"
    style.fill: "#0d2a22"
    style.stroke: "#5eead4"
    style.stroke-width: 2
  }

  ratelimit: {
    label: "cqrshtmx/ratelimit\nRateLimiter, RateLimitConfig\n2 files sub-package"
    style.fill: "#2a2510"
    style.stroke: "#f4d35e"
    style.stroke-width: 2
  }

  servertiming: {
    label: "cqrshtmx/servertiming\nServerTiming, ServerTimingMiddleware\n1 file (360 lines) sub-package"
    style.fill: "#2a2510"
    style.stroke: "#f4d35e"
    style.stroke-width: 2
  }

  security_sub: {
    label: "cqrshtmx/security\nSecurityHeadersMiddleware\n1 file sub-package"
