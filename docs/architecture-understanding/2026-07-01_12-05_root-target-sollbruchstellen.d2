  htmxjs: {
    label: "cqrshtmx/htmxjs\nHTMXScriptHandler, embedded JS\n2 files sub-package"
    style.fill: "#2a2510"
    style.stroke: "#f4d35e"
    style.stroke-width: 2
  }

  sse -> core: "AfterDispatchHook\nStructuredError (thin)" {style.stroke-dash: 3}
  ws -> core: "AfterDispatchHook (thin)" {style.stroke-dash: 3}
  ratelimit -> core: "zero refs" {style.stroke-dash: 3; style.stroke: "#5eead4"}
  servertiming -> core: "zero refs" {style.stroke-dash: 3; style.stroke: "#5eead4"}
  security_sub -> core: "zero refs" {style.stroke-dash: 3; style.stroke: "#5eead4"}
  htmxjs -> core: "zero refs" {style.stroke-dash: 3; style.stroke: "#5eead4"}
