  sse -> core.app_handler: "AfterDispatchHook (type only)" {style.stroke-dash: 3; style.stroke: "#5eead4"}
  ws -> core.app_handler: "App.DispatchWS (type only)" {style.stroke-dash: 3; style.stroke: "#5eead4"}
