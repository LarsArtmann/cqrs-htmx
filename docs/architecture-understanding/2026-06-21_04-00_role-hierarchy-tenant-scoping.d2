direction: down

title: "TARGET STATE — Role Hierarchy and Tenant Scoping (Super Admin vs Tenant Admin)"

# Role hierarchy
SuperAdmin: {
  shape: rectangle
  style: {fill: "#e94560"; font-color: "#ffffff"; stroke: "#e94560"}
  label: "super_admin\n\nDomain: * (global)\nWildcard access everywhere\nCan impersonate any actor"
}

TenantAdmin: {
  shape: rectangle
  style: {fill: "#0f3460"; font-color: "#ffffff"; stroke: "#0f3460"}
  label: "admin (tenant-scoped)\n\nDomain: tenant-X\nFull access within ONE tenant\nCan manage tenant users + bots"
}

UserRole: {
  shape: rectangle
  style: {fill: "#16213e"; font-color: "#ffffff"; stroke: "#16c79a"}
  label: "user (tenant-scoped)\n\nDomain: tenant-X\nStandard member role"
}

Viewer: {
  shape: rectangle
  style: {fill: "#191919"; font-color: "#ffffff"; stroke: "#16c79a"}
  label: "viewer (tenant-scoped)\n\nDomain: tenant-X\nRead-only access"
}

# Hierarchy
SuperAdmin -> TenantAdmin: "inherits (g2)"
TenantAdmin -> UserRole: "inherits (g2)"
UserRole -> Viewer: "inherits (g2)"

# Policies
GlobalPolicy: {
  shape: page
  style: {fill: "#3d1219"; stroke: "#e94560"}
  label: "GLOBAL POLICY (seeded once)\n\np: super_admin, *, *, *, allow\nWildcards across ALL domains"
}

TenantPolicy: {
  shape: page
  style: {fill: "#0a2138"; stroke: "#0f3460"}
  label: "TENANT POLICY (per tenant)\n\np: admin, tenant-X, *, *, allow\nScoped to ONE tenant only"
}

HierarchyDef: {
  shape: page
  style: {fill: "#0d2e25"; stroke: "#16c79a"}
  label: "ROLE HIERARCHY (Casbin g2)\n\ng2: super_admin > admin\ng2: admin > user\ng2: user > viewer\n\nInheritance = implicit permissions"
}

# Tenant boundaries
TenantA: {
  shape: package
  style: {fill: "#0a2138"; stroke: "#0f3460"}
  label: "Tenant A (tenant_01AAA)"

  TA_Users: "Users with roles\nscoped to domain=tenant_01AAA"
  TA_Bots: "Bots with scopes\nscoped to domain=tenant_01AAA"
}

TenantB: {
  shape: package
  style: {fill: "#0d1622"; stroke: "#16c79a"}
  label: "Tenant B (tenant_01BBB)"

  TB_Users: "Users with roles\nscoped to domain=tenant_01BBB"
  TB_Bots: "Bots with scopes\nscoped to domain=tenant_01BBB"
}

# Isolation
Isolation: {
  shape: page
  style: {fill: "#3d1219"; stroke: "#e94560"}
  label: "TENANT ISOLATION INVARIANT\n\nA Tenant A admin CANNOT:\n- Access Tenant B resources\n- See Tenant B users/bots\n- Assign roles in Tenant B\n- Impersonate Tenant B actors\n\nOnly super_admin crosses boundaries."
}

# Connections
TenantAdmin -> TenantA: "admin role in tenant_01AAA"
SuperAdmin -> TenantA: "wildcard crosses boundaries"
SuperAdmin -> TenantB: "wildcard crosses boundaries"

GlobalPolicy -> SuperAdmin: "seeded"
TenantPolicy -> TenantAdmin: "per tenant"
HierarchyDef -> SuperAdmin: "defines inheritance"

Isolation -> TenantB: "protected from TenantA admin"
