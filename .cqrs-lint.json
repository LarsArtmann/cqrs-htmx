{
  "preset": "library",
  "rules": {
    // C040 (dead fold case) needed no exemption after all: its 2026-09-29
    // phantom class was a collector gap in cqrs-lint — event.New/catalog
    // arguments went unresolved when they referenced re-exported constants
    // (identity-model consts → usermgmt var aliases, "Go has no const
    // aliases") and EventCatalog.Register(EventMetadata{Type: ...}) was
    // invisible. Fixed at the source in go-cqrs-lite (var-alias + metadata
    // collection, verified 0 findings with C040 enabled on the full walk).
    // RESOLVED 2026-10-15: the system binary (4.16.1, go-cqrs-lite
    // 2026-10-12) ships the fix — root walks print no C040 warnings.
    //
    // D005 (docs-vs-go.mod version consistency) false-positives on
    // go-cqrs-lite per-module trains: AGENTS.md cites submodule versions that
    // ARE correct in go.mod (event/v4 v4.14.0) while the detector compares
    // them against a different family require (command/v4 v4.13.1) — the
    // same lockstep assumption V006 is disabled for.
    //
    // E014 (projection drain/read-your-writes) is owned by usermgmt.Service
    // (waitForDrain inside startProjectionHost) — every panel and consumer
    // sits BEHIND the service, so no workspace package needs its own drain
    // call. The repo-wide walk mode anchors the finding wherever the last
    // touched file lives (it was dashboardui/core/capabilities.go, then
    // adminui/accent_color.go — gotcha 28/29 anchor drift); an inline
    // directive cannot survive both walk modes (stale in the module walk,
    // load-bearing in the repo-wide one), so the disable lives here with the
    // reason. Revisit only if a package ever dispatches commands OUTSIDE a
    // usermgmt.Service with its own projection host.
    "disable": ["F002", "F006", "F009", "F010", "F011", "S002", "S003", "S007", "D005", "E014",

      // A009 (missing-stack-preset): this is a LIBRARY family — stack/ presets are
      // app composition roots; no module here is an application. Inherited by
      // every submodule via config inheritance (toolsdk walk 2026-11-15).
      // F032 (no-catalog-import): the published-language surface is
      // usermgmt.DefaultEventCatalog + systemadapter.ArchitectureCatalog;
      // internal/hx is plumbing that imports go-cqrs-lite for event envelopes
      // and owes no catalog documentation.
      "A009", "F032"]
  }
}
