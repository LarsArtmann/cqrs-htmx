{
  "preset": "library",
  "rules": {
    // C040 (dead fold case) needed no exemption after all: its 2026-09-29
    // phantom class was a collector gap in cqrs-lint — event.New/catalog
    // arguments went unresolved when they referenced re-exported constants
    // (identity-model consts → usermgmt var aliases, "Go has no const
    // aliases") and EventCatalog.Register(EventMetadata{Type: ...}) was
    // invisible. Fixed at the source in go-cqrs-lite (var-alias + metadata
    // collection, verified 0 findings with C040 enabled on the full walk).
    // RESOLVED 2026-10-15: the system binary (4.16.1, go-cqrs-lite
    // 2026-10-12) ships the fix — root walks print no C040 warnings.
    //
    // D005 (docs-vs-go.mod version consistency) false-positives on
    // go-cqrs-lite per-module trains: AGENTS.md cites submodule versions that
    // ARE correct in go.mod (event/v4 v4.14.0) while the detector compares
    // them against a different family require (command/v4 v4.13.1) — the
    // same lockstep assumption V006 is disabled for.
    "disable": ["F002", "F006", "F009", "F010", "F011", "S002", "S003", "S007", "D005"]
  }
}
