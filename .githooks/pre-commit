#!/usr/bin/env bash
# BuildFlow Pre-Commit Hook
# Auto-generated by 'buildflow precommit install', then extended with 3
# MANUAL EDIT gate blocks. TEMPLATE OF TRUTH: scripts/hooks/pre-commit.template
# (installed to the ACTIVE hook path by scripts/tools/install-git-hooks.sh).
# If a regeneration ever drops the manual blocks, restore with:
#   scripts/tools/install-git-hooks.sh --force
#
# MANUAL EDIT: Pre-warm GOCACHE before buildflow to prevent concurrent
# compilation races (govalid 20% flake rate). If this hook is regenerated
# by 'buildflow precommit install', re-add the prewarm line below.
# See scripts/tools/prewarm-gocache.sh for root cause documentation.
#
# MANUAL EDIT: Binary + large-file guard runs first (fast, fails early).
# Rejects new files >1 MB or with executable magic bytes (ELF/Mach-O/PE).
# If regeneration drops this guard, restore with:
#   scripts/tools/install-git-hooks.sh --force
# See scripts/checks/check-large-files.sh.
#
# MANUAL EDIT: Release-train gate — fail the commit on UNPUBLISHED internal
# requires (they break every hermetic GOWORK=off build). Runs --advisory:
# train LAG does not block commits (it would brick intra-train development
# and the auto-commit daemon) — the pre-push hook enforces the strict CI
# flags at push time. Warm tag cache: ~6s. Exit 4 (offline) only warns —
# do not brick offline commits.
# If regeneration drops this gate, restore with:
#   scripts/tools/install-git-hooks.sh --force
# See scripts/checks/check-release-train.sh and scripts/hooks/pre-push.template.

set -e

# Resolve Go caches to a writable location BEFORE any gate runs: on the
# machine with the dead /mnt/buildcache mount, an ambient
# GOLANGCI_LINT_CACHE pointing there makes buildflow's golangci-lint steps
# fail with "failed to initialize build cache" even when GOCACHE is fine.
# go-cache-env validates GOCACHE + GOLANGCI_LINT_CACHE (and falls back to
# the /tmp layout) without touching valid ambient values.
source "$(git rev-parse --show-toplevel)/scripts/lib/go-cache-env.sh" || true

# Binary + large-file guard: reject tracked binaries and oversized assets.
bash "$(git rev-parse --show-toplevel)/scripts/checks/check-large-files.sh"

_train_rc=0
bash "$(git rev-parse --show-toplevel)/scripts/checks/check-release-train.sh" --advisory || _train_rc=$?
if [ "$_train_rc" -eq 4 ]; then
  echo "WARNING: release-train gate skipped (cannot reach github.com) — commit proceeds"
elif [ "$_train_rc" -ne 0 ]; then
  exit "$_train_rc"
fi

echo "Running BuildFlow pre-commit checks (soft budget: 150s)..."

START=$(date +%s)

# Pre-warm GOCACHE: compile all workspace modules once (serialized) so that
# concurrent buildflow tools (govalid, golangci-lint) READ from cache instead
# of racing on concurrent WRITEs. ~2s on warm cache.
bash "$(git rev-parse --show-toplevel)/scripts/tools/prewarm-gocache.sh" 2>/dev/null || true

# Honest budgets + per-step timeouts (T01, 2026-10-08). The old invocation
# printed "budget: 60s" but passed none — under cold caches or a busy machine
# samber-linter died with deadline-exceeded and test-compile steps were killed
# mid-compile, turning the gate into reflex `--no-verify` theater (13/13 sweep
# commits bypassed it on 2026-10-08). Fix keeps EVERY step running (coverage
# not scoped out): a truthful 150s soft budget plus room for the two slow
# steps to actually finish. dev/full modes and CI are untouched — the knobs
# live ONLY in this invocation.
# BUILDFLOW_MAX_CONCURRENCY=1 pins the GOCACHE single-writer invariant: the
# refreshed buildflow binary's CLI default (4) wins over the file's
# max_concurrency: 1 and re-opens the documented govalid/golangci GOCACHE
# race (random per-module step failures: 2/2 fast runs failed at 4,
# 1/1 green at 1, 2026-09-18).
BUILDFLOW_MAX_CONCURRENCY=1 buildflow --build-mode pre-commit --staged-only \
  --budget 150s \
  --step-timeout samber-linter=2m \
  --step-timeout test-compile=2m

# Re-stage files that may have been modified by formatters
# This ensures formatted code is included in the commit
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$STAGED_FILES" ]; then
    echo "$STAGED_FILES" | xargs -r git add
fi

END=$(date +%s)
DURATION=$((END-START))

echo "BuildFlow completed in ${DURATION}s"
