#!/usr/bin/env bash
# BuildFlow Pre-Commit Hook
# Auto-generated by 'buildflow precommit install', then extended with 3
# MANUAL EDIT gate blocks. TEMPLATE OF TRUTH: scripts/hooks/pre-commit.template
# (installed to the ACTIVE hook path by scripts/install-git-hooks.sh).
# If a regeneration ever drops the manual blocks, restore with:
#   scripts/install-git-hooks.sh --force
#
# MANUAL EDIT: Pre-warm GOCACHE before buildflow to prevent concurrent
# compilation races (govalid 20% flake rate). If this hook is regenerated
# by 'buildflow precommit install', re-add the prewarm line below.
# See scripts/prewarm-gocache.sh for root cause documentation.
#
# MANUAL EDIT: Binary + large-file guard runs first (fast, fails early).
# Rejects new files >1 MB or with executable magic bytes (ELF/Mach-O/PE).
# If regeneration drops this guard, restore with:
#   scripts/install-git-hooks.sh --force
# See scripts/check-large-files.sh.
#
# MANUAL EDIT: Release-train gate — fail the commit on UNPUBLISHED internal
# requires (they break every hermetic GOWORK=off build). Warm tag cache:
# ~6s. Exit 4 (offline) only warns — do not brick offline commits.
# If regeneration drops this gate, restore with:
#   scripts/install-git-hooks.sh --force
# See scripts/check-release-train.sh.

set -e

# Binary + large-file guard: reject tracked binaries and oversized assets.
bash "$(git rev-parse --show-toplevel)/scripts/check-large-files.sh"

_train_rc=0
bash "$(git rev-parse --show-toplevel)/scripts/check-release-train.sh" || _train_rc=$?
if [ "$_train_rc" -eq 4 ]; then
  echo "WARNING: release-train gate skipped (cannot reach github.com) — commit proceeds"
elif [ "$_train_rc" -ne 0 ]; then
  exit "$_train_rc"
fi

echo "Running BuildFlow pre-commit checks (budget: 60s)..."

START=$(date +%s)

# Pre-warm GOCACHE: compile all workspace modules once (serialized) so that
# concurrent buildflow tools (govalid, golangci-lint) READ from cache instead
# of racing on concurrent WRITEs. ~2s on warm cache.
bash "$(git rev-parse --show-toplevel)/scripts/prewarm-gocache.sh" 2>/dev/null || true

# Run buildflow in pre-commit mode with performance budget
buildflow --build-mode pre-commit --staged-only

# Re-stage files that may have been modified by formatters
# This ensures formatted code is included in the commit
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$STAGED_FILES" ]; then
    echo "$STAGED_FILES" | xargs -r git add
fi

END=$(date +%s)
DURATION=$((END-START))

echo "BuildFlow completed in ${DURATION}s"
